---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { PRODUCTS, AVAILABILITY_LABEL, isThin, type Product } from '../../data/products';
import { categoryById } from '../../data/categories';
import { pageCities, cityPath } from '../../data/cities';
import { SITE, whatsappLink, productWhatsappMessage, enabledClaims, claim } from '../../config/site';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const cat = categoryById(p.category)!;
const path = `/equipment/${p.slug}/`;
const crumbs = [
  { name: 'Equipment', href: '/equipment/' },
  { name: cat.name, href: `/${cat.slug}/` },
  { name: p.name, href: path },
];
const specs = [
  ['Processor', p.processor ?? p.processor_family?.join(' / ')],
  ['Generation', p.processor_generation?.join(' / ')],
  ['Memory', p.ram],
  ['Storage', p.storage],
  ['Display', p.display_size && `${p.display_size}${p.resolution ? `, ${p.resolution}` : ''}`],
  ['Graphics', p.gpu],
  ['Operating system', p.operating_system],
  ['Battery', p.battery],
  ['Ports', p.ports],
  ['Weight', p.weight],
  ['Condition', p.condition],
].filter(([, v]) => v) as [string, string][];
/** Thin pages (few known specs) stay out of the index until real data is added. */
const thin = isThin(p);
const cities = p.city_availability?.length ? pageCities.filter((c) => p.city_availability!.includes(c.id)) : pageCities;
const related = PRODUCTS.filter((x) => x.category === p.category && x.id !== p.id).slice(0, 3);
const perks = enabledClaims(['zeroDeposit', 'noLockIn', 'monthlyBilling', 'fastDelivery', 'preinstalled', 'support247']);
const wa = productWhatsappMessage(p.name);
const title = p.seo_title ?? `${p.name} on Rent${p.processor_family ? ` (${p.processor_family.join('/')}${p.ram ? `, ${p.ram}` : ''})` : ''}`;
const description = p.seo_description ?? `Rent the ${p.name} for your business. ${specs.slice(0, 3).map(([, v]) => v).join(', ')}. Configured with your software, delivered across India. Request a quote.`;
const faqs = [
  { q: `Can I rent the ${p.name} in bulk?`, a: 'Yes. Tell us the quantity and city; larger orders are configured identically and get tailored pricing.' },
  { q: 'Is the exact configuration guaranteed?', a: 'We confirm the processor, memory and storage for your dates in the quote. If this exact configuration is short, we offer the closest equivalent for you to approve.' },
  { q: 'What is included with each unit?', a: cat.included.join('. ') + '.' },
  ...(claim('noLockIn') ? [{ q: 'How long do I have to rent it for?', a: claim('noLockIn')!.long }] : []),
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    brand: { '@type': 'Brand', name: p.brand },
    category: cat.name,
    description: p.description,
    url: new URL(path, SITE.url).href,
    ...(p.images[0] ? { image: new URL(p.images[0].src, SITE.url).href } : {}),
    additionalProperty: specs.map(([k, v]) => ({ '@type': 'PropertyValue', name: k, value: v })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={description} path={path} crumbs={crumbs} schema={schema} noindex={thin} waMessage={wa}>
  <section class="pd grid-paper">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs" role="list">
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
        </ol>
      </nav>
      <div class="pd-grid">
        <div class="gallery">
          {p.images.length ? (
            p.images.map((img, i) => (
              <figure class="photo">
                <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} />
                <figcaption class="xs">Representative photo of the {p.brand} range. Units are confirmed with your quote.</figcaption>
              </figure>
            ))
          ) : (
            <div class="ph" role="img" aria-label={`${p.name} illustration`}>
              <Icon name={cat.icon} size={160} stroke={0.9} />
              <span class="ph-brand">{p.brand}</span>
              <span class="ph-note xs">Product photo coming soon</span>
            </div>
          )}
        </div>
        <div class="info">
          <p class="sub">{p.subcategory ?? cat.name}</p>
          <h1 class="h1">{p.name}</h1>
          <p class="lead">{p.description}</p>
          <div class="meta">
            <span class={`tag ${p.availability === 'in-stock' ? 'tag--ok' : p.availability === 'limited' ? 'tag--warn' : ''}`}>{AVAILABILITY_LABEL[p.availability]}</span>
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          {specs.length > 0 && (
            <dl class="specs">
              {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          )}
          <p class="price">
            {p.rental_price ? <>From <strong class="num">₹{p.rental_price.toLocaleString('en-IN')}</strong> per month</> : <>Pricing depends on quantity and term. <strong>Request a quote</strong> for monthly rates.</>}
          </p>
          <div class="ctas">
            <a class="btn btn--primary btn--lg" href="#quote">Request a quote</a>
            <a class="btn btn--lg btn--wa" href={whatsappLink(wa)} target="_blank" rel="noopener" data-track-location="product"><Icon name="whatsapp" />WhatsApp us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2 class="h2">Ideal for</h2>
        <ul role="list" class="ideal">
          {p.use_cases.map((u) => <li><Icon name="check" size={20} stroke={2.4} />{u}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="h2">Rental terms</h2>
        <ul role="list" class="ideal">
          {perks.map((k) => <li><Icon name="check" size={20} stroke={2.4} />{k.long}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="quote" aria-labelledby="bulk-title">
    <div class="wrap two">
      <div>
        <h2 id="bulk-title" class="h1">Need 20 of these?</h2>
        <p class="lead">Tell us how many and where. Bulk orders are imaged identically, labelled per user and delivered together.</p>
        <h3 class="h4 avail-h">Delivered in</h3>
        <ul role="list" class="cities">
          {cities.map((c) => <li><a href={cityPath(c)}>{c.name}</a></li>)}
        </ul>
      </div>
      <div class="panel panel--pad form-panel">
        <QuoteForm variant="compact" product={p.name} category={p.category} formId="q-product" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <h2 class="h2">Questions about this model</h2>
      <FAQ items={faqs} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--sunk" aria-labelledby="rel-title">
      <div class="wrap">
        <h2 id="rel-title" class="h2 rel-h">Similar {cat.noun}</h2>
        <div class="pgrid">{related.map((r) => <ProductCard p={r} />)}</div>
      </div>
    </section>
  )}

  <FinalCTA waMessage={wa} />
</Base>

<style>
  .pd { padding: var(--s-6) 0 var(--s-8); border-bottom: 1px solid var(--line-strong); }
  .pd-grid { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 960px) { .pd-grid { grid-template-columns: 1.05fr 1fr; } }
  .photo { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-lg); border: 1px solid var(--line-strong); background: var(--card); box-shadow: var(--shadow-block); }
  .photo figcaption { margin-top: var(--s-3); color: var(--ink-2); }
  .ph { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--r-lg); border: 1px solid var(--line-strong); background: var(--card); background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 16px 16px; box-shadow: var(--shadow-block); }
  .ph-brand { position: absolute; left: 20px; bottom: 14px; font-family: var(--font-display); font-weight: 400; font-size: 2rem; color: var(--ink-3); }
  .ph-note { position: absolute; right: 20px; bottom: 20px; color: var(--ink-2); }
  .sub { font-weight: 600; color: var(--ink-2); margin-bottom: var(--s-2); }
  .info .lead { margin-top: var(--s-4); }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s-5); }
  .specs { margin: var(--s-5) 0 0; border-top: 1px solid var(--line-strong); }
  .specs div { display: grid; grid-template-columns: 150px 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line-strong); }
  .specs dt { color: var(--ink-2); }
  .specs dd { margin: 0; font-weight: 700; }
  .price { margin-top: var(--s-5); }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-5); }
  .two { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 960px) { .two { grid-template-columns: 1fr 1fr; } }
  .ideal { display: grid; gap: 12px; margin-top: var(--s-5); list-style: none; font-size: 1.0625rem; }
  .ideal li { display: flex; gap: 10px; align-items: flex-start; }
  .ideal :global(svg) { color: var(--green); flex: none; margin-top: 3px; }
  .avail-h { margin: var(--s-6) 0 var(--s-3); }
  .cities { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; }
  .cities a { font-weight: 600; }
  .form-panel { border: 1px solid var(--line-strong); box-shadow: var(--shadow-block); }
  .rel-h { margin-bottom: var(--s-6); }
  .pgrid { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
</style>
