---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClientWall from '../components/ClientWall.astro';
import IndiaMap from '../components/IndiaMap.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Icon from '../components/Icon.astro';
import { SITE, OFFICES, enabledClaims } from '../config/site';
import { CATEGORIES } from '../data/categories';
import { CITIES } from '../data/cities';

const crumbs = [{ name: 'About', href: '/about/' }];
const years = new Date().getFullYear() - SITE.founded;
const strengths = [
  { icon: 'calendar-days', t: `${years}+ years of renting`, d: `Renting IT equipment to businesses since ${SITE.founded}, through hiring booms, office moves and every Windows upgrade in between.` },
  { icon: 'layers', t: 'The whole setup, not just laptops', d: `${CATEGORIES.length} categories, from laptops and Macs to servers, routers and phones, quoted together.` },
  { icon: 'map-pinned', t: 'Pan-India reach', d: `Offices in ${OFFICES.map((o) => o.city).join(' and ')}, with delivery and support in ${CITIES.length}+ cities.` },
  { icon: 'headset', t: 'Support that stays', d: 'A replacement when something fails and a person to call while the devices are with you.' },
];
const claims = enabledClaims(['zeroDeposit', 'noLockIn', 'fastDelivery', 'support247']);
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${SITE.name}`,
  url: new URL('/about/', SITE.url).href,
  about: { '@id': `${SITE.url}/#organization` },
}, {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vivek Garg',
  jobTitle: 'Managing Director',
  worksFor: { '@id': `${SITE.url}/#organization` },
}];
---
<Base
  title={`About ${SITE.name}: IT Equipment Rental Since ${SITE.founded}`}
  description={`${SITE.name} has rented laptops, desktops, servers and networking gear to Indian businesses since ${SITE.founded}. Offices in Gurgaon and Bangalore.`}
  path="/about/"
  crumbs={crumbs}
  schema={schema}
>
  <PageHero
    title={`Renting IT to Indian businesses since ${SITE.founded}`}
    lead="We started with a simple idea: most companies need more computers than they want to own. More than a decade later, we supply complete IT setups to startups, enterprises and public-sector teams across India."
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="then-title">
    <div class="wrap then">
      <h2 id="then-title" class="sr-only">Our story</h2>
      <div class="era">
        <p class="year num">{SITE.founded}</p>
        <p class="era-t">Founded to rent business laptops and desktops to companies that needed equipment quickly, without buying it.</p>
      </div>
      <div class="arrow" aria-hidden="true"><Icon name="arrow-right" size={40} stroke={1.5} /></div>
      <div class="era now">
        <p class="year">Today</p>
        <ul role="list">
          <li><strong>{CATEGORIES.length}</strong> equipment categories, including servers, routers and phones</li>
          <li><strong>{OFFICES.length}</strong> offices, in {OFFICES.map((o) => o.city).join(' and ')}</li>
          <li><strong>{CITIES.length}+</strong> cities with delivery and support</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="lead-title">
    <div class="wrap leader">
      <div class="monogram" aria-hidden="true">VG</div>
      <div>
        <h2 id="lead-title" class="h2">Leadership</h2>
        <p class="name">Vivek Garg <span>Managing Director</span></p>
        <p class="lead">With more than 20 years in the industry, Vivek leads the company’s operations and customer relationships. His focus has stayed the same since day one: dependable equipment, quick response when something goes wrong, and long-term partnerships with the businesses we serve.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="str-title">
    <div class="wrap">
      <div class="section-head"><h2 id="str-title" class="h2">What we are good at</h2></div>
      <ul role="list" class="strengths">
        {strengths.map((s) => (
          <li><span class="ic"><Icon name={s.icon} size={30} stroke={1.5} /></span><h3 class="h3">{s.t}</h3><p class="muted">{s.d}</p></li>
        ))}
      </ul>
      {claims.length > 0 && (
        <ul role="list" class="claims">{claims.map((c) => <li><Icon name="check" size={18} stroke={2.5} />{c.short}</li>)}</ul>
      )}
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="trust-title">
    <div class="wrap">
      <div class="section-head"><h2 id="trust-title" class="h2">Trusted by serious businesses</h2></div>
      <ClientWall />
    </div>
  </section>

  <section class="section" aria-labelledby="fp-title">
    <div class="wrap">
      <div class="section-head"><h2 id="fp-title" class="h2">Our footprint</h2></div>
      <IndiaMap />
    </div>
  </section>

  <FinalCTA />
</Base>

<style>
  .then { display: grid; gap: var(--s-6); align-items: center; }
  @media (min-width: 900px) { .then { grid-template-columns: 1fr auto 1.2fr; gap: var(--s-7); } }
  .era { border-top: 1px solid var(--line-strong); padding-top: var(--s-4); }
  .year { font-family: var(--font-display); font-weight: 400; font-size: clamp(4rem, 3rem + 5vw, 8rem); line-height: .85; margin-bottom: var(--s-4); }
  .now .year { color: var(--red-ink); }
  .era-t { font-size: var(--fs-lead); color: var(--ink-2); }
  .now ul { display: grid; gap: 10px; list-style: none; font-size: 1.125rem; }
  .now strong { font-family: var(--font-display); font-size: 1.75rem; margin-right: 6px; }
  .arrow { color: var(--ink-3); justify-self: center; }
  @media (max-width: 899px) { .arrow { transform: rotate(90deg); } }
  .leader { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 860px) { .leader { grid-template-columns: 240px 1fr; gap: var(--s-8); } }
  .monogram { aspect-ratio: 1; max-width: 240px; display: grid; place-items: center; border-radius: var(--r-xl); background: var(--ink); color: var(--paper); font-family: var(--font-display); font-weight: 400; font-size: 6rem; box-shadow: inset 0 0 0 1px rgba(243,238,229,.1), 0 30px 60px -30px rgba(23,19,15,.6); }
  .name { font-size: 1.5rem; font-weight: 700; margin: var(--s-4) 0; }
  .name span { display: block; font-size: 1rem; font-weight: 500; color: var(--ink-2); }
  .strengths { display: grid; gap: var(--s-6); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); list-style: none; }
  .strengths li { border-top: 1px solid var(--line-strong); padding-top: var(--s-4); }
  .strengths .ic { color: var(--red-ink); display: block; margin-bottom: var(--s-3); }
  .strengths h3 { margin-bottom: var(--s-2); }
  .claims { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: var(--s-7); list-style: none; font-weight: 600; }
  .claims li { display: inline-flex; gap: 6px; align-items: center; }
  .claims :global(svg) { color: var(--green); }
</style>
