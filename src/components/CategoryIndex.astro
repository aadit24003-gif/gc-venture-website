---
import Icon from './Icon.astro';
import { CATEGORIES, type Category } from '../data/categories';

interface Props { items?: Category[]; exclude?: string }
const { items = CATEGORIES, exclude } = Astro.props;
const list = items.filter((c) => c.id !== exclude);
---
<ul role="list" class="cat-index">
  {list.map((c) => (
    <li>
      <a href={`/${c.slug}/`} class="row">
        <span class={`ico hue-${c.hue}`}><Icon name={c.icon} size={28} stroke={1.6} /></span>
        <span class="txt">
          <span class="name">{c.name}</span>
          <span class="blurb">{c.navBlurb}</span>
        </span>
        <span class="go"><Icon name="arrow-up-right" size={22} /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cat-index { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--line-strong); }
  @media (min-width: 860px) { .cat-index { grid-template-columns: 1fr 1fr; column-gap: var(--s-7); } }
  .row {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-4);
    padding: 18px 4px; border-bottom: 1px solid var(--line-strong); text-decoration: none;
    transition: background var(--t-fast), padding var(--t-med) var(--ease-out);
  }
  .row:hover { background: var(--card); padding-inline: 14px; text-decoration: none; }
  .ico { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 14px; border: 1px solid var(--line-strong); }
  .ico { background: var(--card); color: var(--ink); transition: color var(--t-fast), border-color var(--t-fast); }
  .row:hover .ico { color: var(--red-ink); border-color: var(--red-ink); }
  .name { display: block; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 1.25rem + .8vw, 1.875rem); line-height: 1.1; letter-spacing: -0.015em; }
  .blurb { display: block; color: var(--ink-2); font-size: var(--fs-small); margin-top: 4px; }
  .go { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background var(--t-fast), color var(--t-fast), transform var(--t-med) var(--ease-out); }
  .row:hover .go { background: var(--ink); color: var(--paper); border-color: var(--ink); transform: rotate(45deg); }
</style>
