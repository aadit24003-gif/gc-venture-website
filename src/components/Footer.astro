---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, CONTACT, OFFICES, formatPhone, telLink, mailLink, whatsappLink } from '../config/site';
import { CATEGORIES } from '../data/categories';
import { pageCities, cityPath } from '../data/cities';

interface Props {
  /** Closing call to action above the links. Off on pages that already end with a quote form. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer" data-track-zone="footer">
  <div class="wrap">
    {cta && (
      <section class="closer" aria-labelledby="closer-title">
        <h2 id="closer-title" class="closer-title">Tell us what your team needs.</h2>
        <div class="closer-side">
          <p>Send the number of devices, the city and the date you need them. We reply with configurations and monthly pricing.</p>
          <div class="closer-actions">
            <a class="btn btn--primary btn--lg" href="/request-a-quote/">Get a quote</a>
            <a class="btn btn--lg btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp us</a>
          </div>
          <p class="closer-call">Or call <a href={telLink(CONTACT.PRIMARY_PHONE)} class="num">{formatPhone(CONTACT.PRIMARY_PHONE)}</a></p>
        </div>
      </section>
    )}
    <div class="top">
      <div class="about">
        <a href="/" class="brand" aria-label="IT Rental Solutions home"><Logo eager={false} /></a>
        <p class="muted">
          Laptops, desktops, MacBooks, servers, networking and phones on rent for businesses across India, since {SITE.founded}.
        </p>
        <ul role="list" class="contact">
          <li><Icon name="phone" size={18} /><a href={telLink(CONTACT.PRIMARY_PHONE)} class="num">{formatPhone(CONTACT.PRIMARY_PHONE)}</a>, <a href={telLink(CONTACT.SECONDARY_PHONE)} class="num">{formatPhone(CONTACT.SECONDARY_PHONE)}</a></li>
          <li><Icon name="whatsapp" size={18} /><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp {formatPhone(CONTACT.PRIMARY_PHONE)}</a></li>
          <li><Icon name="mail" size={18} /><a href={mailLink()}>{CONTACT.PRIMARY_EMAIL}</a></li>
          {CONTACT.BUSINESS_HOURS && <li><Icon name="clock" size={18} />{CONTACT.BUSINESS_HOURS}</li>}
        </ul>
      </div>

      <nav class="cols" aria-label="Footer">
        <div>
          <p class="col-title">Equipment</p>
          <ul role="list">
            {CATEGORIES.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}
            <li><a href="/equipment/">Full catalogue</a></li>
          </ul>
        </div>
        <div>
          <p class="col-title">Locations</p>
          <ul role="list" class="cities">
            {pageCities.map((c) => <li><a href={cityPath(c)}>Laptop rental in {c.name}</a></li>)}
            <li class="all-cities"><a href="/locations/">All {pageCities.length} cities</a></li>
          </ul>
        </div>
        <div>
          <p class="col-title">Company</p>
          <ul role="list">
            <li><a href="/about/">About us</a></li>
            <li><a href="/industries/">Industries</a></li>
            <li><a href="/locations/">Where we deliver</a></li>
            <li><a href="/request-a-quote/">Request a quote</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/support/">Raise a complaint</a></li>
          </ul>
          <p class="col-title offices-title">Offices</p>
          {OFFICES.map((o) => (
            <address>
              <strong>{o.city}</strong><br />
              {o.lines.join(', ')}, {o.locality}, {o.region} {o.postalCode}
            </address>
          ))}
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} {SITE.name}. All rights reserved. Apple, HP, Dell and Lenovo names and logos are trademarks of their owners.</p>
      <ul role="list">
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
  <p class="wordmark" aria-hidden="true">IT Rentals</p>
</footer>

<style>
  .footer {
    background-color: var(--paper-2);
    background-image: var(--grain), radial-gradient(50% 70% at 100% 0%, rgba(224, 51, 40, .05), transparent 70%), radial-gradient(50% 80% at 0% 100%, rgba(184, 138, 85, .12), transparent 70%);
    background-size: 220px 220px, auto, auto; border-top: 1px solid var(--line-strong); padding: var(--s-9) 0 76px; font-size: var(--fs-small); overflow: hidden; }
  @media (min-width: 900px) { .footer { padding-bottom: 0; } }

  /* Closing call to action */
  .closer { display: grid; gap: var(--s-5) var(--s-8); align-items: end; padding-bottom: var(--s-8); margin-bottom: var(--s-8); border-bottom: 1px solid var(--line-strong); }
  @media (min-width: 960px) { .closer { grid-template-columns: 1.3fr 1fr; } }
  .closer-title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h2); line-height: 1.02; letter-spacing: -0.022em; max-width: 14ch; }
  .closer-side p { margin: 0; font-size: var(--fs-lead); line-height: 1.55; color: var(--ink-2); max-width: 46ch; }
  .closer-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--s-5); }
  .closer-side .closer-call { margin-top: var(--s-4); font-size: var(--fs-small); }
  .closer-call a { font-weight: 600; color: var(--ink); }

  /* Oversized wordmark that closes the page */
  .wordmark {
    margin: var(--s-6) 0 0; padding: 0 var(--gutter); text-align: center; white-space: nowrap;
    font-family: var(--font-display); font-weight: 400; font-optical-sizing: auto;
    font-size: clamp(4.5rem, 20.5vw, 22rem); line-height: .78; letter-spacing: -0.045em;
    color: rgba(23, 19, 15, .075); user-select: none; pointer-events: none;
    translate: 0 .06em;
  }
  .top { display: grid; gap: var(--s-7); }
  @media (min-width: 1000px) { .top { grid-template-columns: 1fr 2fr; } }
  .brand :global(img) { height: 46px; width: auto; }
  .about .muted { margin: var(--s-5) 0; max-width: 40ch; font-size: 1rem; }
  .contact { display: grid; gap: 10px; list-style: none; }
  .contact li { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .contact :global(svg) { flex: none; }
  .cols { display: grid; gap: var(--s-6); grid-template-columns: 1fr 1fr; }
  @media (min-width: 720px) { .cols { grid-template-columns: repeat(3, 1fr); } }
  .col-title { font-family: var(--font-display); font-weight: 400; font-size: 1.25rem; margin-bottom: var(--s-3); }
  .offices-title { margin-top: var(--s-6); }
  .cols ul { display: grid; gap: 6px; }
  .cols a { text-decoration: none; color: var(--ink-2); }
  .cols a:hover { color: var(--ink); text-decoration: underline; }
  .all-cities { display: none; }
  /* Phones: the first six cities, then a link to the rest */
  @media (max-width: 719px) {
    .cities li:nth-child(n + 7):not(.all-cities) { display: none; }
    .all-cities { display: list-item; list-style: none; }
    .all-cities a { color: var(--ink); font-weight: 600; text-decoration: underline; }
  }
  address { font-style: normal; color: var(--ink-2); margin-bottom: var(--s-4); line-height: 1.5; }
  address strong { color: var(--ink); }
  .bottom { display: flex; flex-wrap: wrap; gap: var(--s-4); justify-content: space-between; margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--line-strong); color: var(--ink-2); }
  .bottom p { margin: 0; }
  .bottom ul { display: flex; gap: var(--s-5); flex-wrap: wrap; }
  .bottom a { color: inherit; }
</style>
