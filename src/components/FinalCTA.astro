---
import Icon from './Icon.astro';
import { CONTACT, formatPhone, telLink, whatsappLink } from '../config/site';
interface Props { title?: string; text?: string; waMessage?: string }
const {
  title = 'Need 25 or more devices?',
  text = 'Send us the headcount, city and start date. We come back with configurations, a delivery plan and tailored pricing.',
  waMessage,
} = Astro.props;
---
<section class="fcta" aria-labelledby="fcta-title" data-track-zone="final-cta">
  <div class="wrap fcta-inner">
    <div>
      <h2 id="fcta-title" class="h1">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="fcta-actions">
      <a class="btn btn--primary btn--lg btn--block" href="/request-a-quote/?type=enterprise">Get an enterprise quote</a>
      <a class="btn btn--lg btn--block btn--wa" href={whatsappLink(waMessage)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp us</a>
      <a class="call" href={telLink()}><Icon name="phone" size={20} />Or call <span class="num">{formatPhone(CONTACT.PRIMARY_PHONE)}</span></a>
    </div>
  </div>
</section>

<style>
  .fcta {
    position: relative; color: var(--on-dark); padding-block: clamp(72px, 9vw, 128px);
    background:
      radial-gradient(70% 90% at 100% 0%, rgba(185, 41, 30, .35) 0%, transparent 60%),
      radial-gradient(60% 80% at 0% 100%, rgba(58, 21, 18, .8) 0%, transparent 70%),
      var(--night);
    border-top: 1px solid var(--hair-dark);
  }
  .fcta-inner { display: grid; gap: var(--s-7); align-items: center; }
  @media (min-width: 960px) { .fcta-inner { grid-template-columns: 1.6fr 1fr; } }
  .fcta .h1 { color: var(--on-dark); }
  .fcta .lead { color: var(--on-dark-2); margin-top: var(--s-5); }
  .fcta-actions {
    display: grid; gap: var(--s-3); padding: var(--s-6); border-radius: var(--r-lg);
    border: 1px solid var(--hair-dark); background: rgba(243,238,229,.03);
  }
  .fcta .btn:not(.btn--primary) { --btn-fg: var(--on-dark); --btn-bd: var(--hair-dark-strong); }
  .fcta .btn:not(.btn--primary):hover { --btn-bd: var(--on-dark); }
  .fcta .btn--wa :global(svg) { color: #3BC47A; }
  .call { display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-top: var(--s-2); color: var(--on-dark-2); font-size: var(--fs-small); text-decoration: none; }
  .call:hover { color: var(--on-dark); }
</style>
