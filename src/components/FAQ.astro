---
import Icon from './Icon.astro';
import type { FAQ } from '../data/categories';
interface Props { items: FAQ[]; id?: string }
const { items, id } = Astro.props;
---
<div class="faq" id={id}>
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}<span class="pm" aria-hidden="true"><Icon name="plus" size={16} stroke={2.4} /></span></summary>
      <div class="answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>
