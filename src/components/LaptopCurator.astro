---
/**
 * Describe your need, or build your own (home page, right after the hero, on
 * cream). Under the heading, a box to describe the need in words (opens the
 * quote form, or WhatsApp, filled in). Below it, the builder: on the left a
 * laptop whose screen is the configurator (brand, then processor, memory and
 * storage drop-downs), with "Your setup" under it (quantity and quote); on the
 * right, on the dark wine panel, the models that match the choice so far
 * (popular ones before anything is chosen) and the way into the catalogue.
 *
 * Options come from the catalogue data (src/data/products.ts), so the curator
 * never offers a combination that does not exist. Without JavaScript it is a
 * plain form that opens the catalogue with the same filters.
 */
import Icon from './Icon.astro';
import { PRODUCTS, formatGb, genOrder, type Product } from '../data/products';
import { BRAND_MARKS } from '../data/brand-marks';
import { whatsappLink } from '../config/site';

const isMac = (p: Product) => p.brand === 'Apple';
const models = PRODUCTS.filter((p) => p.configs?.length && (p.category === 'laptops' || p.category === 'macbooks'));
const pcs = models.filter((p) => !isMac(p));
const macs = models.filter(isMac);

/** Compact data for the script: one entry per model, one variant per processor option. */
const data = models.map((p) => ({
  s: p.slug,
  n: p.name,
  b: p.brand,
  m: isMac(p) ? p.name.replace(/^Apple /, '') : '',
  sub: p.subcategory ?? '',
  img: p.images[0]?.card ?? p.images[0]?.src ?? '',
  f: p.featured ? 1 : 0,
  v: p.configs!.map((c) => ({
    f: isMac(p) ? [] : c.family ?? [],
    g: isMac(p) ? c.group : c.gen ?? '',
    c: c.chip,
    r: c.ram,
    st: c.storage,
    t: c.storageType ?? 'SSD',
  })),
}));

const uniq = <T,>(xs: T[]) => [...new Set(xs)];
const count = (brand: string) => pcs.filter((p) => p.brand === brand).length;
const brands = [
  { v: 'Lenovo', label: 'Lenovo', sub: `${count('Lenovo')} models`, mark: 'lenovo' },
  { v: 'Dell', label: 'Dell', sub: `${count('Dell')} models`, mark: 'dell' },
  { v: 'HP', label: 'HP', sub: `${count('HP')} models`, mark: 'hp' },
  { v: 'Apple', label: 'Apple', sub: 'Air and Pro', mark: 'apple' },
  { v: 'any', label: 'Any', sub: 'Lenovo, Dell or HP', mark: '' },
] as const;

const families = uniq(pcs.flatMap((p) => p.configs!.flatMap((c) => c.family ?? []))).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
const gens = uniq(pcs.flatMap((p) => p.configs!.map((c) => c.gen ?? ''))).filter((g) => g && g !== 'Core Ultra').sort((a, b) => genOrder(a) - genOrder(b));
const chips = uniq(macs.flatMap((p) => p.configs!.map((c) => c.group))).sort((a, b) => genOrder(a) - genOrder(b) || a.localeCompare(b));
const macModels = macs.map((p) => p.name.replace(/^Apple /, ''));
const ram = uniq(models.flatMap((p) => p.configs!.flatMap((c) => c.ram))).sort((a, b) => a - b);
const storage = uniq(models.flatMap((p) => p.configs!.flatMap((c) => c.storage))).sort((a, b) => a - b);

const waNeed = whatsappLink('Hi IT Rentals, here is what my team needs: ');
/** Examples that fill in the describe box (the visitor edits them). */
const examples = [
  '40 laptops for a new office, Core i5 with 16 GB',
  '12 MacBook Pros for a three-month project',
  'Desktops with monitors for a training batch',
];

const short = (f: string) => f;

/** The drop-downs and their options. `for` limits one to PCs or Macs. */
type Row = { key: string; label: string; for?: 'pc' | 'mac'; options: { v: string; l: string }[] };
const any = { v: '', l: 'Any' };
const procRows: Row[] = [
  { key: 'proc', label: 'Processor', for: 'pc', options: [any, ...families.map((f) => ({ v: f, l: short(f) }))] },
  { key: 'gen', label: 'Generation', for: 'pc', options: [any, ...gens.map((g) => ({ v: g, l: g }))] },
  { key: 'model', label: 'Model', for: 'mac', options: [any, ...macModels.map((m) => ({ v: m, l: m }))] },
  { key: 'chip', label: 'Chip', for: 'mac', options: [any, ...chips.map((c) => ({ v: c, l: c }))] },
];
const ramRows: Row[] = [{ key: 'ram', label: 'Memory', options: [any, ...ram.map((r) => ({ v: String(r), l: `${r} GB` }))] }];
const storageRows: Row[] = [{ key: 'storage', label: 'Storage', options: [any, ...storage.map((s) => ({ v: String(s), l: formatGb(s) }))] }];

/** The drop-downs on the laptop's screen, in order. */
const fields = [...procRows, ...ramRows, ...storageRows];

/** Shown before anything is chosen, and without JavaScript. */
const popular = PRODUCTS.filter((p) => p.featured && p.configs?.length).slice(0, 4);
const span = (xs: number[]) => (xs.length > 1 ? `${formatGb(Math.min(...xs))} to ${formatGb(Math.max(...xs))}` : formatGb(xs[0]));
const cardSpec = (p: Product) => {
  const c = p.configs!;
  const proc = isMac(p) ? p.processor ?? '' : uniq(c.flatMap((x) => x.family ?? [])).join(' or ');
  return [proc, `${span(uniq(c.flatMap((x) => x.ram)))} memory`, `${span(uniq(c.flatMap((x) => x.storage)))} storage`].join(', ');
};
---
<section class="cur" id="build" aria-labelledby="cur-title">
  <div class="wrap cur-wrap">
    <div class="cur-head">
      <h2 id="cur-title" class="cur-title">Describe your need,<span> or build your own.</span></h2>
      <p class="cur-lead">Write it in a line, or set up the laptop below: the models that match appear beside it. Either way, you get a quote for as many as you need.</p>
    </div>

    <!-- Describe it in words -->
    <form class="need" action="/request-a-quote/" method="get" data-need>
      <div class="need-main">
        <label class="need-label" for="need-text"><span class="need-ic" aria-hidden="true"><Icon name="message-square" size={16} /></span>Describe your need</label>
        <textarea id="need-text" class="need-in" name="need" rows="2" maxlength="600" placeholder="How many, which city, from when, and anything they must have"></textarea>
      </div>
      <div class="need-actions">
        <button class="btn btn--primary" type="submit">Get a quote</button>
        <a class="need-wa" href={waNeed} target="_blank" rel="noopener" data-need-wa data-track-location="build-need"><Icon name="whatsapp" size={18} />Send it on WhatsApp</a>
      </div>
      <div class="eg">
        <p class="eg-label" id="eg-label">Or start from an example</p>
        <ul class="eg-list" role="list" aria-labelledby="eg-label">
          {examples.map((e) => <li><button type="button" class="eg-btn" data-eg>{e}</button></li>)}
        </ul>
      </div>
    </form>

    <!-- between the two ways: the four laptop brands, faint, one to each quarter -->
    <div class="fork" aria-hidden="true">
      <div class="fork-q"><svg class="fork-mark fork-mark--lenovo" viewBox="0 8 24 8.01" focusable="false"><path d={BRAND_MARKS.lenovo} fill="currentColor" /></svg></div>
      <div class="fork-q"><svg class="fork-mark" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.dell} fill="currentColor" /></svg></div>
      <div class="fork-q"><svg class="fork-mark" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.hp} fill="currentColor" /></svg></div>
      <div class="fork-q"><svg class="fork-mark fork-mark--apple" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.apple} fill="currentColor" /></svg></div>
      <p class="fork-say">or build your own</p>
    </div>

    <div class="bench">
      <!-- Left: the laptop, whose screen is the configurator, and the setup under it -->
      <form class="cur-form" id="cur-form" action="/equipment/" method="get" data-cur aria-label="Build your laptop">
        <script type="application/json" is:inline data-cur-data set:html={JSON.stringify(data)} />
        <div class="lap" data-brand="" data-lap>
          <div class="lap-lid">
            <span class="lap-cam" aria-hidden="true"></span>
            <div class="lap-screen" data-screen>
              <div class="scr-top">
                <div class="scr-marks" aria-hidden="true">
                  <span class="scr-mark scr-mark--itr on" data-mark="">IT Rentals</span>
                  <svg class="scr-mark scr-mark--lenovo" data-mark="Lenovo" viewBox="0 8 24 8.01" focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                  <svg class="scr-mark scr-mark--dell" data-mark="Dell" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.dell} fill="currentColor" /></svg>
                  <svg class="scr-mark scr-mark--hp" data-mark="HP" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.hp} fill="currentColor" /></svg>
                  <svg class="scr-mark scr-mark--apple" data-mark="Apple" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.apple} fill="currentColor" /></svg>
                  <span class="scr-mark scr-mark--itr" data-mark="any">IT Rentals</span>
                </div>
                <p class="scr-count"><span class="scr-dot" aria-hidden="true"></span><span data-scr-count>Choose a brand to start</span></p>
              </div>

              <fieldset class="brandset">
                <legend class="fld-label">Brand</legend>
                <div class="tiles">
                  {brands.map((b) => (
                    <label class="tile" title={b.sub}>
                      <input type="radio" name="brand" value={b.v} />
                      <span class="tile-face">
                        {b.mark === 'lenovo' ? (
                          <svg class="tile-mark tile-mark--lenovo" viewBox="0 8 24 8.01" aria-hidden="true" focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                        ) : b.mark ? (
                          <svg class={`tile-mark tile-mark--${b.mark}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={BRAND_MARKS[b.mark]} fill="currentColor" /></svg>
                        ) : (
                          <span class="tile-mark tile-mark--any" aria-hidden="true"><Icon name="shuffle" size={16} stroke={1.75} /></span>
                        )}
                        <span class="tile-name">{b.label}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="fields">
                {fields.map((f) => (
                  <div class="fld" data-fld={f.key} data-for={f.for} hidden={f.for === 'mac'}>
                    <label class="fld-label" for={`cur-${f.key}`}>{f.label}</label>
                    <div class="sel">
                      <select id={`cur-${f.key}`} name={f.key} data-sel={f.key}>
                        {f.options.map((o) => <option value={o.v} selected={o.v === ''}>{o.l}</option>)}
                      </select>
                      <Icon name="chevron-down" size={16} />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="lap-deck" aria-hidden="true"><span class="lap-notch"></span></div>
          <span class="lap-floor" aria-hidden="true"></span>
        </div>

        <!-- Your setup -->
        <div class="setup" data-setup>
          <div class="setup-text">
            <p class="setup-label">Your setup</p>
            <p class="setup-line" data-setup-line>Any brand, any processor, any memory, any storage</p>
            <p class="setup-count"><span role="status" aria-live="polite" data-count>{models.length} models to choose from</span> <button type="button" class="reset" data-reset hidden>Start over</button></p>
          </div>
          <div class="setup-actions">
            <div class="qty">
              <label for="cur-qty">Quantity</label>
              <div class="qty-ctl">
                <button type="button" class="qty-btn" data-qty-step="-1" aria-label="Fewer laptops"><Icon name="minus" size={16} /></button>
                <input id="cur-qty" class="qty-in" type="number" inputmode="numeric" min="1" max="10000" value="10" data-qty />
                <button type="button" class="qty-btn" data-qty-step="1" aria-label="More laptops"><Icon name="plus" size={16} /></button>
              </div>
            </div>
            <a class="btn btn--primary" href="/request-a-quote/?category=laptops&qty=10" data-quote><span>Get a quote for <span data-qty-n>10</span> <span data-qty-noun>laptops</span></span></a>
          </div>
        </div>
      </form>

      <!-- Right: the models that match, on the dark wine panel -->
      <aside class="shelf" aria-labelledby="shelf-title">
        <div class="shelf-head">
          <h3 id="shelf-title" class="shelf-title" data-results-title>Popular models</h3>
          <p class="shelf-note" data-shelf-note>Choose a brand on the laptop and this list follows your choices.</p>
        </div>
        <div class="matches" data-matches>
          {popular.map((p) => (
            <article class="mcard">
              <a class:list={['mcard-img', { 'mcard-img--studio': /-studio-/.test(p.images[0].card ?? p.images[0].src) }]} href={`/equipment/${p.slug}/`} tabindex="-1" aria-hidden="true"><img src={p.images[0].card ?? p.images[0].src} alt="" width="800" height="500" loading="lazy" decoding="async" /></a>
              <div class="mcard-body">
                <p class="mcard-sub">{p.subcategory}</p>
                <h4 class="mcard-name"><a href={`/equipment/${p.slug}/`}>{p.name}</a></h4>
                <p class="mcard-spec">{cardSpec(p)}</p>
                <a class="mcard-quote" href={`/request-a-quote/?product=${encodeURIComponent(p.slug)}&qty=10`}>Quote this model</a>
              </div>
            </article>
          ))}
        </div>
        <div class="shelf-foot">
          <button type="submit" form="cur-form" class="btn shelf-browse" data-browse>See matches in the catalogue</button>
          <a class="btn btn--lg explore" href="/equipment/">Explore the full catalogue <Icon name="arrow-right" /></a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* deck colour follows the brand on screen, and so does the light under the laptop */
  @property --cd1 { syntax: '<color>'; inherits: true; initial-value: #d6cfc3; }
  @property --cd2 { syntax: '<color>'; inherits: true; initial-value: #b2aa9d; }
  @property --cd3 { syntax: '<color>'; inherits: true; initial-value: #7d766c; }
  @property --glow { syntax: '<color>'; inherits: true; initial-value: rgba(224, 51, 40, .28); }

  /* ── The page: cream, rising over the first screen's dark ── */
  .cur {
    position: relative; isolation: isolate; overflow-x: clip; color: var(--ink);
    padding-block: clamp(64px, 6vw, 104px);
    background-color: var(--paper-2);
    background-image:
      var(--grain),
      radial-gradient(40% 40% at 30% 62%, rgba(255, 252, 246, .9) 0%, rgba(255, 252, 246, 0) 72%),
      radial-gradient(60% 80% at 100% 0%, rgba(224, 51, 40, .06), transparent 70%),
      radial-gradient(55% 70% at 0% 100%, rgba(184, 138, 85, .12), transparent 70%);
    background-size: 220px 220px, auto, auto, auto;
  }
  /* a very light circuit-board texture over the cream (fades out towards the edges) */
  .cur::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180' viewBox='0 0 180 180'><g fill='none' stroke='%2317130F' stroke-opacity='.075' stroke-width='1' stroke-linecap='round' stroke-linejoin='round'><path d='M0 40h46l20 20h44l20-20h50'/><path d='M140 0v18l-14 14v8'/><path d='M140 180v-34l-16-16h-38'/><path d='M0 128h24l18 18h28'/><path d='M180 128h-14l-12-12v-26'/><path d='M66 60v34l12 12'/><path d='M30 0v14l12 12'/><path d='M30 180v-20'/></g><g fill='%23FAF7F1' stroke='%2317130F' stroke-opacity='.09' stroke-width='1'><circle cx='126' cy='40' r='3'/><circle cx='86' cy='130' r='3'/><circle cx='70' cy='146' r='2.5'/><circle cx='154' cy='90' r='2.5'/><circle cx='78' cy='106' r='2.5'/><circle cx='42' cy='26' r='2.5'/><circle cx='30' cy='160' r='2.5'/></g></svg>");
    background-size: 180px 180px;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 220px, #000 calc(100% - 160px), transparent);
    mask-image: linear-gradient(180deg, transparent 0, #000 220px, #000 calc(100% - 160px), transparent);
  }
  .cur-wrap { max-width: calc(1320px + 2 * var(--gutter)); }

  .cur-head { display: grid; justify-items: center; gap: clamp(14px, 1.6vw, 20px); margin: 0 auto clamp(28px, 3.4vw, 44px); text-align: center; }
  .cur-title {
    margin: 0; max-width: 18ch; font-family: var(--font-display); font-weight: 400; font-optical-sizing: auto;
    font-size: clamp(2.4rem, 1.1rem + 3.4vw, 4.5rem); line-height: .96; letter-spacing: -0.035em; text-wrap: balance;
  }
  .cur-title span { display: block; font-style: italic; color: var(--red-ink); }
  .cur-lead { margin: 0; max-width: 60ch; font-size: var(--fs-lead); line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }

  /* ── Describe it in words: one compact strip ── */
  .need {
    display: grid; gap: 12px 24px; width: min(100%, 920px); margin: 0 auto; padding: 18px 20px;
    border-radius: var(--r-xl); background: var(--card); border: 1px solid var(--line-strong); box-shadow: var(--shadow-soft);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .need:focus-within { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(185, 41, 30, .14), var(--shadow-soft); }
  .need-main { display: grid; gap: 8px; min-width: 0; }
  .need-label { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1.0625rem; }
  .need-ic { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--red-ink); color: #fff; }
  .need-in {
    width: 100%; min-height: 54px; resize: vertical; border: 0; padding: 2px 0 0; background: transparent;
    font: inherit; font-size: 1rem; line-height: 1.55; color: var(--ink);
  }
  .need-in:focus { outline: none; }
  .need-in::placeholder { color: var(--ink-3); }
  .need-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; }
  .need-wa { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: var(--fs-small); font-weight: 600; color: var(--ink); text-underline-offset: 3px; }
  .need-wa :global(svg) { color: var(--whatsapp); }
  .eg { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  .eg-label { margin: 0; font-size: var(--fs-xs); color: var(--ink-2); }
  .eg-list { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .eg-btn {
    min-height: 32px; padding: 5px 12px; border-radius: var(--r-pill); border: 1px dashed var(--line-strong); background: transparent;
    font: inherit; font-size: .8125rem; color: var(--ink); cursor: pointer; text-align: left; transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .eg-btn:hover { border-style: solid; border-color: var(--ink); background: var(--paper); }
  @media (min-width: 760px) {
    .need { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .need-actions { flex-direction: column; align-items: stretch; gap: 6px; }
    .need-actions .btn { justify-content: center; }
    .need-wa { justify-content: center; }
    .eg { grid-column: 1 / -1; }
  }

  /* Between the two ways: a band in four quarters, each with one laptop brand, faint;
     "or build your own" sits on the centre line */
  .fork {
    position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(32px, 4vw, 52px) 0; border-block: 1px solid var(--line);
    background: linear-gradient(90deg, rgba(235, 229, 218, 0), rgba(235, 229, 218, .78) 12%, rgba(235, 229, 218, .78) 88%, rgba(235, 229, 218, 0));
  }
  .fork-q { display: grid; place-items: center; height: clamp(84px, 9vw, 124px); color: rgba(23, 19, 15, .16); }
  .fork-q + .fork-q { border-left: 1px solid var(--line); }
  .fork-mark { display: block; width: clamp(30px, 3.4vw, 46px); height: clamp(30px, 3.4vw, 46px); }
  .fork-mark--apple { width: clamp(26px, 2.9vw, 40px); }
  /* Lenovo's mark is a solid badge: lighter, so it weighs the same as the others */
  .fork-q:has(.fork-mark--lenovo) { color: rgba(23, 19, 15, .07); }
  .fork-mark--lenovo { width: clamp(84px, 9.6vw, 132px); height: clamp(28px, 3.2vw, 44px); }
  .fork-say {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; margin: 0; padding: 6px 18px; border-radius: var(--r-pill);
    background: var(--paper-2); border: 1px solid var(--line); color: var(--ink-2);
    font-family: var(--font-display); font-style: italic; font-size: 1.25rem; white-space: nowrap;
  }
  /* the words sit on the line between the second and third quarters: keep those marks clear of them */
  .fork-q:nth-child(2) { justify-items: start; padding-left: 18%; }
  .fork-q:nth-child(3) { justify-items: end; padding-right: 18%; }
  @media (max-width: 759px) {
    .fork-q:nth-child(2), .fork-q:nth-child(3) { justify-items: center; padding: 0; }
    .fork-q { height: 64px; align-items: start; padding-top: 12px; }
    .fork { padding-bottom: 34px; }
    .fork-say { top: auto; bottom: 0; translate: -50% 50%; font-size: 1.125rem; }
  }

  /* ── The builder: laptop and setup on the left, models on the right ── */
  .bench { display: grid; gap: clamp(28px, 3vw, 44px); align-items: start; }
  @media (min-width: 1100px) { .bench { grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); } }
  .cur-form { min-width: 0; display: grid; gap: clamp(28px, 3vw, 40px); }

  /* The laptop: black lid, the cream screen of the first page, silver base */
  .lap { position: relative; width: 100%; max-width: 760px; margin: 0 auto; container-type: inline-size; }
  .lap-lid {
    position: relative; z-index: 1; width: 94%; margin: 0 auto; padding: 2cqi 2cqi 3.2cqi;
    background: linear-gradient(180deg, #141214, #050405); border-radius: 3.4cqi 3.4cqi 1cqi 1cqi;
    box-shadow:
      inset 0 0 0 1px rgba(243,238,229,.16), 0 0 0 1px rgba(0,0,0,.7),
      0 40px 70px -40px rgba(23,19,15,.6), 0 18px 34px -24px rgba(23,19,15,.45), 0 0 110px -40px var(--glow);
    transition: box-shadow .6s ease;
  }
  .lap-cam { position: absolute; top: .9cqi; left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #2a2622; box-shadow: inset 0 0 0 1px #3d3832; }
  .lap-screen {
    position: relative; overflow: hidden; border-radius: 1.2cqi 1.2cqi .4cqi .4cqi;
    display: grid; align-content: start; gap: clamp(12px, 2.4cqi, 20px); padding: clamp(14px, 3.2cqi, 28px) clamp(14px, 3.6cqi, 32px) clamp(16px, 3.4cqi, 30px);
    color: var(--ink);
    background: #EDE6DA radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
  }
  @container (min-width: 600px) { .lap-screen { aspect-ratio: 16 / 10.4; align-content: space-between; } }
  /* a soft reflection on the glass, and a line of light that sweeps down when the brand changes */
  .lap-screen::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 34%); }
  .lap-screen::after {
    content: ''; position: absolute; left: 0; right: 0; top: -30%; height: 30%; pointer-events: none; opacity: 0;
    background: linear-gradient(180deg, rgba(224,51,40,0), rgba(224,51,40,.05) 85%, rgba(224,51,40,.16));
  }
  .lap-screen:global(.scan)::after { animation: scan .7s cubic-bezier(.4, 0, .2, 1); }
  @keyframes scan { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(430%); } }

  .scr-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: clamp(10px, 2cqi, 16px); border-bottom: 1px solid var(--line); }
  .scr-marks { position: relative; display: grid; align-items: center; justify-items: start; height: clamp(26px, 5cqi, 40px); min-width: 0; }
  .scr-mark {
    grid-area: 1 / 1; display: block; opacity: 0; transform: translateY(4px); color: var(--ink);
    transition: opacity .35s ease, transform .5s var(--ease-out);
  }
  .scr-mark.on { opacity: 1; transform: none; }
  .scr-mark--apple { width: clamp(22px, 4.2cqi, 32px); height: clamp(26px, 5cqi, 38px); }
  .scr-mark--hp, .scr-mark--dell { width: clamp(28px, 5.4cqi, 40px); height: clamp(28px, 5.4cqi, 40px); }
  .scr-mark--lenovo { width: clamp(70px, 13cqi, 100px); height: clamp(22px, 4.2cqi, 32px); }
  .scr-mark--itr { font-family: var(--font-display); font-size: clamp(1.5rem, 4.6cqi, 2.25rem); line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .scr-count { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 5px 12px; border-radius: var(--r-pill); background: rgba(23,19,15,.05); font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  .scr-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px rgba(224,51,40,.16); }

  .fld-label { display: block; padding: 0; margin: 0 0 6px; font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); }
  .brandset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .tiles { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .tile { position: relative; min-width: 0; }
  .tile input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .tile-face {
    display: grid; justify-items: center; align-content: center; gap: 6px; height: 100%; min-height: 64px; padding: 10px 6px;
    border-radius: var(--r-md); border: 1px solid var(--line-strong); background: rgba(250, 247, 241, .7);
    cursor: pointer; transition: background-color .18s ease, color .18s ease, border-color .18s ease, transform .18s var(--ease-out);
  }
  .tile:hover .tile-face { border-color: var(--ink); transform: translateY(-1px); }
  .tile input:checked + .tile-face { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .tile input:focus-visible + .tile-face { outline: 3px solid var(--blue); outline-offset: 2px; }
  .tile-mark { display: block; width: 20px; height: 20px; color: currentColor; }
  .tile-mark--apple { width: 17px; }
  .tile-mark--lenovo { width: 48px; height: 16px; margin-block: 2px; }
  .tile-mark--any { display: grid; place-items: center; }
  .tile-name { font-weight: 600; font-size: .8125rem; line-height: 1.2; }

  /* two by two: processor and generation (or model and chip), memory and storage */
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; }
  .fld { min-width: 0; border-radius: var(--r-md); transition: background-color .5s ease; }
  .fld:global(.flash) { background-color: rgba(224, 51, 40, .1); transition: none; }
  .sel { position: relative; }
  .sel select {
    width: 100%; min-height: 44px; padding: 8px 38px 8px 14px; border-radius: var(--r-md);
    border: 1px solid var(--line-strong); background: var(--card); color: var(--ink);
    font: inherit; font-size: .9375rem; font-weight: 600; cursor: pointer;
    -webkit-appearance: none; appearance: none; transition: border-color .18s ease, box-shadow .18s ease;
  }
  .sel select:hover { border-color: var(--ink); }
  .sel select:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .sel select:disabled { cursor: not-allowed; color: var(--ink-3); background: rgba(250, 247, 241, .5); border-style: dashed; }
  .sel :global(svg) { position: absolute; right: 12px; top: 50%; translate: 0 -50%; pointer-events: none; color: var(--ink-2); }
  .fld[data-set] .sel select { border-color: var(--red-ink); box-shadow: inset 0 0 0 1px var(--red-ink); }
  /* narrow screens: three brands on top, Apple and Any sharing the second row */
  @container (max-width: 520px) {
    .tiles { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tile { grid-column: span 2; }
    .tile:nth-child(n+4) { grid-column: span 3; }
    .sel select { padding-left: 12px; font-size: .875rem; }
  }

  .lap-deck {
    position: relative; z-index: 1; height: 2.8cqi; min-height: 10px; margin-top: -1px;
    background: linear-gradient(180deg, var(--cd1) 0%, var(--cd2) 45%, var(--cd3) 100%);
    border-radius: 2px 2px 3.4cqi 3.4cqi / 2px 2px 2cqi 2cqi;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 14px 22px -12px rgba(23,19,15,.5);
    transition: --cd1 .6s ease, --cd2 .6s ease, --cd3 .6s ease;
  }
  .lap-notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, var(--cd3), var(--cd2)); border-radius: 0 0 9px 9px; opacity: .7; }
  .lap-floor {
    position: absolute; left: -4%; right: -4%; bottom: -7cqi; height: 12cqi; z-index: 0; pointer-events: none; border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow), transparent); opacity: .55; transition: --glow .6s ease;
  }
  .lap[data-brand='Apple'] { --cd1: #e6e6e9; --cd2: #bcbcc1; --cd3: #8d8d93; --glow: rgba(150, 150, 165, .3); }
  .lap[data-brand='HP'] { --cd1: #dedfe2; --cd2: #b3b4b8; --cd3: #85868b; --glow: rgba(0, 150, 214, .26); }
  .lap[data-brand='Dell'] { --cd1: #73767c; --cd2: #4a4d52; --cd3: #2c2e32; --glow: rgba(0, 118, 206, .28); }
  .lap[data-brand='Lenovo'] { --cd1: #404042; --cd2: #252527; --cd3: #131314; --glow: rgba(226, 35, 26, .3); }

  /* The screen switches on the first time the builder comes into view */
  .lap[data-boot='off'] .lap-screen > * { opacity: 0; }
  .lap[data-boot='on'] .lap-screen > * { animation: boot .6s ease backwards; }
  .lap[data-boot='on'] .brandset { animation-delay: .12s; }
  .lap[data-boot='on'] .fields { animation-delay: .24s; }
  @keyframes boot { from { opacity: 0; transform: translateY(8px); } }

  /* ── Your setup ── */
  .setup {
    display: grid; gap: 16px 28px; padding: 20px 22px; border-radius: var(--r-xl);
    background: var(--ink); color: var(--on-dark);
  }
  .setup-label { margin: 0; font-size: var(--fs-xs); color: var(--on-dark-2); }
  .setup-line { margin: 4px 0 0; font-family: var(--font-display); font-size: clamp(1.2rem, 1.05rem + .5vw, 1.45rem); line-height: 1.25; }
  .setup-count { margin: 6px 0 0; font-size: var(--fs-small); color: var(--on-dark-2); }
  .setup-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  .qty { display: flex; align-items: center; gap: 10px; }
  .qty label { font-size: var(--fs-xs); color: var(--on-dark-2); }
  .qty-ctl { display: inline-flex; align-items: center; border: 1px solid var(--hair-dark-strong); border-radius: var(--r-pill); }
  .qty-btn { display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: var(--on-dark); cursor: pointer; }
  .qty-btn:hover { background: rgba(243,238,229,.08); }
  .qty-in {
    width: 60px; height: 40px; border: 0; background: transparent; color: var(--on-dark); text-align: center;
    font: inherit; font-weight: 600; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield;
  }
  .qty-in::-webkit-outer-spin-button, .qty-in::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .qty-btn:focus-visible, .qty-in:focus-visible, .reset:focus-visible { outline: 3px solid var(--red-soft); outline-offset: 2px; }
  .setup .btn:focus-visible { outline-color: var(--red-soft); }
  .reset { margin-left: 10px; border: 0; background: none; padding: 4px 2px; color: var(--on-dark); font: inherit; font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  @media (min-width: 700px) { .setup { grid-template-columns: minmax(0, 1fr) auto; align-items: center; } }

  /* ── The models: the dark wine panel ── */
  .shelf {
    display: grid; gap: 16px; min-width: 0; padding: clamp(18px, 2vw, 26px); border-radius: var(--r-xl); color: var(--on-dark);
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(122, 32, 24, .42) 0%, transparent 65%),
      radial-gradient(70% 60% at 0% 100%, rgba(58, 21, 18, .6) 0%, transparent 65%),
      var(--night);
    box-shadow: 0 40px 70px -46px rgba(58, 12, 18, .8);
  }
  @media (min-width: 1100px) { .shelf { position: sticky; top: 100px; } }
  .shelf-head { display: grid; gap: 4px; }
  .shelf-title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 1.25rem + .6vw, 1.9rem); line-height: 1.1; }
  .shelf-note { margin: 0; font-size: var(--fs-small); color: var(--on-dark-2); }
  .matches { display: grid; gap: 10px; }
  .matches :global(.mcard) {
    display: grid; grid-template-columns: 120px minmax(0, 1fr); overflow: hidden; border-radius: var(--r-lg); color: var(--ink);
    background: var(--card); box-shadow: 0 18px 30px -24px rgba(0, 0, 0, .8);
    transition: transform var(--t-med) var(--ease-out);
    animation: card-in .45s var(--ease-out) backwards;
  }
  .matches :global(.mcard:nth-child(2)) { animation-delay: .05s; }
  .matches :global(.mcard:nth-child(3)) { animation-delay: .1s; }
  .matches :global(.mcard:nth-child(4)) { animation-delay: .15s; }
  @keyframes card-in { from { opacity: 0; transform: translateY(8px); } }
  .matches :global(.mcard:hover) { transform: translateX(3px); }
  .matches :global(.mcard-img) { display: block; overflow: hidden; background: var(--paper-3); }
  .matches :global(.mcard-img img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .matches :global(.mcard-img--studio) { background: radial-gradient(70% 85% at 50% 42%, #FBF8F2 0%, #EFE9DF 62%, #E6DED1 100%); }
  .matches :global(.mcard-img--studio img) { mix-blend-mode: multiply; }
  .matches :global(.mcard-body) { display: grid; align-content: start; gap: 3px; padding: 11px 14px 12px; }
  .matches :global(.mcard-sub) { margin: 0; font-size: .75rem; color: var(--ink-2); }
  .matches :global(.mcard-name) { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 1.15rem; line-height: 1.15; letter-spacing: -0.01em; }
  .matches :global(.mcard-name a) { text-decoration: none; }
  .matches :global(.mcard-name a:hover) { text-decoration: underline; text-underline-offset: 3px; }
  .matches :global(.mcard-spec) { margin: 0; font-size: .8125rem; line-height: 1.45; color: var(--ink-2); }
  .matches :global(.mcard-quote) { justify-self: start; margin-top: 4px; font-size: .8125rem; font-weight: 600; color: var(--red-ink); text-underline-offset: 3px; }
  .matches :global(.empty) { margin: 0; padding: 18px; border: 1px dashed var(--hair-dark-strong); border-radius: var(--r-lg); color: var(--on-dark-2); }
  .shelf-foot { display: grid; gap: 10px; padding-top: 4px; }
  .shelf-foot .btn { justify-content: center; }
  .shelf-browse { --btn-fg: var(--on-dark); --btn-bd: var(--hair-dark-strong); --btn-bg: transparent; }
  .shelf-browse:hover { --btn-bd: var(--on-dark); }
  .explore { --btn-bg: var(--paper); --btn-fg: var(--ink); --btn-bd: var(--paper); font-weight: 600; }
  .explore:hover { --btn-bg: var(--red-ink); --btn-fg: #fff; --btn-bd: var(--red-ink); }
  .shelf .btn:focus-visible { outline: 3px solid var(--red-soft); outline-offset: 3px; }
  /* tablets: two columns of models */
  @media (min-width: 700px) and (max-width: 1099px) { .matches { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 420px) { .matches :global(.mcard) { grid-template-columns: 96px minmax(0, 1fr); } }

  /*
   * In the full version this page rises like a sheet over the first screen as
   * soon as its laptop has zoomed in: it is pulled up over the end of the hero.
   */
  @media (min-height: 560px) {
    :global(html.scenes) .cur {
      margin-top: -72vh; margin-top: -72svh; z-index: 1;
      /* it lands at the top of the window, under the floating header */
      padding-top: calc(80px + clamp(36px, 3.4vw, 56px));
      border-radius: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px) 0 0;
      box-shadow: 0 -20px 40px -16px rgba(23, 19, 15, .22);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scr-mark, .tile-face, .lap-deck, .lap-lid, .lap-floor, .fld, .sel select { transition: none; }
    .lap-screen:global(.scan)::after, .matches :global(.mcard) { animation: none; }
  }
  @media (forced-colors: active) { .lap-lid, .need, .shelf { border: 1px solid CanvasText; } }
</style>

<script>
  type Variant = { f: string[]; g: string; c: string; r: number[]; st: number[]; t: string };
  type Model = { s: string; n: string; b: string; m: string; sub: string; img: string; f: number; v: Variant[] };
  type Sel = { brand: string; proc: string; gen: string; model: string; chip: string; ram: string; storage: string };
  type Key = keyof Sel;

  const fmt = (n: number) => (n >= 1024 ? `${n / 1024} TB` : `${n} GB`);
  const span = (xs: number[]) => {
    const u = [...new Set(xs)].sort((a, b) => a - b);
    return u.length > 1 ? `${fmt(u[0])} to ${fmt(u[u.length - 1])}` : fmt(u[0]);
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const chipName = (c: string) => c.replace(/^Intel /, '').replace(/^Apple /, '').replace(/ \((\d+\w\w Gen)\)/, ' $1');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  // navigation goes through a link click so it also works inside the site preview
  const go = (href: string) => {
    const a = document.createElement('a');
    a.href = href;
    document.body.append(a);
    a.click();
    a.remove();
  };

  // "Describe your need": send it to the quote form, or as a WhatsApp message.
  document.querySelectorAll<HTMLFormElement>('[data-need]').forEach((needForm) => {
    const input = needForm.querySelector<HTMLTextAreaElement>('[name="need"]')!;
    const wa = needForm.querySelector<HTMLAnchorElement>('[data-need-wa]');
    const base = wa ? new URL(wa.href) : null;
    const prefix = base?.searchParams.get('text') ?? '';
    const syncWa = () => {
      if (!wa || !base) return;
      const u = new URL(base.href);
      u.searchParams.set('text', `${prefix}${input.value.trim()}`.trim());
      wa.href = u.href;
    };
    input.addEventListener('input', syncWa);
    // an example fills the box, ready to edit
    needForm.querySelectorAll<HTMLButtonElement>('[data-eg]').forEach((b) => b.addEventListener('click', () => {
      input.value = b.textContent?.trim() ?? '';
      syncWa();
      input.focus({ preventScroll: true });
      input.setSelectionRange(input.value.length, input.value.length);
    }));
    needForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const need = input.value.trim();
      go(need ? `/request-a-quote/?need=${encodeURIComponent(need)}` : '/request-a-quote/');
    });
  });

  document.querySelectorAll<HTMLFormElement>('[data-cur]').forEach((form) => {
    const section = form.closest('section')!;
    const models = JSON.parse(form.querySelector('[data-cur-data]')!.textContent!) as Model[];
    const lap = form.querySelector<HTMLElement>('[data-lap]')!;
    const screen = form.querySelector<HTMLElement>('[data-screen]')!;
    screen.addEventListener('animationend', (e) => { if (e.target === screen) screen.classList.remove('scan'); });
    const qty = form.querySelector<HTMLInputElement>('[data-qty]')!;
    const quote = form.querySelector<HTMLAnchorElement>('[data-quote]')!;
    const reset = form.querySelector<HTMLButtonElement>('[data-reset]')!;
    const browse = section.querySelector<HTMLButtonElement>('[data-browse]')!;
    const matchesEl = section.querySelector<HTMLElement>('[data-matches]')!;
    const titleEl = section.querySelector<HTMLElement>('[data-results-title]')!;
    const noteEl = section.querySelector<HTMLElement>('[data-shelf-note]')!;
    const popularHTML = matchesEl.innerHTML;
    const OPTS: Key[] = ['proc', 'gen', 'model', 'chip', 'ram', 'storage'];
    const KEYS: Key[] = ['brand', ...OPTS];
    const radios = () => [...form.querySelectorAll<HTMLInputElement>('input[name="brand"]')];
    const sel = (k: Key) => form.querySelector<HTMLSelectElement>(`select[name="${k}"]`)!;
    const fld = (k: Key) => form.querySelector<HTMLElement>(`[data-fld="${k}"]`)!;
    // every option each drop-down can ever offer, in order
    const all = Object.fromEntries(OPTS.map((k) => [k, [...sel(k).options].map((o) => ({ v: o.value, l: o.text }))])) as Record<Key, { v: string; l: string }[]>;
    const get = (): Sel => Object.fromEntries(KEYS.map((k) => [k, k === 'brand' ? radios().find((r) => r.checked)?.value ?? '' : sel(k).value])) as Sel;
    const set = (k: Key, v: string) => {
      if (k === 'brand') { radios().forEach((r) => (r.checked = r.value === v)); return; }
      const s = sel(k);
      if (![...s.options].some((o) => o.value === v)) s.add(new Option(all[k].find((o) => o.v === v)?.l ?? v, v));
      s.value = v;
    };

    // A brand restored by the browser (back button) keeps its choices; otherwise start clean.
    if (!get().brand) OPTS.forEach((k) => set(k, ''));

    const isMacSel = (s: Sel) => s.brand === 'Apple';
    function brandOk(m: Model, s: Sel) {
      if (!s.brand) return true;
      if (s.brand === 'any') return m.b !== 'Apple';
      return m.b === s.brand;
    }
    function fits(m: Model, v: Variant, s: Sel, skip?: Key) {
      if (!brandOk(m, s)) return false;
      if (isMacSel(s)) {
        if (skip !== 'model' && s.model && m.m !== s.model) return false;
        if (skip !== 'chip' && s.chip && v.g !== s.chip) return false;
      } else {
        if (skip !== 'proc' && s.proc && !v.f.includes(s.proc)) return false;
        if (skip !== 'gen' && s.gen && v.g !== s.gen) return false;
      }
      if (skip !== 'ram' && s.ram && !v.r.includes(Number(s.ram))) return false;
      if (skip !== 'storage' && s.storage && !v.st.includes(Number(s.storage))) return false;
      return true;
    }
    const has = (k: Key, val: string, m: Model, v: Variant) => {
      if (k === 'proc') return v.f.includes(val);
      if (k === 'gen' || k === 'chip') return v.g === val;
      if (k === 'model') return m.m === val;
      if (k === 'ram') return v.r.includes(Number(val));
      if (k === 'storage') return v.st.includes(Number(val));
      return true;
    };
    const matching = (s: Sel) => models.map((m) => ({ m, vs: m.v.filter((v) => fits(m, v, s)) })).filter((x) => x.vs.length);

    /**
     * Each drop-down lists only what the chosen brand has; options that clash with the
     * other choices stay listed but cannot be picked. Nothing to choose before a brand.
     */
    function syncOptions(s: Sel) {
      const brandModels = models.filter((m) => brandOk(m, s));
      for (const k of OPTS) {
        const el = sel(k);
        const keep = el.value;
        const opts = all[k]
          .filter((o) => !o.v || brandModels.some((m) => m.v.some((v) => has(k, o.v, m, v))))
          .map((o) => {
            const opt = new Option(o.v ? o.l : 'Any', o.v, false, o.v === keep);
            if (o.v) opt.disabled = !brandModels.some((m) => m.v.some((v) => has(k, o.v, m, v) && fits(m, v, s, k)));
            return opt;
          });
        el.replaceChildren(...opts);
        el.value = opts.some((o) => o.value === keep) ? keep : '';
        el.disabled = !s.brand;
      }
      // PC or Mac drop-downs; no generation for Core Ultra
      form.querySelectorAll<HTMLElement>('[data-fld]').forEach((f) => {
        const forWhat = f.dataset.for;
        let show = !forWhat || (forWhat === 'mac' ? isMacSel(s) : !isMacSel(s));
        if (f.dataset.fld === 'gen' && s.proc.startsWith('Core Ultra')) show = false;
        f.hidden = !show;
      });
    }

    /** Drop choices that no longer fit after another changed: the latest choice wins. */
    function settle(changed: Key) {
      if (changed === 'brand') (['proc', 'gen', 'model', 'chip'] as Key[]).forEach((k) => set(k, ''));
      if (changed === 'proc' && get().proc.startsWith('Core Ultra')) set('gen', '');
      const s = get();
      const acc: Sel = { brand: s.brand, proc: '', gen: '', model: '', chip: '', ram: '', storage: '' };
      for (const k of [changed, ...OPTS.filter((x) => x !== changed)]) {
        if (k === 'brand' || !s[k]) continue;
        const trial = { ...acc, [k]: s[k] };
        if (models.some((m) => m.v.some((v) => fits(m, v, trial)))) acc[k] = s[k];
        else set(k, '');
      }
    }

    const procText = (s: Sel, list: { m: Model; vs: Variant[] }[]) => {
      if (isMacSel(s)) {
        const tiers = [...new Set(list.flatMap((x) => x.vs.map((v) => v.c)))];
        const chip = s.chip ? (tiers.length === 1 ? chipName(tiers[0]) : s.chip) : '';
        return [s.model, chip].filter(Boolean).join(' ');
      }
      return [s.proc, s.gen].filter(Boolean).join(' ');
    };

    function card(m: Model, vs: Variant[], s: Sel, n: number) {
      const chipsTxt = [...new Set(vs.map((v) => chipName(v.c)))];
      const proc = chipsTxt.length > 2 ? `${chipsTxt.slice(0, 2).join(', ')} and ${chipsTxt.length - 2} more` : chipsTxt.join(' or ');
      const mem = `${s.ram ? fmt(Number(s.ram)) : span(vs.flatMap((v) => v.r))} memory`;
      const sto = s.storage ? `${fmt(Number(s.storage))} ${vs[0].t}` : `${span(vs.flatMap((v) => v.st))} storage`;
      const config = `${m.n}, ${proc}, ${mem}, ${sto}`;
      const href = `/equipment/${m.s}/`;
      const q = `/request-a-quote/?product=${encodeURIComponent(m.s)}&qty=${n}&config=${encodeURIComponent(config)}`;
      const studio = /-studio-/.test(m.img) ? ' mcard-img--studio' : '';
      return `<article class="mcard"><a class="mcard-img${studio}" href="${href}" tabindex="-1" aria-hidden="true"><img src="${esc(m.img)}" alt="" width="800" height="500" loading="lazy" decoding="async"></a>`
        + `<div class="mcard-body"><p class="mcard-sub">${esc(m.sub)}</p><h4 class="mcard-name"><a href="${href}">${esc(m.n)}</a></h4>`
        + `<p class="mcard-spec">${esc(`${proc}, ${mem}, ${sto}`)}</p>`
        + `<a class="mcard-quote" href="${q}">Quote ${n} of this model</a></div></article>`;
    }

    function catalogueUrl(s: Sel) {
      const p = new URLSearchParams();
      if (isMacSel(s)) {
        p.set('category', 'macbooks'); p.set('brand', 'Apple');
        if (s.chip.startsWith('M')) p.set('gen', s.chip);
        // Intel Macs have no generation filter; a search term picks them out.
        const q = [s.model.toLowerCase(), s.chip.startsWith('Intel') ? 'intel' : ''].filter(Boolean).join(' ');
        if (q) p.set('q', q);
      } else {
        p.set('category', 'laptops');
        if (s.brand && s.brand !== 'any') p.set('brand', s.brand);
        if (s.proc) p.set('proc', s.proc);
        if (s.gen) p.set('gen', s.gen);
        else if (s.proc.startsWith('Core Ultra')) p.set('gen', 'Core Ultra');
      }
      if (s.ram) p.set('ram', s.ram);
      if (s.storage) p.set('storage', s.storage);
      return `/equipment/?${p.toString().replace(/%2C/g, ',')}`;
    }

    let last: Sel | null = null;
    let lastList = '';
    function render(changed?: Key) {
      const s = get();
      const list = s.brand ? matching(s) : [];
      const n = Math.max(1, Math.min(10000, parseInt(qty.value, 10) || 1));
      const brandName = s.brand === 'any' ? 'Lenovo, Dell or HP' : s.brand;
      const proc = procText(s, list);
      const mem = s.ram ? fmt(Number(s.ram)) : '';
      const sto = s.storage ? fmt(Number(s.storage)) : '';

      // The screen: the brand's mark, the count, a line of light when the brand changes
      if (last && last.brand !== s.brand && !reduced.matches) {
        screen.classList.remove('scan');
        void screen.offsetWidth;
        screen.classList.add('scan');
      }
      lap.dataset.brand = s.brand;
      lap.querySelectorAll<HTMLElement>('[data-mark]').forEach((el) => el.classList.toggle('on', el.dataset.mark === s.brand));
      OPTS.forEach((k) => fld(k).toggleAttribute('data-set', !!s[k]));
      if (changed && changed !== 'brand' && last && !reduced.matches) {
        const f = fld(changed);
        f.classList.add('flash');
        requestAnimationFrame(() => requestAnimationFrame(() => f.classList.remove('flash')));
      }
      const countTxt = !s.brand ? `${models.length} models to choose from` : list.length ? `${list.length} ${list.length === 1 ? 'model matches' : 'models match'}` : 'No exact match: ask us and we will source it';
      lap.querySelector('[data-scr-count]')!.textContent = s.brand ? (list.length ? `${list.length} ${list.length === 1 ? 'match' : 'matches'}` : 'No exact match') : 'Choose a brand to start';

      // Your setup
      const parts = [
        isMacSel(s) ? `Apple ${proc || 'MacBook, any chip'}` : `${s.brand ? brandName : 'Any brand'}, ${proc || 'any processor'}`,
        mem ? `${mem} memory` : 'any memory',
        sto ? `${sto} storage` : 'any storage',
      ];
      form.querySelector('[data-setup-line]')!.textContent = parts.join(', ');
      form.querySelector('[data-count]')!.textContent = countTxt;
      form.querySelectorAll('[data-qty-n]').forEach((el) => (el.textContent = String(n)));
      form.querySelectorAll('[data-qty-noun]').forEach((el) => (el.textContent = isMacSel(s) ? (n === 1 ? 'MacBook' : 'MacBooks') : (n === 1 ? 'laptop' : 'laptops')));
      const config = `${isMacSel(s) ? 'MacBook' : 'Laptop'}: ${parts.join(', ')}`
        + (list.length && list.length <= 6 ? `. Models: ${list.map((x) => x.m.n).join(', ')}` : '');
      quote.href = `/request-a-quote/?category=${isMacSel(s) ? 'macbooks' : 'laptops'}&qty=${n}&config=${encodeURIComponent(config.slice(0, 300))}`;
      reset.hidden = !s.brand && !s.ram && !s.storage;

      // The models beside the laptop
      const key = s.brand ? JSON.stringify([s, n]) : `popular:${n}`;
      if (key !== lastList) {
        lastList = key;
        if (!s.brand) {
          titleEl.textContent = 'Popular models';
          noteEl.textContent = 'Choose a brand on the laptop and this list follows your choices.';
          matchesEl.innerHTML = popularHTML;
          matchesEl.querySelectorAll<HTMLAnchorElement>('a.mcard-quote').forEach((a) => {
            const u = new URL(a.href, location.href);
            u.searchParams.set('qty', String(n));
            a.href = u.pathname + u.search;
          });
        } else {
          titleEl.textContent = list.length ? `${list.length} matching ${list.length === 1 ? 'model' : 'models'}` : 'No exact match';
          noteEl.textContent = list.length > 4 ? `The first four, with the setup you chose. The catalogue has all ${list.length}.` : list.length ? 'With the setup you chose.' : 'Ask for a quote anyway: we source to order and suggest the closest match.';
          matchesEl.innerHTML = list.length
            ? list.slice(0, 4).map((x) => card(x.m, x.vs, s, n)).join('')
            : `<p class="empty">Nothing in our listed range has exactly this setup.</p>`;
        }
      }
      browse.hidden = !s.brand || !list.length;
      browse.textContent = list.length > 1 ? `See all ${list.length} in the catalogue` : 'See it in the catalogue';

      last = s;
    }

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement | HTMLSelectElement;
      if (t === qty) { render(); return; }
      if (!KEYS.includes(t.name as Key)) return;
      settle(t.name as Key);
      syncOptions(get());
      render(t.name as Key);
    });
    qty.addEventListener('input', () => render());
    form.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach((b) => b.addEventListener('click', () => {
      const n = (parseInt(qty.value, 10) || 0) + Number(b.dataset.qtyStep) * (Number(qty.value) >= 50 ? 10 : Number(qty.value) >= 20 ? 5 : 1);
      qty.value = String(Math.max(1, Math.min(10000, n)));
      render();
    }));
    reset.addEventListener('click', () => {
      radios().forEach((r) => (r.checked = false));
      OPTS.forEach((k) => set(k, ''));
      syncOptions(get());
      render();
      radios()[0]?.focus();
    });
    // The catalogue button opens the catalogue with the same filters.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const s = get();
      go(s.brand ? catalogueUrl(s) : '/equipment/');
    });
    qty.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); render(); } });

    syncOptions(get());
    render();

    // The first time the builder comes into view, the screen switches on.
    const r = lap.getBoundingClientRect();
    if (!reduced.matches && 'IntersectionObserver' in window && r.top > innerHeight * 0.75) {
      lap.dataset.boot = 'off';
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        lap.dataset.boot = 'on';
      }, { threshold: 0.3 });
      io.observe(lap);
    }
  });
</script>
