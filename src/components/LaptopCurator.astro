---
/**
 * Build your own (home page, right after the hero and its describe-your-need
 * page). A laptop sits in the middle of a burgundy bench, wired to four option
 * boxes: brand, processor, memory and storage. Choosing an option plugs its
 * cable into the laptop, the screen shows the brand and the specification, and
 * the models that match are listed with a quote link for the chosen quantity.
 *
 * Options come from the catalogue data (src/data/products.ts), so the curator
 * never offers a combination that does not exist. Without JavaScript it is a
 * plain form that opens the catalogue with the same filters.
 */
import Icon from './Icon.astro';
import { PRODUCTS, formatGb, genOrder, type Product } from '../data/products';
import { BRAND_MARKS } from '../data/brand-marks';

const isMac = (p: Product) => p.brand === 'Apple';
const models = PRODUCTS.filter((p) => p.configs?.length && (p.category === 'laptops' || p.category === 'macbooks'));
const pcs = models.filter((p) => !isMac(p));
const macs = models.filter(isMac);

/** Compact data for the script: one entry per model, one variant per processor option. */
const data = models.map((p) => ({
  s: p.slug,
  n: p.name,
  b: p.brand,
  m: isMac(p) ? p.name.replace(/^Apple /, '') : '',
  sub: p.subcategory ?? '',
  img: p.images[0]?.card ?? p.images[0]?.src ?? '',
  f: p.featured ? 1 : 0,
  v: p.configs!.map((c) => ({
    f: isMac(p) ? [] : c.family ?? [],
    g: isMac(p) ? c.group : c.gen ?? '',
    c: c.chip,
    r: c.ram,
    st: c.storage,
    t: c.storageType ?? 'SSD',
  })),
}));

const uniq = <T,>(xs: T[]) => [...new Set(xs)];
const count = (brand: string) => pcs.filter((p) => p.brand === brand).length;
const brands = [
  { v: 'Lenovo', label: 'Lenovo', sub: `${count('Lenovo')} models`, mark: 'lenovo' },
  { v: 'Dell', label: 'Dell', sub: `${count('Dell')} models`, mark: 'dell' },
  { v: 'HP', label: 'HP', sub: `${count('HP')} models`, mark: 'hp' },
  { v: 'Apple', label: 'Apple', sub: 'Air and Pro', mark: 'apple' },
  { v: 'any', label: 'No preference', sub: 'Lenovo, Dell or HP', mark: '' },
] as const;

const families = uniq(pcs.flatMap((p) => p.configs!.flatMap((c) => c.family ?? []))).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
const gens = uniq(pcs.flatMap((p) => p.configs!.map((c) => c.gen ?? ''))).filter((g) => g && g !== 'Core Ultra').sort((a, b) => genOrder(a) - genOrder(b));
const chips = uniq(macs.flatMap((p) => p.configs!.map((c) => c.group))).sort((a, b) => genOrder(a) - genOrder(b) || a.localeCompare(b));
const macModels = macs.map((p) => p.name.replace(/^Apple /, ''));
const ram = uniq(models.flatMap((p) => p.configs!.flatMap((c) => c.ram))).sort((a, b) => a - b);
const storage = uniq(models.flatMap((p) => p.configs!.flatMap((c) => c.storage))).sort((a, b) => a - b);

const short = (f: string) => f.replace(/^Core Ultra /, 'Ultra ');

/** Rows of options inside each box. `for` limits a row to PCs or Macs. */
type Row = { key: string; label: string; for?: 'pc' | 'mac'; options: { v: string; l: string }[] };
const any = { v: '', l: 'Any' };
const procRows: Row[] = [
  { key: 'proc', label: 'Type', for: 'pc', options: [any, ...families.map((f) => ({ v: f, l: short(f) }))] },
  { key: 'gen', label: 'Generation', for: 'pc', options: [any, ...gens.map((g) => ({ v: g, l: g.replace(' Gen', '') }))] },
  { key: 'model', label: 'Model', for: 'mac', options: [any, ...macModels.map((m) => ({ v: m, l: m }))] },
  { key: 'chip', label: 'Chip', for: 'mac', options: [any, ...chips.map((c) => ({ v: c, l: c }))] },
];
const ramRows: Row[] = [{ key: 'ram', label: 'Memory', options: [any, ...ram.map((r) => ({ v: String(r), l: `${r} GB` }))] }];
const storageRows: Row[] = [{ key: 'storage', label: 'Storage', options: [any, ...storage.map((s) => ({ v: String(s), l: formatGb(s) }))] }];

const boxes = [
  { n: 2, id: 'proc', title: 'Processor', rows: procRows, area: 'b2' },
  { n: 3, id: 'ram', title: 'Memory', rows: ramRows, area: 'b3' },
  { n: 4, id: 'storage', title: 'Storage', rows: storageRows, area: 'b4' },
];

/** Shown before anything is chosen, and without JavaScript. */
const popular = PRODUCTS.filter((p) => p.featured && p.configs?.length).slice(0, 4);
const span = (xs: number[]) => (xs.length > 1 ? `${formatGb(Math.min(...xs))} to ${formatGb(Math.max(...xs))}` : formatGb(xs[0]));
const cardSpec = (p: Product) => {
  const c = p.configs!;
  const proc = isMac(p) ? p.processor ?? '' : uniq(c.flatMap((x) => x.family ?? [])).join(' or ');
  return [proc, `${span(uniq(c.flatMap((x) => x.ram)))} memory`, `${span(uniq(c.flatMap((x) => x.storage)))} storage`].join(', ');
};
---
<section class="section cur" id="build" aria-labelledby="cur-title">
  <div class="wrap cur-wrap">
    <div class="bench">
      <div class="bench-head">
        <h2 id="cur-title" class="bench-title">Build your team’s laptop</h2>
        <p class="bench-text">Choose a brand, then the processor, memory and storage. The models that match appear below, ready to quote for as many as you need.</p>
      </div>

    <form class="cur-form" action="/equipment/" method="get" data-cur>
      <script type="application/json" is:inline data-cur-data set:html={JSON.stringify(data)} />
      <div class="stage" data-cur-stage>
        <svg class="cables" aria-hidden="true" focusable="false" data-cables></svg>

        <!-- 1 Brand -->
        <fieldset class="box box--brand" style="grid-area: b1" data-box="brand" data-state="open">
          <legend class="box-legend"><span class="step" aria-hidden="true">1</span>Brand</legend>
          <p class="box-note" data-note>Start here.</p>
          <div class="tiles">
            {brands.map((b) => (
              <label class:list={['tile', { 'tile--wide': b.v === 'any' }]}>
                <input type="radio" name="brand" value={b.v} />
                <span class="tile-face">
                  {b.mark === 'lenovo' ? (
                    <svg class="tile-mark tile-mark--lenovo" viewBox="0 8 24 8.01" aria-hidden="true" focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                  ) : b.mark ? (
                    <svg class={`tile-mark tile-mark--${b.mark}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={BRAND_MARKS[b.mark]} fill="currentColor" /></svg>
                  ) : (
                    <span class="tile-mark tile-mark--any" aria-hidden="true"><Icon name="shuffle" size={18} stroke={1.75} /></span>
                  )}
                  <span class="tile-name">{b.label}</span>
                  <span class="tile-sub">{b.sub}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- The laptop -->
        <div class="lap" style="grid-area: lap" data-brand="" aria-hidden="true" data-lap>
          <div class="lap-lid" data-port-lid>
            <span class="lap-cam"></span>
            <div class="lap-screen">
              <div class="scr-marks" data-port="brand">
                <span class="scr-mark scr-mark--itr on" data-mark="">IT Rentals</span>
                <svg class="scr-mark scr-mark--lenovo" data-mark="Lenovo" viewBox="0 8 24 8.01" focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                <svg class="scr-mark scr-mark--dell" data-mark="Dell" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.dell} fill="currentColor" /></svg>
                <svg class="scr-mark scr-mark--hp" data-mark="HP" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.hp} fill="currentColor" /></svg>
                <svg class="scr-mark scr-mark--apple" data-mark="Apple" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.apple} fill="currentColor" /></svg>
                <span class="scr-mark scr-mark--itr" data-mark="any">IT Rentals</span>
              </div>
              <dl class="scr-spec">
                <div data-port="proc" data-row="proc"><dt>Processor</dt><dd data-val="proc">Any</dd></div>
                <div data-port="ram" data-row="ram"><dt>Memory</dt><dd data-val="ram">Any</dd></div>
                <div data-port="storage" data-row="storage"><dt>Storage</dt><dd data-val="storage">Any</dd></div>
              </dl>
              <p class="scr-foot" data-scr-foot>Choose a brand to start</p>
            </div>
          </div>
          <div class="lap-deck"><span class="lap-notch"></span></div>
          <span class="lap-floor"></span>
        </div>

        {boxes.map((b) => (
          <fieldset class="box" style={`grid-area: ${b.area}`} data-box={b.id} data-state="open">
            <legend class="box-legend"><span class="step" aria-hidden="true">{b.n}</span>{b.title}</legend>
            <p class="box-note" data-note hidden></p>
            {b.rows.map((r) => (
              <fieldset class="row" data-row-key={r.key} data-for={r.for} hidden={r.for === 'mac'}>
                {b.rows.length > 1 ? <legend class="row-label">{r.label}</legend> : <legend class="sr-only">{r.label}</legend>}
                <div class="chips">
                  {r.options.map((o) => (
                    <label class="pick" data-opt={o.v}>
                      <input type="radio" name={r.key} value={o.v} checked={o.v === ''} />
                      <span>{o.l}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </fieldset>
        ))}
      </div>

      <!-- Your setup -->
      <div class="setup" data-setup>
        <div class="setup-text">
          <p class="setup-label">Your setup</p>
          <p class="setup-line" data-setup-line>Any brand, any processor, any memory, any storage</p>
          <p class="setup-count"><span role="status" aria-live="polite" data-count>{models.length} models to choose from</span> <button type="button" class="reset" data-reset hidden>Start over</button></p>
        </div>
        <div class="setup-actions">
          <div class="qty">
            <label for="cur-qty">Quantity</label>
            <div class="qty-ctl">
              <button type="button" class="qty-btn" data-qty-step="-1" aria-label="Fewer laptops"><Icon name="minus" size={16} /></button>
              <input id="cur-qty" class="qty-in" type="number" inputmode="numeric" min="1" max="10000" value="10" data-qty />
              <button type="button" class="qty-btn" data-qty-step="1" aria-label="More laptops"><Icon name="plus" size={16} /></button>
            </div>
          </div>
          <a class="btn btn--primary" href="/request-a-quote/?category=laptops&qty=10" data-quote><span>Get a quote for <span data-qty-n>10</span> <span data-qty-noun>laptops</span></span></a>
          <button type="submit" class="btn" data-browse>See matches in the catalogue</button>
        </div>
      </div>
    </form>
    </div>

    <div class="results">
      <div class="results-head">
        <h3 class="results-title" data-results-title>Popular models</h3>
        <a class="link-arrow" href="/equipment/" data-all>Open the catalogue <Icon name="arrow-right" /></a>
      </div>
      <div class="matches" data-matches>
        {popular.map((p) => (
          <article class="mcard">
            <a class:list={['mcard-img', { 'mcard-img--studio': /-studio-/.test(p.images[0].card ?? p.images[0].src) }]} href={`/equipment/${p.slug}/`} tabindex="-1" aria-hidden="true"><img src={p.images[0].card ?? p.images[0].src} alt="" width="800" height="500" loading="lazy" decoding="async" /></a>
            <div class="mcard-body">
              <p class="mcard-sub">{p.subcategory}</p>
              <h4 class="mcard-name"><a href={`/equipment/${p.slug}/`}>{p.name}</a></h4>
              <p class="mcard-spec">{cardSpec(p)}</p>
              <a class="mcard-quote" href={`/request-a-quote/?product=${encodeURIComponent(p.slug)}&qty=10`}>Quote this model</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* deck colour follows the brand on screen, and so does the light under the laptop */
  @property --cd1 { syntax: '<color>'; inherits: true; initial-value: #2e2e31; }
  @property --cd2 { syntax: '<color>'; inherits: true; initial-value: #1a1a1c; }
  @property --cd3 { syntax: '<color>'; inherits: true; initial-value: #0a0a0b; }
  @property --glow { syntax: '<color>'; inherits: true; initial-value: rgba(224, 51, 40, .5); }

  .cur { padding-top: clamp(24px, 3vw, 48px); }
  .cur-wrap { max-width: calc(1380px + 2 * var(--gutter)); }

  /* ── The bench: a dark stage where the laptop is wired to its options ── */
  .bench {
    position: relative; isolation: isolate;
    padding: clamp(22px, 3.4vw, 52px) clamp(14px, 3vw, 48px) clamp(16px, 2.6vw, 36px);
    border-radius: clamp(20px, 2.4vw, 32px); color: var(--on-dark);
    background-color: #2a0a0f;
    background-image:
      var(--grain),
      radial-gradient(44% 48% at 50% 46%, rgba(168, 42, 52, .62) 0%, rgba(110, 24, 33, .3) 50%, rgba(110, 24, 33, 0) 80%),
      linear-gradient(180deg, #4a0e15 0%, #2a0a0f 55%, #1c060a 100%);
    background-size: 220px 220px, auto, auto;
    box-shadow: 0 50px 90px -50px rgba(58, 12, 18, .75);
  }
  /* fine dot texture, strongest round the laptop */
  .bench::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
    background-image: radial-gradient(rgba(243, 238, 229, .1) 1px, transparent 1px); background-size: 22px 22px;
    mask-image: radial-gradient(60% 55% at 50% 45%, #000 20%, transparent 80%);
  }
  .bench-head { display: grid; justify-items: center; gap: 8px; margin: 0 auto clamp(22px, 3vw, 40px); max-width: 640px; text-align: center; }
  .bench-title { margin: 0; color: var(--on-dark); font-family: var(--font-display); font-weight: 400; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem); line-height: 1.05; letter-spacing: -0.02em; }
  .bench-text { margin: 0; color: rgba(243, 238, 229, .78); line-height: 1.55; }

  .stage { position: relative; display: grid; gap: 16px; }

  /* ── Option boxes ── */
  .box {
    position: relative; z-index: 1; min-width: 0; margin: 0; color: var(--ink);
    padding: 18px 18px 20px; border: 1px solid transparent; border-radius: var(--r-lg);
    background: var(--card); box-shadow: 0 24px 50px -30px rgba(0, 0, 0, .8);
    transition: border-color .3s ease, box-shadow .3s ease, background-color .3s ease;
  }
  .box[data-state='done'] { border-color: var(--red); box-shadow: 0 0 0 3px rgba(224, 51, 40, .22), 0 24px 50px -30px rgba(0, 0, 0, .8); }
  .box[data-state='locked'] { background: #E4DCCF; box-shadow: none; }
  .box[data-state='locked'] .chips, .box[data-state='locked'] .row-label { opacity: .45; }
  .box-legend { display: flex; align-items: center; gap: 10px; padding: 0; float: left; width: 100%; font-weight: 600; font-size: 1.0625rem; }
  .box > :not(.box-legend) { clear: both; }
  .step {
    display: inline-grid; place-items: center; width: 26px; height: 26px; flex: none; border-radius: 50%;
    border: 1.5px solid var(--line-strong); font-size: .8125rem; font-weight: 700; color: var(--ink-2);
    transition: background-color .25s ease, border-color .25s ease, color .25s ease;
  }
  .box[data-state='done'] .step { background: var(--red-ink); border-color: var(--red-ink); color: #fff; }
  .box-note { margin: 4px 0 0; padding-left: 36px; font-size: var(--fs-xs); color: var(--ink-2); }
  .row { min-width: 0; margin: 14px 0 0; padding: 0; border: 0; }
  .row-label { padding: 0; margin-bottom: 8px; font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .pick { position: relative; }
  .pick input, .tile input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .pick span {
    display: inline-flex; align-items: center; min-height: 36px; padding: 6px 12px; border-radius: var(--r-pill);
    border: 1px solid var(--line-strong); background: var(--paper); font-size: .875rem; font-weight: 600; white-space: nowrap;
    cursor: pointer; transition: background-color .18s ease, color .18s ease, border-color .18s ease;
  }
  .pick:hover span { border-color: var(--ink); }
  .pick input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .pick input:focus-visible + span, .tile input:focus-visible + .tile-face { outline: 3px solid var(--blue); outline-offset: 2px; }
  .pick input:disabled + span { cursor: not-allowed; border-style: dashed; color: var(--ink-3); background: transparent; }

  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
  .tile { position: relative; }
  .tile--wide { grid-column: 1 / -1; }
  .tile-face {
    display: grid; align-content: start; gap: 2px; height: 100%; padding: 12px 12px 11px;
    border-radius: var(--r-md); border: 1px solid var(--line-strong); background: var(--paper);
    cursor: pointer; transition: background-color .18s ease, color .18s ease, border-color .18s ease;
  }
  .tile--wide .tile-face { grid-template-columns: auto 1fr; column-gap: 12px; align-items: center; }
  .tile--wide .tile-mark { grid-row: 1 / 3; }
  .tile:hover .tile-face { border-color: var(--ink); }
  .tile input:checked + .tile-face { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .tile-mark { display: block; width: 22px; height: 22px; margin-bottom: 6px; color: currentColor; }
  .tile-mark--apple { width: 19px; }
  .tile-mark--lenovo { width: 54px; height: 18px; margin-top: 2px; margin-bottom: 8px; }
  .tile-mark--any { display: grid; place-items: center; margin: 0; }
  .tile-name { font-weight: 600; font-size: .9375rem; line-height: 1.2; }
  .tile-sub { font-size: .75rem; line-height: 1.3; color: var(--ink-2); }
  .tile input:checked + .tile-face .tile-sub { color: rgba(243, 238, 229, .78); }

  /* ── The laptop: black, like the one on the first screen ── */
  .lap { position: relative; z-index: 1; width: 100%; max-width: 560px; margin: 8px auto; container-type: inline-size; }
  .lap-lid {
    position: relative; z-index: 1; width: 94%; margin: 0 auto; padding: 2.2cqi 2.2cqi 3.4cqi;
    background: linear-gradient(180deg, #141214, #050405); border-radius: 3.6cqi 3.6cqi 1cqi 1cqi;
    box-shadow:
      inset 0 0 0 1px rgba(243,238,229,.14), 0 0 0 1px rgba(0,0,0,.7),
      0 50px 80px -40px rgba(0,0,0,.9), 0 0 120px -20px var(--glow);
    transition: box-shadow .6s ease;
  }
  .lap-cam { position: absolute; top: 1cqi; left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #2a2622; box-shadow: inset 0 0 0 1px #3d3832; }
  .lap-screen {
    position: relative; aspect-ratio: 16 / 10.6; overflow: hidden; border-radius: 1.4cqi 1.4cqi .4cqi .4cqi;
    display: grid; grid-template-rows: 1fr auto auto; padding: 4cqi 6cqi 3.4cqi; gap: 2.4cqi;
    color: #F3EEE5;
    background: radial-gradient(90% 70% at 50% 18%, #2e2220 0%, #141010 55%, #0b0908 100%);
  }
  /* a soft reflection on the glass, and a line of light that sweeps down when the brand changes */
  .lap-screen::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, rgba(255,255,255,.09) 0%, rgba(255,255,255,0) 34%); }
  .lap-screen::after {
    content: ''; position: absolute; left: 0; right: 0; top: -30%; height: 30%; pointer-events: none; opacity: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0), rgba(255,255,255,.12) 85%, rgba(255,255,255,.3));
  }
  .lap-screen:global(.scan)::after { animation: scan .7s cubic-bezier(.4, 0, .2, 1); }
  @keyframes scan { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(430%); } }
  .scr-marks { position: relative; display: grid; place-items: center; min-height: 0; }
  .scr-mark {
    grid-area: 1 / 1; display: block; opacity: 0; transform: scale(.92); filter: blur(6px); color: #fff;
    transition: opacity .4s ease, transform .6s var(--ease-out), filter .4s ease;
  }
  .scr-mark.on { opacity: 1; transform: none; filter: none; }
  .scr-mark--apple { width: 9cqi; height: 11cqi; }
  .scr-mark--hp, .scr-mark--dell { width: 12cqi; height: 12cqi; }
  .scr-mark--lenovo { width: 27cqi; height: 9cqi; }
  .scr-mark--itr { font-family: var(--font-display); font-size: 9.5cqi; line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .scr-spec { display: grid; gap: .6cqi; margin: 0; padding: 2.2cqi 0 0; border-top: 1px solid rgba(243,238,229,.14); }
  .scr-spec div {
    display: grid; grid-template-columns: 26cqi 1fr; align-items: baseline; padding: 1cqi 1.6cqi; border-radius: 1cqi;
    transition: background-color .5s ease;
  }
  .scr-spec div.flash { background-color: rgba(224, 51, 40, .28); transition: none; }
  .scr-spec dt { font-size: 3cqi; color: rgba(243,238,229,.6); }
  .scr-spec dd { margin: 0; font-size: 3.6cqi; font-weight: 600; color: rgba(243,238,229,.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .scr-spec dd.set { color: #fff; }
  .scr-foot { margin: 0; display: flex; align-items: center; gap: 1.6cqi; font-size: 3cqi; color: rgba(243,238,229,.75); }
  .scr-foot::before { content: ''; width: 1.6cqi; height: 1.6cqi; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 .8cqi rgba(224,51,40,.22); }
  .lap-deck {
    position: relative; z-index: 1; height: 3cqi; margin-top: -1px;
    background: linear-gradient(180deg, var(--cd1) 0%, var(--cd2) 45%, var(--cd3) 100%);
    border-radius: 2px 2px 3.4cqi 3.4cqi / 2px 2px 2cqi 2cqi;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.3);
    transition: --cd1 .6s ease, --cd2 .6s ease, --cd3 .6s ease;
  }
  .lap-notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, var(--cd3), var(--cd2)); border-radius: 0 0 9px 9px; opacity: .7; }
  /* the light the screen throws on the bench */
  .lap-floor {
    position: absolute; left: -6%; right: -6%; bottom: -9cqi; height: 16cqi; z-index: 0; pointer-events: none; border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow), transparent); opacity: .55; transition: --glow .6s ease;
  }
  .lap[data-brand='Apple'] { --cd1: #e6e6e9; --cd2: #bcbcc1; --cd3: #8d8d93; --glow: rgba(214, 214, 224, .38); }
  .lap[data-brand='HP'] { --cd1: #dedfe2; --cd2: #b3b4b8; --cd3: #85868b; --glow: rgba(0, 150, 214, .42); }
  .lap[data-brand='Dell'] { --cd1: #73767c; --cd2: #4a4d52; --cd3: #2c2e32; --glow: rgba(0, 118, 206, .45); }
  .lap[data-brand='Lenovo'] { --cd1: #404042; --cd2: #252527; --cd3: #131314; --glow: rgba(226, 35, 26, .5); }

  /* The screen switches on the first time the builder comes into view */
  .stage[data-boot='off'] .lap-screen > * { opacity: 0; }
  .stage[data-boot='off'] .lap-lid { box-shadow: inset 0 0 0 1px rgba(243,238,229,.14), 0 0 0 1px rgba(0,0,0,.7), 0 50px 80px -40px rgba(0,0,0,.9); }
  .stage[data-boot='on'] .lap-screen > * { animation: boot .7s ease backwards; }
  .stage[data-boot='on'] .scr-spec { animation-delay: .25s; }
  .stage[data-boot='on'] .scr-foot { animation-delay: .45s; }
  @keyframes boot { from { opacity: 0; transform: translateY(1.6cqi); } }

  /* ── Cables (drawn by the script on wide screens) ── */
  .cables { display: none; }
  .cables :global(.cable) { fill: none; stroke: rgba(243,238,229,.26); stroke-width: 1.5; stroke-dasharray: 3 6; stroke-linecap: round; transition: stroke .3s ease; }
  .cables :global(.cable.locked) { stroke: rgba(243,238,229,.12); }
  .cables :global(.cable.done) { stroke: #c4382c; stroke-dasharray: none; stroke-width: 2.5; filter: drop-shadow(0 0 5px rgba(224, 51, 40, .75)); }
  /* current flowing to the laptop along a plugged-in cable */
  .cables :global(.flow) { fill: none; stroke: #ffc2b8; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1.5 14; opacity: 0; transition: opacity .3s ease; }
  .cables :global(.flow.done) { opacity: .9; animation: flow 1.1s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -15.5; } }
  .cables :global(.spark) { fill: none; stroke: #ffd9d2; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 0 100; opacity: 0; filter: drop-shadow(0 0 6px #ff6a5c); }
  .cables :global(.spark.run) { animation: spark .75s cubic-bezier(.45, 0, .2, 1) both; }
  @keyframes spark {
    0% { stroke-dasharray: 0 100; stroke-dashoffset: 0; opacity: 1; }
    20% { stroke-dasharray: 10 100; }
    100% { stroke-dasharray: 10 100; stroke-dashoffset: -100; opacity: 0; }
  }
  .cables :global(.sock) { fill: #2a0a0f; stroke: rgba(243,238,229,.45); stroke-width: 1.5; transition: fill .3s ease, stroke .3s ease; }
  .cables :global(.sock.done) { fill: var(--red); stroke: #ffc2b8; filter: drop-shadow(0 0 6px rgba(224, 51, 40, .9)); }
  .cables :global(.port) { fill: #2a2622; stroke: rgba(243,238,229,.3); stroke-width: 1; transition: fill .3s ease; }
  .cables :global(.port.done) { fill: var(--red); stroke: rgba(255,255,255,.6); filter: drop-shadow(0 0 5px rgba(224, 51, 40, .9)); }

  @media (min-width: 1100px) {
    .stage {
      grid-template-columns: minmax(250px, 300px) minmax(0, 1fr) minmax(250px, 300px);
      grid-template-areas: 'b1 lap b3' 'b2 lap b4';
      column-gap: clamp(56px, 5vw, 96px); row-gap: 24px; align-items: center;
    }
    .lap { max-width: 640px; margin: 0 auto; }
    .cables { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
  }

  /* Narrower screens: a chain of boxes, each linked to the next */
  @media (max-width: 1099px) {
    .box::before {
      content: ''; position: absolute; left: 30px; top: -23px; width: 2px; height: 22px;
      background: repeating-linear-gradient(to bottom, rgba(243,238,229,.32) 0 3px, transparent 3px 7px);
    }
    .box[data-state='done']::before { background: var(--red); box-shadow: 0 0 6px rgba(224, 51, 40, .8); }
  }
  /* Phones: the laptop on top, the chain below it */
  @media (max-width: 759px) {
    .stage { grid-template-areas: 'lap' 'b1' 'b2' 'b3' 'b4'; gap: 22px; }
    .lap { max-width: 460px; margin-bottom: 14px; }
  }
  /* Tablets: the laptop stays in view on the left while the boxes scroll past */
  @media (min-width: 760px) and (max-width: 1099px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); grid-template-areas: 'lap b1' 'lap b2' 'lap b3' 'lap b4';
      column-gap: clamp(24px, 4vw, 40px); row-gap: 22px; align-items: start;
    }
    .lap { position: sticky; top: 112px; align-self: start; max-width: none; margin: 0; }
    .box--brand::before { display: none; }
  }

  /* ── Your setup ── */
  .setup {
    display: grid; gap: 18px 32px; margin-top: clamp(24px, 3vw, 40px); padding: 22px 24px; border-radius: var(--r-xl);
    background: rgba(243, 238, 229, .06); border: 1px solid var(--hair-dark-strong); color: var(--on-dark);
  }
  .setup-label { margin: 0; font-size: var(--fs-xs); color: var(--on-dark-2); }
  .setup-line { margin: 4px 0 0; font-family: var(--font-display); font-size: clamp(1.25rem, 1.05rem + .7vw, 1.6rem); line-height: 1.25; }
  .setup-count { margin: 6px 0 0; font-size: var(--fs-small); color: var(--on-dark-2); }
  .setup-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  .setup .btn:not(.btn--primary) { --btn-fg: var(--on-dark); --btn-bd: var(--hair-dark-strong); --btn-bg: transparent; }
  .setup .btn:not(.btn--primary):hover { --btn-bd: var(--on-dark); }
  .qty { display: flex; align-items: center; gap: 10px; }
  .qty label { font-size: var(--fs-xs); color: var(--on-dark-2); }
  .qty-ctl { display: inline-flex; align-items: center; border: 1px solid var(--hair-dark-strong); border-radius: var(--r-pill); }
  .qty-btn { display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: var(--on-dark); cursor: pointer; }
  .qty-btn:hover { background: rgba(243,238,229,.08); }
  .qty-in {
    width: 64px; height: 40px; border: 0; background: transparent; color: var(--on-dark); text-align: center;
    font: inherit; font-weight: 600; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield;
  }
  .qty-in::-webkit-outer-spin-button, .qty-in::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .qty-btn:focus-visible, .qty-in:focus-visible { outline: 3px solid var(--red-soft); outline-offset: 2px; }
  .setup .btn:focus-visible { outline-color: var(--red-soft); }
  .reset { margin-left: 10px; border: 0; background: none; padding: 4px 2px; color: var(--on-dark); font: inherit; font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .reset:focus-visible { outline: 3px solid var(--red-soft); outline-offset: 2px; }
  @media (min-width: 1100px) { .setup { grid-template-columns: minmax(0, 1fr) auto; align-items: center; } }
  @media (forced-colors: active) { .bench, .lap-lid { border: 1px solid CanvasText; } }

  /* ── Matching models ── */
  .results { margin-top: var(--s-7); }
  .results-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: var(--s-5); }
  .results-title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h3); }
  .matches { display: grid; gap: 16px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1099px) { .matches { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .matches :global(.mcard) {
    display: grid; grid-template-rows: auto 1fr; overflow: hidden; border-radius: var(--r-lg);
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow-soft);
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }
  .matches :global(.mcard:hover) { transform: translateY(-3px); box-shadow: var(--shadow-block); }
  .matches :global(.mcard-img) { display: block; overflow: hidden; background: var(--paper-3); }
  .matches :global(.mcard-img img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .matches :global(.mcard:hover .mcard-img img) { transform: scale(1.035); }
  .matches :global(.mcard-img--studio) { background: radial-gradient(70% 85% at 50% 42%, #FBF8F2 0%, #EFE9DF 62%, #E6DED1 100%); }
  .matches :global(.mcard-img--studio img) { object-fit: cover; mix-blend-mode: multiply; }
  .matches :global(.mcard-body) { display: grid; align-content: start; gap: 6px; padding: 14px 16px 18px; }
  .matches :global(.mcard-sub) { margin: 0; font-size: var(--fs-xs); color: var(--ink-2); }
  .matches :global(.mcard-name) { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; line-height: 1.15; letter-spacing: -0.01em; }
  .matches :global(.mcard-name a) { text-decoration: none; }
  .matches :global(.mcard-name a:hover) { text-decoration: underline; text-underline-offset: 3px; }
  .matches :global(.mcard-spec) { margin: 0; font-size: var(--fs-small); line-height: 1.5; color: var(--ink-2); }
  .matches :global(.mcard-quote) { justify-self: start; margin-top: 6px; font-size: var(--fs-small); font-weight: 600; color: var(--red-ink); text-underline-offset: 3px; }
  /* Phones: compact cards with a thumbnail */
  @media (max-width: 699px) {
    .matches { grid-template-columns: 1fr; gap: 12px; }
    .matches :global(.mcard) { grid-template-columns: 112px minmax(0, 1fr); grid-template-rows: none; }
    .matches :global(.mcard-img) { display: block; }
    .matches :global(.mcard-img img) { height: 100%; aspect-ratio: auto; }
    .matches :global(.mcard-body) { padding: 12px 14px 14px; gap: 4px; }
    .matches :global(.mcard-name) { font-size: 1.125rem; }
    .matches :global(.mcard-spec) { font-size: var(--fs-xs); }
  }
  .matches :global(.empty) { grid-column: 1 / -1; margin: 0; padding: 22px; border: 1px dashed var(--line-strong); border-radius: var(--r-lg); color: var(--ink-2); }

  @media (prefers-reduced-motion: reduce) {
    .scr-mark, .box, .pick span, .tile-face, .lap-deck, .lap-lid, .lap-floor, .scr-spec div { transition: none; }
    .cables :global(.spark.run), .cables :global(.flow.done), .lap-screen:global(.scan)::after { animation: none; }
  }
</style>

<script>
  type Variant = { f: string[]; g: string; c: string; r: number[]; st: number[]; t: string };
  type Model = { s: string; n: string; b: string; m: string; sub: string; img: string; f: number; v: Variant[] };
  type Sel = { brand: string; proc: string; gen: string; model: string; chip: string; ram: string; storage: string };
  type Key = keyof Sel;

  const fmt = (n: number) => (n >= 1024 ? `${n / 1024} TB` : `${n} GB`);
  const span = (xs: number[]) => {
    const u = [...new Set(xs)].sort((a, b) => a - b);
    return u.length > 1 ? `${fmt(u[0])} to ${fmt(u[u.length - 1])}` : fmt(u[0]);
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const chipName = (c: string) => c.replace(/^Intel /, '').replace(/^Apple /, '').replace(/ \((\d+\w\w Gen)\)/, ' $1');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLFormElement>('[data-cur]').forEach((form) => {
    const section = form.closest('section')!;
    const models = JSON.parse(form.querySelector('[data-cur-data]')!.textContent!) as Model[];
    const stage = form.querySelector<HTMLElement>('[data-cur-stage]')!;
    const svg = form.querySelector<SVGSVGElement>('[data-cables]')!;
    const lap = form.querySelector<HTMLElement>('[data-lap]')!;
    const lid = lap.querySelector<HTMLElement>('[data-port-lid]')!;
    const screen = lap.querySelector<HTMLElement>('.lap-screen')!;
    screen.addEventListener('animationend', () => screen.classList.remove('scan'));
    const qty = form.querySelector<HTMLInputElement>('[data-qty]')!;
    const quote = form.querySelector<HTMLAnchorElement>('[data-quote]')!;
    const reset = form.querySelector<HTMLButtonElement>('[data-reset]')!;
    const matchesEl = section.querySelector<HTMLElement>('[data-matches]')!;
    const titleEl = section.querySelector<HTMLElement>('[data-results-title]')!;
    const allEl = section.querySelector<HTMLAnchorElement>('[data-all]')!;
    const popularHTML = matchesEl.innerHTML;
    const box = (id: string) => form.querySelector<HTMLFieldSetElement>(`[data-box="${id}"]`)!;
    const BOXES = ['brand', 'proc', 'ram', 'storage'] as const;
    const KEYS: Key[] = ['brand', 'proc', 'gen', 'model', 'chip', 'ram', 'storage'];
    const radios = (k: Key) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${k}"]`)];
    const get = (): Sel => Object.fromEntries(KEYS.map((k) => [k, radios(k).find((r) => r.checked)?.value ?? ''])) as Sel;
    const set = (k: Key, v: string) => radios(k).forEach((r) => (r.checked = r.value === v));

    // A brand restored by the browser (back button) keeps its choices; otherwise start clean.
    if (!get().brand) (['proc', 'gen', 'model', 'chip', 'ram', 'storage'] as Key[]).forEach((k) => set(k, ''));

    const isMacSel = (s: Sel) => s.brand === 'Apple';
    function brandOk(m: Model, s: Sel) {
      if (!s.brand) return true;
      if (s.brand === 'any') return m.b !== 'Apple';
      return m.b === s.brand;
    }
    function fits(m: Model, v: Variant, s: Sel, skip?: Key) {
      if (!brandOk(m, s)) return false;
      if (isMacSel(s)) {
        if (skip !== 'model' && s.model && m.m !== s.model) return false;
        if (skip !== 'chip' && s.chip && v.g !== s.chip) return false;
      } else {
        if (skip !== 'proc' && s.proc && !v.f.includes(s.proc)) return false;
        if (skip !== 'gen' && s.gen && v.g !== s.gen) return false;
      }
      if (skip !== 'ram' && s.ram && !v.r.includes(Number(s.ram))) return false;
      if (skip !== 'storage' && s.storage && !v.st.includes(Number(s.storage))) return false;
      return true;
    }
    const has = (k: Key, val: string, m: Model, v: Variant) => {
      if (k === 'proc') return v.f.includes(val);
      if (k === 'gen' || k === 'chip') return v.g === val;
      if (k === 'model') return m.m === val;
      if (k === 'ram') return v.r.includes(Number(val));
      if (k === 'storage') return v.st.includes(Number(val));
      return true;
    };
    const matching = (s: Sel) => models.map((m) => ({ m, vs: m.v.filter((v) => fits(m, v, s)) })).filter((x) => x.vs.length);

    /** Show only the options the chosen brand has; disable ones that clash with other choices. */
    function syncOptions(s: Sel) {
      const brandModels = models.filter((m) => brandOk(m, s));
      for (const k of ['proc', 'gen', 'model', 'chip', 'ram', 'storage'] as Key[]) {
        radios(k).forEach((r) => {
          if (!r.value) { r.disabled = !s.brand; return; }
          const exists = brandModels.some((m) => m.v.some((v) => has(k, r.value, m, v)));
          const possible = exists && brandModels.some((m) => m.v.some((v) => has(k, r.value, m, v) && fits(m, v, s, k)));
          r.closest<HTMLElement>('.pick')!.hidden = !!s.brand && !exists;
          r.disabled = !s.brand || !possible;
        });
      }
      // Processor rows: PC rows or Mac rows; no generation row for Core Ultra.
      form.querySelectorAll<HTMLFieldSetElement>('[data-row-key]').forEach((row) => {
        const forWhat = row.dataset.for;
        let show = !forWhat || (forWhat === 'mac' ? isMacSel(s) : !isMacSel(s));
        if (row.dataset.rowKey === 'gen' && s.proc.startsWith('Core Ultra')) show = false;
        row.hidden = !show;
      });
    }

    /**
     * Drop choices that no longer fit after another choice changed. The choice
     * just made wins, then the boxes in order.
     */
    function settle(changed: Key) {
      if (changed === 'brand') (['proc', 'gen', 'model', 'chip'] as Key[]).forEach((k) => set(k, ''));
      if (changed === 'proc' && get().proc.startsWith('Core Ultra')) set('gen', '');
      const s = get();
      const acc: Sel = { brand: s.brand, proc: '', gen: '', model: '', chip: '', ram: '', storage: '' };
      const order: Key[] = ['proc', 'gen', 'model', 'chip', 'ram', 'storage'];
      for (const k of [changed, ...order.filter((x) => x !== changed)]) {
        if (k === 'brand' || !s[k]) continue;
        const trial = { ...acc, [k]: s[k] };
        if (models.some((m) => m.v.some((v) => fits(m, v, trial)))) acc[k] = s[k];
        else set(k, '');
      }
    }

    const procText = (s: Sel, list: { m: Model; vs: Variant[] }[]) => {
      if (isMacSel(s)) {
        const tiers = [...new Set(list.flatMap((x) => x.vs.map((v) => v.c)))];
        const chip = s.chip ? (tiers.length === 1 ? chipName(tiers[0]) : s.chip) : '';
        return [s.model, chip].filter(Boolean).join(' ');
      }
      return [s.proc, s.gen].filter(Boolean).join(' ');
    };

    function card(m: Model, vs: Variant[], s: Sel, n: number) {
      const chipsTxt = [...new Set(vs.map((v) => chipName(v.c)))];
      const proc = chipsTxt.length > 2 ? `${chipsTxt.slice(0, 2).join(', ')} and ${chipsTxt.length - 2} more` : chipsTxt.join(' or ');
      const mem = `${s.ram ? fmt(Number(s.ram)) : span(vs.flatMap((v) => v.r))} memory`;
      const sto = s.storage ? `${fmt(Number(s.storage))} ${vs[0].t}` : `${span(vs.flatMap((v) => v.st))} storage`;
      const config = `${m.n}, ${proc}, ${mem}, ${sto}`;
      const href = `/equipment/${m.s}/`;
      const q = `/request-a-quote/?product=${encodeURIComponent(m.s)}&qty=${n}&config=${encodeURIComponent(config)}`;
      const studio = /-studio-/.test(m.img) ? ' mcard-img--studio' : '';
      return `<article class="mcard"><a class="mcard-img${studio}" href="${href}" tabindex="-1" aria-hidden="true"><img src="${esc(m.img)}" alt="" width="800" height="500" loading="lazy" decoding="async"></a>`
        + `<div class="mcard-body"><p class="mcard-sub">${esc(m.sub)}</p><h4 class="mcard-name"><a href="${href}">${esc(m.n)}</a></h4>`
        + `<p class="mcard-spec">${esc(`${proc}, ${mem}, ${sto}`)}</p>`
        + `<a class="mcard-quote" href="${q}">Quote ${n} of this model</a></div></article>`;
    }

    function catalogueUrl(s: Sel) {
      const p = new URLSearchParams();
      if (isMacSel(s)) {
        p.set('category', 'macbooks'); p.set('brand', 'Apple');
        if (s.chip.startsWith('M')) p.set('gen', s.chip);
        // Intel Macs have no generation filter; a search term picks them out.
        const q = [s.model.toLowerCase(), s.chip.startsWith('Intel') ? 'intel' : ''].filter(Boolean).join(' ');
        if (q) p.set('q', q);
      } else {
        p.set('category', 'laptops');
        if (s.brand && s.brand !== 'any') p.set('brand', s.brand);
        if (s.proc) p.set('proc', s.proc);
        if (s.gen) p.set('gen', s.gen);
        else if (s.proc.startsWith('Core Ultra')) p.set('gen', 'Core Ultra');
      }
      if (s.ram) p.set('ram', s.ram);
      if (s.storage) p.set('storage', s.storage);
      return `/equipment/?${p.toString().replace(/%2C/g, ',')}`;
    }

    let last: Sel | null = null;
    function render() {
      const s = get();
      const list = s.brand ? matching(s) : [];
      const n = Math.max(1, Math.min(10000, parseInt(qty.value, 10) || 1));
      const brandName = s.brand === 'any' ? 'Lenovo, Dell or HP' : s.brand;
      const proc = procText(s, list);
      const mem = s.ram ? fmt(Number(s.ram)) : '';
      const sto = s.storage ? fmt(Number(s.storage)) : '';

      // Boxes: locked until a brand is chosen, done once something specific is picked.
      const picked: Record<string, boolean> = {
        brand: !!s.brand, proc: !!(s.proc || s.gen || s.model || s.chip), ram: !!s.ram, storage: !!s.storage,
      };
      BOXES.forEach((id) => {
        const st = id !== 'brand' && !s.brand ? 'locked' : picked[id] ? 'done' : 'open';
        box(id).dataset.state = st;
        const note = box(id).querySelector<HTMLElement>('[data-note]');
        if (note && id !== 'brand') { note.hidden = st !== 'locked'; note.textContent = 'Choose a brand first.'; }
      });
      box('brand').querySelector<HTMLElement>('[data-note]')!.hidden = !!s.brand;

      // Screen (a line of light sweeps down it when the brand changes)
      if (last && last.brand !== s.brand && !reduced.matches) {
        screen.classList.remove('scan');
        void screen.offsetWidth;
        screen.classList.add('scan');
      }
      lap.dataset.brand = s.brand;
      lap.querySelectorAll<Element>('[data-mark]').forEach((el) => el.classList.toggle('on', (el as HTMLElement).dataset.mark === s.brand));
      const vals: Record<string, string> = { proc: proc || 'Any', ram: mem || 'Any', storage: sto || 'Any' };
      (['proc', 'ram', 'storage'] as const).forEach((k) => {
        const dd = lap.querySelector<HTMLElement>(`[data-val="${k}"]`)!;
        if (dd.textContent !== vals[k]) {
          dd.textContent = vals[k];
          const row = dd.parentElement!;
          if (last && !reduced.matches) { row.classList.add('flash'); requestAnimationFrame(() => requestAnimationFrame(() => row.classList.remove('flash'))); }
        }
        dd.classList.toggle('set', vals[k] !== 'Any');
      });
      const countTxt = !s.brand ? `${models.length} models to choose from` : list.length ? `${list.length} ${list.length === 1 ? 'model matches' : 'models match'}` : 'No exact match: ask us and we will source it';
      lap.querySelector('[data-scr-foot]')!.textContent = s.brand ? countTxt : 'Choose a brand to start';

      // Setup summary and links
      const parts = [
        isMacSel(s) ? `Apple ${proc || 'MacBook, any chip'}` : `${s.brand ? brandName : 'Any brand'}, ${proc || 'any processor'}`,
        mem ? `${mem} memory` : 'any memory',
        sto ? `${sto} storage` : 'any storage',
      ];
      form.querySelector('[data-setup-line]')!.textContent = parts.join(', ');
      form.querySelector('[data-count]')!.textContent = countTxt;
      form.querySelectorAll('[data-qty-n]').forEach((el) => (el.textContent = String(n)));
      form.querySelectorAll('[data-qty-noun]').forEach((el) => (el.textContent = isMacSel(s) ? (n === 1 ? 'MacBook' : 'MacBooks') : (n === 1 ? 'laptop' : 'laptops')));
      const config = `${isMacSel(s) ? 'MacBook' : 'Laptop'}: ${parts.join(', ')}`
        + (list.length && list.length <= 6 ? `. Models: ${list.map((x) => x.m.n).join(', ')}` : '');
      quote.href = `/request-a-quote/?category=${isMacSel(s) ? 'macbooks' : 'laptops'}&qty=${n}&config=${encodeURIComponent(config.slice(0, 300))}`;
      reset.hidden = !s.brand && !s.ram && !s.storage;

      // Matching models
      if (!s.brand) {
        titleEl.textContent = 'Popular models';
        if (last?.brand) matchesEl.innerHTML = popularHTML;
        matchesEl.querySelectorAll<HTMLAnchorElement>('a.mcard-quote').forEach((a) => {
          const u = new URL(a.href, location.href);
          u.searchParams.set('qty', String(n));
          a.href = u.pathname + u.search;
        });
        allEl.href = '/equipment/';
        allEl.firstChild!.textContent = 'Open the catalogue ';
      } else {
        titleEl.textContent = list.length ? `${list.length} matching ${list.length === 1 ? 'model' : 'models'}` : 'No exact match';
        matchesEl.innerHTML = list.length
          ? list.slice(0, 4).map((x) => card(x.m, x.vs, s, n)).join('')
          : `<p class="empty">Nothing in our listed range has exactly this setup. Ask for a quote anyway: we source to order and will suggest the closest match.</p>`;
        allEl.href = catalogueUrl(s);
        allEl.firstChild!.textContent = list.length > 4 ? `See all ${list.length} in the catalogue ` : 'Open in the catalogue ';
      }

      const prev = last;
      last = s;
      draw(prev, s, picked);
    }

    // ── Cables ──
    const NS = 'http://www.w3.org/2000/svg';
    const wide = matchMedia('(min-width: 1100px)');
    const cable: Record<string, { path: SVGPathElement; flow: SVGPathElement; spark: SVGPathElement; sock: SVGCircleElement; port: SVGRectElement }> = {};
    BOXES.forEach((id) => {
      const g = document.createElementNS(NS, 'g');
      const path = document.createElementNS(NS, 'path'); path.setAttribute('class', 'cable');
      const flow = document.createElementNS(NS, 'path'); flow.setAttribute('class', 'flow');
      const spark = document.createElementNS(NS, 'path'); spark.setAttribute('class', 'spark'); spark.setAttribute('pathLength', '100');
      const sock = document.createElementNS(NS, 'circle'); sock.setAttribute('class', 'sock'); sock.setAttribute('r', '5');
      const port = document.createElementNS(NS, 'rect'); port.setAttribute('class', 'port'); port.setAttribute('width', '6'); port.setAttribute('height', '14'); port.setAttribute('rx', '2');
      spark.addEventListener('animationend', () => spark.classList.remove('run'));
      g.append(path, flow, spark, sock, port);
      svg.append(g);
      cable[id] = { path, flow, spark, sock, port };
    });

    function geometry() {
      if (!wide.matches) return;
      const o = stage.getBoundingClientRect();
      const L = lid.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${o.width} ${o.height}`);
      BOXES.forEach((id) => {
        const b = box(id).getBoundingClientRect();
        const left = b.right <= L.left;
        const target = lap.querySelector<HTMLElement>(`[data-port="${id}"]`)!.getBoundingClientRect();
        const ax = (left ? b.right : b.left) - o.left;
        const ay = b.top + Math.min(b.height / 2, 120) - o.top;
        const px = (left ? L.left : L.right) - o.left;
        const py = target.top + target.height / 2 - o.top;
        const mx = (ax + px) / 2;
        const d = `M${ax.toFixed(1)} ${ay.toFixed(1)} C${mx.toFixed(1)} ${ay.toFixed(1)} ${mx.toFixed(1)} ${py.toFixed(1)} ${(px + (left ? -3 : 3)).toFixed(1)} ${py.toFixed(1)}`;
        const c = cable[id];
        c.path.setAttribute('d', d);
        c.flow.setAttribute('d', d);
        c.spark.setAttribute('d', d);
        c.sock.setAttribute('cx', ax.toFixed(1)); c.sock.setAttribute('cy', ay.toFixed(1));
        c.port.setAttribute('x', (px - 3).toFixed(1)); c.port.setAttribute('y', (py - 7).toFixed(1));
      });
    }

    function draw(prev: Sel | null, s: Sel, picked: Record<string, boolean>) {
      geometry();
      BOXES.forEach((id) => {
        const c = cable[id];
        const locked = id !== 'brand' && !s.brand;
        c.path.classList.toggle('locked', locked);
        c.path.classList.toggle('done', picked[id]);
        c.flow.classList.toggle('done', picked[id]);
        c.sock.classList.toggle('done', picked[id]);
        c.port.classList.toggle('done', picked[id]);
        // A spark runs to the laptop when a box's choice changes to something specific.
        const was = prev && (id === 'proc' ? [prev.proc, prev.gen, prev.model, prev.chip].join('|') : prev[id as Key]);
        const now = id === 'proc' ? [s.proc, s.gen, s.model, s.chip].join('|') : s[id as Key];
        if (prev && picked[id] && was !== now && wide.matches && !reduced.matches) {
          c.spark.classList.remove('run');
          void c.spark.getBoundingClientRect();
          c.spark.classList.add('run');
        }
      });
    }

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t === qty) { render(); return; }
      settle(t.name as Key);
      syncOptions(get());
      render();
    });
    qty.addEventListener('input', () => render());
    form.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach((b) => b.addEventListener('click', () => {
      const n = (parseInt(qty.value, 10) || 0) + Number(b.dataset.qtyStep) * (Number(qty.value) >= 50 ? 10 : Number(qty.value) >= 20 ? 5 : 1);
      qty.value = String(Math.max(1, Math.min(10000, n)));
      render();
    }));
    reset.addEventListener('click', () => {
      radios('brand').forEach((r) => (r.checked = false));
      (['proc', 'gen', 'model', 'chip', 'ram', 'storage'] as Key[]).forEach((k) => set(k, ''));
      syncOptions(get());
      render();
      form.querySelector<HTMLInputElement>('input[name="brand"]')?.focus();
    });
    // "See matches" follows the catalogue link, so it opens exactly what that link shows.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      allEl.href = catalogueUrl(get());
      allEl.click();
    });
    qty.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); render(); } });

    let raf = 0;
    const relayout = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(geometry); };
    new ResizeObserver(relayout).observe(stage);
    wide.addEventListener('change', relayout);
    document.fonts?.ready.then(relayout);

    syncOptions(get());
    render();

    // The first time the builder comes into view, the screen switches on and a spark
    // runs down each cable to the laptop. Skipped if it is already in view.
    const r = stage.getBoundingClientRect();
    if (!reduced.matches && 'IntersectionObserver' in window && r.top > innerHeight * 0.75) {
      stage.dataset.boot = 'off';
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        stage.dataset.boot = 'on';
        if (!wide.matches) return;
        geometry();
        BOXES.forEach((id, i) => window.setTimeout(() => {
          const sp = cable[id].spark;
          sp.classList.remove('run');
          void sp.getBoundingClientRect();
          sp.classList.add('run');
        }, 120 + i * 140));
      }, { threshold: 0.35 });
      io.observe(lap);
    }
  });
</script>
