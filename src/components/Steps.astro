---
import Icon from './Icon.astro';
const steps = [
  { t: 'Tell us what you need', d: 'Devices, quantity, city, dates and any software. A form, a call or a WhatsApp message all work.', icon: 'clipboard-list' },
  { t: 'Get a tailored quote', d: 'We confirm configurations, availability and a monthly price for your exact requirement.', icon: 'receipt' },
  { t: 'We prepare every device', d: 'Machines are checked, imaged with your software, asset-tagged and packed per user or desk.', icon: 'package-check' },
  { t: 'Delivery, setup and support', d: 'Delivered to your office, replaced if anything fails, and collected when you are done.', icon: 'truck' },
];
---
<ol class="steps" role="list">
  {steps.map((s, i) => (
    <li>
      <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <span class="ic"><Icon name={s.icon} size={26} stroke={1.6} /></span>
      <h3 class="h3">{s.t}</h3>
      <p class="muted">{s.d}</p>
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; gap: var(--s-5); counter-reset: s; list-style: none; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, 1fr); gap: 0; } }
  .steps li { position: relative; padding: var(--s-5) var(--s-5) var(--s-6); border-top: 1px solid var(--line-strong); }
  @media (min-width: 1100px) { .steps li + li { border-left: 1px solid var(--line-strong); } }
  .n { display: block; margin-bottom: var(--s-6); color: var(--red-ink); }
  .ic { position: absolute; top: var(--s-5); right: var(--s-5); color: var(--ink-2); }
  .h3 { margin-bottom: var(--s-2); }
  .muted { font-size: var(--fs-small); }
</style>
