---
import Icon from './Icon.astro';
import ClientMarquee from './ClientMarquee.astro';
import { SITE, whatsappLink, enabledClaims } from '../config/site';

/** The pile: everything we rent, as physical-feeling chips. Hue = equipment family. */
const pile: { label: string; icon: string; hue: string; r: number; href: string }[] = [
  { label: 'Lenovo ThinkPads', icon: 'laptop', hue: 'ink', r: -6, href: '/laptop-rental/' },
  { label: 'Asset-tagged and labelled', icon: 'tag', hue: 'paper', r: 4, href: '/laptop-rental/' },
  { label: 'Rack servers', icon: 'server', hue: 'green', r: -3, href: '/server-rental/' },
  { label: 'MacBook Air and Pro', icon: 'laptop-minimal', hue: 'paper', r: 7, href: '/macbook-rental/' },
  { label: 'Desktops with monitors', icon: 'monitor', hue: 'blue', r: -9, href: '/desktop-rental/' },
  { label: 'Apple iMac', icon: 'monitor', hue: 'red', r: 5, href: '/macbook-rental/' },
  { label: 'Dell Latitudes', icon: 'laptop', hue: 'ink', r: 12, href: '/laptop-rental/' },
  { label: 'Windows and Office pre-installed', icon: 'package-check', hue: 'paper', r: -4, href: '/laptop-rental/' },
  { label: 'ThinkCentre desktops', icon: 'monitor-smartphone', hue: 'green', r: 8, href: '/desktop-rental/' },
  { label: 'Android and iPhone', icon: 'smartphone', hue: 'amber', r: -11, href: '/mobile-phone-rental/' },
  { label: 'HP EliteBooks', icon: 'laptop', hue: 'ink', r: 3, href: '/laptop-rental/' },
  { label: 'Routers and Wi-Fi', icon: 'router', hue: 'green', r: -7, href: '/router-rental/' },
  { label: 'Mini PCs', icon: 'cpu', hue: 'blue', r: 10, href: '/desktop-rental/' },
  { label: 'Replacement if one fails', icon: 'refresh-ccw', hue: 'red', r: -2, href: '/support/' },
  { label: '24" monitors', icon: 'monitor', hue: 'paper', r: 6, href: '/monitor-rental/' },
];

/**
 * Decorative icons from the Visual Asset Library (laptop set + hardware set),
 * scattered around the laptop like objects on a desk. side: which edge they hug,
 * x: px beyond that edge, y: % of laptop height, s: icon size, t: tile or bare.
 */
const floaters: { name: string; badge?: string; side: 'l' | 'r'; x: number; y: number; s: number; r: number; t?: boolean; d: number }[] = [
  { name: 'laptop-minimal', side: 'l', x: 150, y: 2, s: 30, r: -8, t: true, d: 0 },
  { name: 'wifi', side: 'l', x: 52, y: 17, s: 30, r: 6, d: 1.2 },
  { name: 'laptop', badge: 'check', side: 'l', x: 128, y: 30, s: 28, r: 5, t: true, d: 2.1 },
  { name: 'server', side: 'l', x: 48, y: 47, s: 32, r: -4, d: 0.6 },
  { name: 'laptop', badge: 'lock', side: 'l', x: 158, y: 60, s: 30, r: -10, t: true, d: 1.7 },
  { name: 'mouse', side: 'l', x: 62, y: 77, s: 26, r: 12, d: 2.6 },
  { name: 'laptop', badge: 'chart-column', side: 'l', x: 120, y: 92, s: 28, r: 7, t: true, d: 0.9 },
  { name: 'monitor', side: 'r', x: 140, y: 4, s: 30, r: 7, t: true, d: 0.4 },
  { name: 'laptop', badge: 'refresh-cw', side: 'r', x: 50, y: 19, s: 30, r: -6, d: 2.3 },
  { name: 'smartphone', side: 'r', x: 156, y: 33, s: 28, r: -9, t: true, d: 1.1 },
  { name: 'router', side: 'r', x: 58, y: 49, s: 32, r: 4, d: 0.2 },
  { name: 'laptop', badge: 'clock', side: 'r', x: 132, y: 62, s: 30, r: 8, t: true, d: 1.9 },
  { name: 'cloud-upload', side: 'r', x: 46, y: 79, s: 30, r: -5, d: 2.8 },
  { name: 'laptop', badge: 'map-pin', side: 'r', x: 150, y: 93, s: 28, r: -7, t: true, d: 0.7 },
];

const trust = enabledClaims(['zeroDeposit', 'noLockIn', 'fastDelivery', 'support247']);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
  <div class="laptop">
  <div class="floaters" aria-hidden="true">
    {floaters.map((f) => (
      <span
        class:list={['fl', f.t ? 'fl--tile' : 'fl--bare']}
        style={`${f.side === 'l' ? 'right' : 'left'}:calc(100% + ${f.x - (f.t ? 64 : f.s + 8)}px * var(--k)); top:${f.y}%; --r:${f.r}deg; --d:${f.d}s;${f.t ? '' : ` width:${f.s + 8}px; height:${f.s + 8}px;`}`}
      >
        <Icon name={f.name} badge={f.badge} size={f.t ? 34 : f.s + 8} stroke={1.5} />
      </span>
    ))}
  </div>
  <div class="lid">
  <span class="cam" aria-hidden="true"></span>
  <div class="screen grid-paper hero-inner">
    <p class="since"><span class="since-dot" aria-hidden="true"></span><span>Renting IT<span class="since-long"> to Indian businesses</span> since {SITE.founded}</span></p>
    <h1 id="hero-title" class="display">Equip ten people<br /> or a thousand.</h1>
    <p class="lead">
      Laptops, desktops, MacBooks, servers, networking and phones on rent across India.
      Configured before they ship. Supported until they come back.
    </p>
    <div class="ctas">
      <a href="/request-a-quote/" class="btn btn--primary btn--lg" data-track-location="hero">Get a quote</a>
      <a href={whatsappLink()} class="btn btn--lg btn--wa" target="_blank" rel="noopener" data-track-location="hero"><Icon name="whatsapp" />WhatsApp us</a>
      <a href="/equipment/" class="link-arrow">Explore equipment <Icon name="arrow-right" /></a>
    </div>
    {trust.length > 0 && (
      <ul class="trust" role="list">
        {trust.map((t) => <li><Icon name="check" size={18} stroke={2.5} />{t.short}</li>)}
      </ul>
    )}
  </div>
  </div>
  <div class="deck" aria-hidden="true"><span class="notch"></span></div>
  </div>
  </div>

  <div class="pile-wrap">
    <ul class="pile" role="list" aria-label="What you can rent">
      {pile.map((c, i) => (
        <li style={`--r:${c.r}deg; --i:${i}`}>
          <a href={c.href} class={`chip chip--${c.hue}`}><Icon name={c.icon} />{c.label}</a>
        </li>
      ))}
    </ul>
  </div>

  <ClientMarquee />
</section>

<style>
    .hero { position: relative; overflow: hidden; padding-top: clamp(24px, 4vw, 56px); border-bottom: 1.5px solid var(--ink); background: var(--paper-2); }
  .hero-inner { display: grid; justify-items: center; text-align: center; }

  /* The laptop */
  .laptop { position: relative; max-width: 1180px; margin: 0 auto; }
  @media (min-width: 1280px) { .laptop { max-width: 1080px; } }

  /* Library icons scattered around the laptop, behind everything */
  .floaters { position: absolute; inset: 0; pointer-events: none; z-index: 0; --icon-accent: var(--red-ink); --k: 1; }
  @media (max-width: 1439px) { .floaters { --k: .35; } }
  .fl :global(svg) { max-width: none; flex: none; }
  .lid, .deck { z-index: 1; }
  .fl { position: absolute; display: grid; place-items: center; transform: rotate(var(--r)); color: var(--ink-2); }
  .fl--tile {
    width: 64px; height: 64px; border-radius: 18px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    border: 1px solid var(--line-strong);
    box-shadow: 0 10px 24px -16px rgba(23,20,15,.45);
    opacity: .78;
  }
  .fl--bare { opacity: .5; }
  @media (prefers-reduced-motion: no-preference) {
    .fl { animation: drift 9s ease-in-out infinite alternate; animation-delay: calc(var(--d) * -1); }
    @keyframes drift {
      from { transform: translateY(-5px) rotate(var(--r)); }
      to { transform: translateY(6px) rotate(calc(var(--r) * -0.5)); }
    }
  }
  @media (max-width: 1099px) { .floaters { display: none; } }
  .lid {
    position: relative; width: 94%; margin: 0 auto;
    background: var(--ink); border-radius: 26px 26px 6px 6px;
    padding: clamp(8px, 1.6vw, 18px) clamp(8px, 1.6vw, 18px) clamp(10px, 2vw, 22px);
    box-shadow: 0 0 0 1.5px var(--ink), 0 40px 60px -40px rgba(23,20,15,.6);
  }
  .cam { position: absolute; top: clamp(2px, .6vw, 7px); left: 50%; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: #3a352e; box-shadow: inset 0 0 0 1.5px #4d473f; }
  .screen {
    border-radius: 12px 12px 2px 2px; background-color: var(--paper); overflow: hidden;
    padding: clamp(36px, 6vw, 80px) clamp(16px, 4vw, 56px) clamp(36px, 5vw, 64px);
  }
  .deck {
    position: relative; height: clamp(14px, 1.8vw, 22px); margin-top: -1px;
    background: linear-gradient(180deg, #E7DFD0 0%, #D3C8B5 55%, #B9AE9B 100%);
    border: 1.5px solid var(--ink); border-radius: 2px 2px 22px 22px / 2px 2px 14px 14px;
  }
  .notch { position: absolute; top: -1.5px; left: 50%; width: 16%; height: 45%; transform: translateX(-50%); background: #C8BCA8; border: 1.5px solid var(--ink); border-top: 0; border-radius: 0 0 10px 10px; }

  .since {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: var(--s-5);
    padding: 8px 16px; border-radius: var(--r-pill); background: var(--card); border: 1px solid var(--line);
    box-shadow: var(--shadow-soft); font-weight: 600; font-size: var(--fs-small);
  }
  .since-dot { width: 10px; height: 10px; border-radius: 3px; background: var(--red); box-shadow: 4px 4px 0 -1px var(--red-tint); }
  .display { max-width: 16ch; font-size: clamp(2.75rem, 1.2rem + 6.6vw, 7.5rem); }
  .lead { margin: var(--s-5) auto 0; color: var(--ink-2); max-width: 54ch; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-4) var(--s-5); margin-top: var(--s-6); }
  .trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; margin-top: var(--s-6); list-style: none; font-weight: 600; font-size: var(--fs-small); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { color: var(--green); }

  .pile-wrap { position: relative; margin-top: clamp(14px, 2.2vw, 30px); padding-inline: var(--gutter); z-index: 1; }
  .pile {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end;
    max-width: 1180px; margin: 0 auto; list-style: none; padding: 0 0 var(--s-7);
  }
  .pile li { margin: 0 -2px; transform: rotate(var(--r)); }
  .pile .chip {
    font-size: clamp(0.875rem, 0.8rem + 0.35vw, 1.0625rem); padding: 10px 18px 10px 14px;
    text-decoration: none; box-shadow: 0 2px 0 rgba(23,20,15,.25), 0 10px 18px -12px rgba(23,20,15,.6);
    transition: transform var(--t-fast) var(--ease-out);
  }
  .pile .chip:hover { transform: translateY(-4px) rotate(calc(var(--r) * -0.4)); text-decoration: none; }

  @media (prefers-reduced-motion: no-preference) {
    .pile li { animation: drop 800ms var(--ease-spring) both; animation-delay: calc(200ms + var(--i) * 40ms); }
    @keyframes drop {
      0% { transform: translateY(-110vh) rotate(calc(var(--r) * 3)); }
      100% { transform: translateY(0) rotate(var(--r)); }
    }
  }
  @media (max-width: 639px) {
    .since { font-size: var(--fs-xs); padding: 6px 12px; }
    .since-long { display: none; }
    .pile li:nth-child(n + 11) { display: none; }
    .pile li { margin: 0 -2px; }
  }
</style>
