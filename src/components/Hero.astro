---
import Icon from './Icon.astro';
import ClientMarquee from './ClientMarquee.astro';
import { SITE, whatsappLink, enabledClaims } from '../config/site';

/** What we rent, as a calm row of neutral pills. */
const rentables: { label: string; icon: string; href: string }[] = [
  { label: 'Lenovo ThinkPad', icon: 'laptop', href: '/laptop-rental/' },
  { label: 'Dell Latitude', icon: 'laptop', href: '/laptop-rental/' },
  { label: 'HP EliteBook', icon: 'laptop', href: '/laptop-rental/' },
  { label: 'MacBook Air and Pro', icon: 'laptop-minimal', href: '/macbook-rental/' },
  { label: 'Desktops and mini PCs', icon: 'monitor-smartphone', href: '/desktop-rental/' },
  { label: 'Monitors', icon: 'monitor', href: '/monitor-rental/' },
  { label: 'Rack servers', icon: 'server', href: '/server-rental/' },
  { label: 'Routers and Wi-Fi', icon: 'router', href: '/router-rental/' },
  { label: 'Android and iPhone', icon: 'smartphone', href: '/mobile-phone-rental/' },
];

/**
 * A field of thin library icons (laptop set + hardware set) around the laptop.
 * Positions come from a fixed seed so every build looks the same.
 */
const pool: [string, string?][] = [
  ['laptop'], ['laptop', 'check'], ['laptop', 'lock'], ['laptop', 'clock'], ['laptop', 'map-pin'], ['laptop', 'refresh-cw'],
  ['laptop', 'shield'], ['laptop', 'zap'], ['laptop', 'calendar'], ['laptop', 'headphones'], ['laptop', 'briefcase'], ['laptop', 'chart-column'],
  ['laptop-minimal'], ['monitor'], ['server'], ['smartphone'], ['tablet'], ['wifi'], ['router'], ['cloud-upload'], ['keyboard'],
  ['mouse'], ['webcam'], ['printer'], ['hard-drive'], ['usb'], ['ethernet-port'], ['plug-zap'], ['battery'], ['power'], ['cpu'], ['projector'],
];
let seed = 20130;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const floaters: { name: string; badge?: string; side: 'l' | 'r'; x: number; y: number; s: number; r: number; o: number; d: number }[] = [];
const cols = [34, 96, 158, 220]; // px out from the laptop edge
const rows = 9;
let k = 0;
for (const side of ['l', 'r'] as const) {
  for (let row = 0; row < rows; row++) {
    for (let c = 0; c < cols.length; c++) {
      if (rnd() < 0.28) continue; // gaps so it reads as scattered, not a grid
      const [name, badge] = pool[(k++ * 7 + row * 3 + c) % pool.length];
      floaters.push({
        name, badge, side,
        x: cols[c] + Math.round((rnd() - 0.5) * 30),
        y: Math.round(((row + 0.5) / rows) * 100 + (rnd() - 0.5) * 7),
        s: 20 + Math.round(rnd() * 12),
        r: Math.round((rnd() - 0.5) * 18),
        o: +(0.14 + rnd() * 0.2 - c * 0.02).toFixed(2),
        d: +(rnd() * 6).toFixed(1),
      });
    }
  }
}

const trust = enabledClaims(['zeroDeposit', 'noLockIn', 'fastDelivery', 'support247']);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="laptop">
      <div class="floaters" aria-hidden="true">
        {floaters.map((f) => (
          <span
            class="fl"
            style={`${f.side === 'l' ? 'right' : 'left'}:calc(100% + ${f.x - f.s}px * var(--k)); top:${f.y}%; width:${f.s}px; height:${f.s}px; --r:${f.r}deg; --o:${f.o}; --d:${f.d}s`}
          >
            <Icon name={f.name} badge={f.badge} size={f.s} stroke={1.25} />
          </span>
        ))}
      </div>

      <div class="lid">
        <span class="cam" aria-hidden="true"></span>
        <div class="screen hero-inner">
          <p class="since mono"><span class="since-dot" aria-hidden="true"></span><span>Renting IT<span class="since-long"> to Indian businesses</span> since {SITE.founded}</span></p>
          <h1 id="hero-title" class="display">Equip ten people<br /> or a thousand.</h1>
          <p class="lead">
            Laptops, desktops, MacBooks, servers, networking and phones on rent across India.
            Configured before they ship. Supported until they come back.
          </p>
          <div class="ctas">
            <a href="/request-a-quote/" class="btn btn--primary btn--lg" data-track-location="hero">Get a quote</a>
            <a href={whatsappLink()} class="btn btn--lg btn--wa" target="_blank" rel="noopener" data-track-location="hero"><Icon name="whatsapp" />WhatsApp us</a>
          </div>
          {trust.length > 0 && (
            <ul class="trust" role="list">
              {trust.map((t) => <li><Icon name="check" size={15} stroke={2} />{t.short}</li>)}
            </ul>
          )}
        </div>
      </div>
      <div class="deck" aria-hidden="true"><span class="notch"></span></div>
    </div>

    <nav class="rentables" aria-label="What you can rent">
      <ul role="list">
        {rentables.map((c) => <li><a href={c.href} class="pill"><Icon name={c.icon} size={15} />{c.label}</a></li>)}
      </ul>
      <a class="link-arrow explore" href="/equipment/">Explore the full catalogue <Icon name="arrow-right" /></a>
    </nav>
  </div>

  <ClientMarquee tone="dark" />
</section>

<style>
  .hero {
    position: relative; overflow: hidden; color: var(--on-dark);
    /* extend up under the floating header */
    margin-top: -80px;
    padding-top: calc(80px + clamp(28px, 4vw, 56px));
    background:
      radial-gradient(60% 45% at 50% 38%, rgba(122, 32, 24, .38) 0%, transparent 70%),
      radial-gradient(90% 60% at 50% 110%, rgba(58, 21, 18, .7) 0%, transparent 70%),
      var(--night);
  }
  /* fine dot texture for depth */
  .glow {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(243,238,229,.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(80% 70% at 50% 40%, #000 30%, transparent 85%);
  }
  .hero-inner { display: grid; justify-items: center; text-align: center; }

  /* The laptop */
  .laptop { position: relative; max-width: 1160px; margin: 0 auto; }
  @media (min-width: 1280px) { .laptop { max-width: 1040px; } }
  .lid {
    position: relative; z-index: 1; width: 94%; margin: 0 auto;
    background: linear-gradient(180deg, #0c0a09, #050404);
    border-radius: 22px 22px 6px 6px;
    padding: clamp(8px, 1.4vw, 16px) clamp(8px, 1.4vw, 16px) clamp(10px, 1.8vw, 20px);
    box-shadow:
      inset 0 0 0 1px rgba(243,238,229,.10),
      0 0 0 1px rgba(0,0,0,.6),
      0 50px 120px -30px rgba(0,0,0,.9),
      0 0 140px -20px rgba(185,41,30,.25);
  }
  .cam { position: absolute; top: clamp(2px, .55vw, 6px); left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #2a2622; box-shadow: inset 0 0 0 1px #3d3832; }
  .screen {
    color: var(--ink);
    border-radius: 10px 10px 2px 2px; overflow: hidden;
    background: radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
    padding: clamp(36px, 5.5vw, 76px) clamp(16px, 4vw, 56px) clamp(32px, 4.5vw, 56px);
  }
  .deck {
    position: relative; z-index: 1; height: clamp(12px, 1.5vw, 18px); margin-top: -1px;
    background: linear-gradient(180deg, #d6cfc3 0%, #b2aa9d 45%, #7d766c 100%);
    border-radius: 2px 2px 20px 20px / 2px 2px 12px 12px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 18px 30px -12px rgba(0,0,0,.8);
  }
  .notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, #9d9588, #b9b1a4); border-radius: 0 0 9px 9px; }

  .since {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: var(--s-6);
    padding: 7px 14px; border-radius: var(--r-pill); border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .since-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px rgba(224,51,40,.15); }
  .display { max-width: 16ch; font-size: clamp(2.6rem, 1.1rem + 5.6vw, 6.25rem); }
  .lead { margin: var(--s-5) auto 0; max-width: 52ch; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-3); margin-top: var(--s-6); }
  .trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; margin-top: var(--s-6); list-style: none; font-size: var(--fs-xs); color: var(--ink-2); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { color: var(--red-ink); }

  /* Icon field */
  .floaters { position: absolute; inset: 0; pointer-events: none; z-index: 0; --k: 1; --icon-accent: var(--red-soft); }
  @media (max-width: 1439px) { .floaters { --k: .55; } }
  .fl { position: absolute; display: grid; place-items: center; color: var(--on-dark); opacity: var(--o); transform: rotate(var(--r)); }
  .fl :global(svg) { max-width: none; flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .fl { animation: drift 11s ease-in-out infinite alternate; animation-delay: calc(var(--d) * -1); }
    @keyframes drift {
      from { transform: translateY(-4px) rotate(var(--r)); }
      to { transform: translateY(5px) rotate(calc(var(--r) * -0.4)); }
    }
  }
  @media (max-width: 1099px) { .floaters { display: none; } }

  /* What we rent */
  .rentables { display: grid; justify-items: center; gap: var(--s-4); padding: clamp(36px, 5vw, 56px) 0 clamp(40px, 5vw, 64px); position: relative; z-index: 1; }
  .rentables ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; max-width: 980px; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: var(--r-pill);
    border: 1px solid var(--hair-dark); background: rgba(243,238,229,.03);
    color: var(--on-dark-2); font-size: .875rem; text-decoration: none; white-space: nowrap;
    transition: border-color var(--t-fast), color var(--t-fast), background var(--t-fast);
  }
  .pill:hover { border-color: var(--hair-dark-strong); color: var(--on-dark); background: rgba(243,238,229,.06); }
  .explore { color: var(--on-dark); font-size: var(--fs-small); }

  @media (max-width: 639px) {
    .since { font-size: .6875rem; padding: 6px 12px; }
    .since-long { display: none; }
    .rentables li:nth-child(n + 7) { display: none; }
  }
</style>
