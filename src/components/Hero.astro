---
/**
 * Home page opening screen, on the dark wine page colour: the laptop with the IT Rentals screen
 * (headline, quote and WhatsApp buttons, our promises), the line above it with
 * library icons on either side, and the four laptop brands we rent as links
 * underneath.
 *
 * Scrolling zooms into the laptop until its screen fills the window, and the
 * next page, "Describe your need, or build your own" (LaptopCurator), rises
 * over it like a sheet. The zoom is run by scenes.ts (`hero`);
 * without it (reduced motion, no script, short windows) the page simply follows.
 */
import Icon from './Icon.astro';
import { SITE, whatsappLink, enabledClaims } from '../config/site';
import { PRODUCTS } from '../data/products';
import { BRAND_MARKS } from '../data/brand-marks';
import iconNodes from 'lucide-static/icon-nodes.json';

const laptopsBy = (brand: string) => PRODUCTS.filter((p) => p.category === 'laptops' && p.brand === brand).length;
const brands: { id: 'apple' | 'dell' | 'hp' | 'lenovo'; label: string; href: string }[] = [
  { id: 'apple', label: 'MacBooks', href: '/equipment/?category=macbooks&brand=Apple&q=macbook' },
  { id: 'dell', label: `${laptopsBy('Dell')} Dell laptops`, href: '/equipment/?category=laptops&brand=Dell' },
  { id: 'hp', label: `${laptopsBy('HP')} HP laptops`, href: '/equipment/?category=laptops&brand=HP' },
  { id: 'lenovo', label: `${laptopsBy('Lenovo')} ThinkPads`, href: '/equipment/?category=laptops&brand=Lenovo' },
];
const markBox = (id: 'apple' | 'dell' | 'hp' | 'lenovo') => (id === 'lenovo' ? '0 8 24 8.01' : '0 0 24 24');

/**
 * Thin library icons (laptop set + hardware set) around the laptop and around
 * the line above it. Each field is a container as wide as the free space;
 * columns that would not fit are hidden by container queries. Icons are drawn
 * from one SVG sprite to keep the page light; positions come from a fixed seed
 * so every build looks the same.
 */
const pool: [string, string?][] = [
  ['laptop'], ['laptop', 'check'], ['laptop', 'lock'], ['laptop', 'clock'], ['laptop', 'map-pin'], ['laptop', 'refresh-cw'],
  ['laptop', 'shield'], ['laptop', 'zap'], ['laptop', 'calendar'], ['laptop', 'headphones'], ['laptop', 'briefcase'], ['laptop', 'chart-column'],
  ['laptop-minimal'], ['monitor'], ['server'], ['smartphone'], ['tablet'], ['wifi'], ['router'], ['cloud-upload'], ['keyboard'],
  ['mouse'], ['webcam'], ['printer'], ['hard-drive'], ['usb'], ['ethernet-port'], ['plug-zap'], ['battery'], ['power'], ['cpu'], ['projector'],
];
const nodes = iconNodes as unknown as Record<string, [string, Record<string, string>][]>;
const draw = (n: string) => nodes[n].map(([tag, a]) => `<${tag} ${Object.entries(a).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`).join('');
const sprite = pool.map(([name, badge], i) => `<symbol id="hf-${i}" viewBox="0 0 24 24">${badge
  ? `<g mask="url(#hf-cut)">${draw(name)}</g><svg x="13" y="13" width="11" height="11" viewBox="0 0 24 24" style="stroke:var(--icon-accent)" stroke-width="2.6">${draw(badge)}</svg>`
  : draw(name)}</symbol>`).join('');

let seed = 20130;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
type Floater = { icon: number; c: number; x: number; y: number; s: number; r: number; o: number; d: number; z: number };
let k = 0;
/** One field of icons: `rows` x up to `cols` columns, `gap` chance of leaving a cell empty. */
function field(rows: number, cols: number, yFrom: number, ySpan: number, gap: number) {
  const out: Floater[] = [];
  for (let row = 0; row < rows; row++) {
    for (let c = 0; c < cols; c++) {
      if (rnd() < gap) continue; // gaps so it reads as scattered, not a grid
      out.push({
        icon: (k++ * 7 + row * 3 + c) % pool.length, c,
        x: 24 + Math.round((rnd() - 0.5) * 24),
        y: +(yFrom + ((row + 0.5) / rows) * ySpan + (rnd() - 0.5) * (ySpan / rows) * 0.35).toFixed(1),
        s: 18 + Math.round(rnd() * 12),
        r: Math.round((rnd() - 0.5) * 18),
        o: +(0.15 + rnd() * 0.19 - Math.min(c, 6) * 0.01).toFixed(2),
        d: +(rnd() * 6).toFixed(1),
        z: +(0.35 + c * 0.1 + rnd() * 0.25).toFixed(2),
      });
    }
  }
  return out;
}
/** Beside the line above the laptop (2 rows). */
const cols7 = (f: Floater[]) => f.filter((x) => x.c < 7); // wider columns only show on very wide screens
const pockets = { l: cols7(field(2, 10, 8, 84, 0.2)), r: cols7(field(2, 10, 8, 84, 0.2)) };
const flStyle = (side: 'l' | 'r', f: Floater) =>
  `${side === 'l' ? 'right' : 'left'}:calc(${f.x}px + ${f.c} * var(--sp)); top:${f.y}%; --r:${f.r}deg; --o:${f.o}`;

/** The laptops either side of the main one (decorative: brands we rent). */
const ghosts: { side: 'l' | 'r'; id: 'lenovo' | 'apple'; name: string }[] = [
  { side: 'l', id: 'lenovo', name: 'ThinkPad' },
  { side: 'r', id: 'apple', name: 'MacBook' },
];

const trust = enabledClaims(['zeroDeposit', 'noLockIn', 'fastDelivery', 'support247']);
---
<section class="hero" data-scene="hero" aria-labelledby="hero-title">
  <div class="stage">
  <div class="glow" aria-hidden="true"></div>
  <svg class="sprite" width="0" height="0" focusable="false" aria-hidden="true">
    <defs>
      <mask id="hf-cut"><rect width="24" height="24" fill="#fff" /><circle cx="18.5" cy="18.5" r="6.4" fill="#000" /></mask>
      <Fragment set:html={sprite} />
    </defs>
  </svg>

  <div class="topline" data-fade data-at="0">
    {(['l', 'r'] as const).map((side) => (
      <span class={`pocket pocket--${side}`} aria-hidden="true">
        {pockets[side].map((f) => (
          <span class={`fl c${f.c}`} style={flStyle(side, f)}>
            <svg width={f.s} height={f.s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><use href={`#hf-${f.icon}`} /></svg>
          </span>
        ))}
      </span>
    ))}
    <p class="kicker">Rent the laptops your team already knows.</p>
  </div>

  <div class="device" data-device>
    <!-- a laptop on either side, cut off by the edge of the window -->
    {ghosts.map((g) => (
      <div class={`ghost ghost--${g.side}`} aria-hidden="true" data-fade>
        <div class="g-lid">
          <div class="g-screen">
            <div class="g-card">
              <svg class={`g-mark g-mark--${g.id}`} viewBox={markBox(g.id)} focusable="false">
                {g.id === 'lenovo' ? <><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></> : <path d={BRAND_MARKS[g.id]} fill="currentColor" />}
              </svg>
              <span class="g-name">{g.name}</span>
              <span class="g-lines"><i></i><i></i><i></i></span>
            </div>
          </div>
        </div>
        <div class="g-deck"><span class="g-notch"></span></div>
      </div>
    ))}

    <div class="laptop">
      <div class="lid">
        <span class="cam" aria-hidden="true"></span>
        <div class="screen" data-screen>
          <div class="desk" data-fit-desk data-desk data-at="0">
            <p class="since"><span class="since-dot" aria-hidden="true"></span><span>Renting IT<span class="since-long"> to Indian businesses</span> since {SITE.founded}</span></p>
            <h1 id="hero-title" class="headline">
              <span class="hl-brand">IT Rentals</span><span class="sr-only">: </span>
              <span class="hl-line">One-stop solution for all your renting needs</span>
            </h1>
            <p class="lead">
              Laptops, MacBooks, desktops, servers, networking and phones for teams of ten or a thousand.
              Configured before they ship, supported until they come back.
            </p>
            <div class="ctas">
              <a href="/request-a-quote/" class="btn btn--primary btn--lg" data-track-location="hero">Get a quote</a>
              <a href={whatsappLink()} class="btn btn--lg btn--wa" target="_blank" rel="noopener" data-track-location="hero"><Icon name="whatsapp" />WhatsApp us</a>
            </div>
            {trust.length > 0 && (
              <ul class="trust" role="list">
                {trust.map((t) => <li><Icon name="check" size={15} stroke={2} />{t.short}</li>)}
              </ul>
            )}
          </div>
          <span class="glass" aria-hidden="true"></span>
        </div>
      </div>
      <div class="deck" aria-hidden="true"><span class="notch"></span></div>
      <span class="floor" aria-hidden="true"></span>
    </div>
  </div>

  <nav class="brands" aria-label="Laptop brands we rent" data-fade data-at="0">
    <ul role="list">
      {brands.map((b) => (
        <li>
          <a href={b.href} data-track-location={`hero-${b.id}`}>
            <svg class={`bmark bmark--${b.id}`} viewBox={markBox(b.id)} aria-hidden="true" focusable="false">
              {b.id === 'lenovo' ? <><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></> : <path d={BRAND_MARKS[b.id]} fill="currentColor" />}
            </svg>
            <span>Browse {b.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <a class="next" href="#build" data-fade data-at="0" data-to-describe><span>Describe your need, or build your own</span><Icon name="arrow-down" size={16} /></a>
  </div>
</section>

<style>
  /* Dark wine opening screen, with a warm light behind the laptop */
  .hero {
    position: relative; color: var(--on-dark);
    /* extend up under the floating header */
    margin-top: -80px;
    --lw: min(1000px, 86vw, calc((100svh - 330px) * 1.52));
  }
  .stage {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; align-content: safe center; row-gap: clamp(14px, 2.2vh, 24px);
    padding: calc(80px + clamp(28px, 4vh, 48px)) var(--gutter) clamp(28px, 4vh, 44px);
    background:
      radial-gradient(60% 45% at 50% 38%, rgba(122, 32, 24, .38) 0%, transparent 70%),
      radial-gradient(90% 60% at 50% 110%, rgba(58, 21, 18, .7) 0%, transparent 70%),
      var(--night);
  }
  /* fine dot texture, strongest round the laptop */
  .glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(rgba(243, 238, 229, .07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 60% at 50% 48%, #000 30%, transparent 85%);
  }
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* The line above the laptop, with icons either side */
  .topline { position: relative; width: min(820px, 100%); text-align: center; }
  .kicker {
    margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.25rem, .95rem + 1.2vw, 2rem);
    line-height: 1.15; letter-spacing: -0.015em; text-wrap: balance;
  }
  .pocket { position: absolute; top: -34px; bottom: -14px; width: max(0px, calc((100vw - 100%) / 2 - 16px)); container-type: inline-size; pointer-events: none; }
  .pocket--l { right: calc(100% - 6px); }
  .pocket--r { left: calc(100% - 6px); }

  /* Icon field */
  .pocket { --icon-accent: var(--red-soft); }
  .fl {
    position: absolute; display: none; color: var(--on-dark); opacity: var(--o);
    --sp: max(46px, (100cqi - 40px) / 10);
    transform: rotate(var(--r));
  }
  .fl svg { display: block; max-width: none; flex: none; }
  @container (min-width: 74px) { .c0 { display: block; } }
  @container (min-width: 120px) { .c1 { display: block; } }
  @container (min-width: 166px) { .c2 { display: block; } }
  @container (min-width: 212px) { .c3 { display: block; } }
  @container (min-width: 258px) { .c4 { display: block; } }
  @container (min-width: 304px) { .c5 { display: block; } }
  @container (min-width: 350px) { .c6 { display: block; } }
  @media (max-width: 1099px) { .pocket { display: none; } }

  /* ── The laptops either side: same build as the main one, cut off by the window ── */
  .ghost { position: absolute; top: 0; width: 100%; z-index: 0; pointer-events: none; --gap: clamp(40px, 5vw, 88px); }
  .ghost--l { right: calc(100% + var(--gap)); }
  .ghost--r { left: calc(100% + var(--gap)); }
  .g-lid {
    position: relative; width: 94%; margin: 0 auto;
    padding: calc(var(--lw) * .013) calc(var(--lw) * .013) calc(var(--lw) * .022);
    background: linear-gradient(180deg, #0c0a09, #050404);
    border-radius: calc(var(--lw) * .024) calc(var(--lw) * .024) calc(var(--lw) * .007) calc(var(--lw) * .007);
    box-shadow: inset 0 0 0 1px rgba(243, 238, 229, .08), 0 0 0 1px rgba(0, 0, 0, .6), 0 50px 120px -30px rgba(0, 0, 0, .9);
    transform-origin: 50% 100%;
  }
  .g-screen {
    position: relative; aspect-ratio: 16 / 10.4; overflow: hidden; display: grid; align-items: center;
    padding: 0 7%; border-radius: calc(var(--lw) * .011) calc(var(--lw) * .011) 2px 2px; color: var(--ink);
    background: #EDE6DA radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
  }
  /* they recede: darker towards the outer edge of the window */
  .g-screen::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18, 14, 13, .12), rgba(18, 14, 13, .55)); }
  .ghost--l .g-screen::after { transform: scaleX(-1); }
  .ghost--l .g-screen { justify-items: end; }
  .ghost--r .g-screen { justify-items: start; }
  .g-card { display: grid; gap: calc(var(--lw) * .014); justify-items: start; }
  .ghost--l .g-card { justify-items: end; text-align: right; }
  .g-mark { display: block; color: var(--ink); }
  .g-mark--apple { width: calc(var(--lw) * .05); height: calc(var(--lw) * .06); }
  .g-mark--lenovo { width: calc(var(--lw) * .13); height: calc(var(--lw) * .044); }
  .g-name { font-family: var(--font-display); font-size: calc(var(--lw) * .07); line-height: 1; letter-spacing: -0.03em; }
  .g-lines { display: grid; gap: calc(var(--lw) * .01); justify-items: inherit; }
  .g-lines i { display: block; height: calc(var(--lw) * .008); border-radius: 99px; background: rgba(23, 19, 15, .14); }
  .g-lines i:nth-child(1) { width: calc(var(--lw) * .24); }
  .g-lines i:nth-child(2) { width: calc(var(--lw) * .18); }
  .g-lines i:nth-child(3) { width: calc(var(--lw) * .12); background: rgba(185, 41, 30, .35); }
  .g-deck {
    position: relative; height: max(10px, calc(var(--lw) * .018)); margin-top: -1px;
    background: linear-gradient(180deg, #b9b2a6 0%, #948d81 45%, #625c54 100%);
    border-radius: 2px 2px 20px 20px / 2px 2px 12px 12px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 18px 30px -12px rgba(0,0,0,.8);
  }
  .g-notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, #7f786d, #9d968a); border-radius: 0 0 9px 9px; }
  /* only where there is room for a visible slice */
  @media (max-width: 1099px) { .ghost { display: none; } }

  /* ── The laptop: black body, cream IT Rentals screen ── */
  .device { position: relative; z-index: 1; width: var(--lw); }
  .laptop { position: relative; z-index: 1; }
  .lid {
    position: relative; z-index: 1; width: 94%; margin: 0 auto;
    padding: calc(var(--lw) * .013) calc(var(--lw) * .013) calc(var(--lw) * .022);
    background: linear-gradient(180deg, #0c0a09, #050404);
    border-radius: calc(var(--lw) * .024) calc(var(--lw) * .024) calc(var(--lw) * .007) calc(var(--lw) * .007);
    box-shadow:
      inset 0 0 0 1px rgba(243, 238, 229, .10),
      0 0 0 1px rgba(0, 0, 0, .6),
      0 50px 120px -30px rgba(0, 0, 0, .9),
      0 0 140px -20px rgba(185, 41, 30, .25);
    transform-origin: 50% 100%;
  }
  .cam { position: absolute; top: calc(var(--lw) * .0065); left: 50%; width: max(3px, calc(var(--lw) * .006)); height: max(3px, calc(var(--lw) * .006)); translate: -50% -50%; border-radius: 50%; background: #2a2622; box-shadow: inset 0 0 0 1px #3d3832; z-index: 2; }
  .screen {
    position: relative; container-type: inline-size; color: var(--ink); aspect-ratio: 16 / 10.4;
    display: grid; align-content: safe center; overflow: hidden;
    border-radius: calc(var(--lw) * .011) calc(var(--lw) * .011) 2px 2px;
    background: #EDE6DA radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
  }
  .screen:has(> .desk[data-fit='4']) { overflow-y: auto; }
  /* a soft reflection on the glass */
  .glass { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, rgba(255,255,255,.22) 0%, rgba(255,255,255,0) 32%); mix-blend-mode: soft-light; }
  .deck {
    position: relative; z-index: 1; height: max(10px, calc(var(--lw) * .018)); margin-top: -1px;
    background: linear-gradient(180deg, #d6cfc3 0%, #b2aa9d 45%, #7d766c 100%);
    border-radius: 2px 2px 20px 20px / 2px 2px 12px 12px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 18px 30px -12px rgba(0,0,0,.8);
  }
  .notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, #9d9588, #b9b1a4); border-radius: 0 0 9px 9px; }
  .floor { position: absolute; left: 4%; right: 4%; bottom: calc(var(--lw) * -.035); height: calc(var(--lw) * .06); border-radius: 50%; background: radial-gradient(closest-side, rgba(0, 0, 0, .6), rgba(0, 0, 0, 0)); z-index: 0; }

  /* The IT Rentals screen */
  .desk {
    display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center;
    padding: clamp(24px, 5cqi, 64px) clamp(16px, 5cqi, 56px);
  }
  .since {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 clamp(14px, 2.6cqi, 28px);
    padding: 6px 14px; border-radius: var(--r-pill); border: 1px solid var(--line-strong);
    color: var(--ink-2); font-size: clamp(.6875rem, 1.3cqi, .875rem); font-weight: 500;
  }
  .since-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px rgba(224,51,40,.15); }
  .headline { display: grid; justify-items: center; gap: clamp(6px, 1.2cqi, 14px); margin: 0; font-family: var(--font-display); font-weight: 400; font-optical-sizing: auto; }
  .hl-brand { font-size: clamp(2.6rem, 12cqi, 7.75rem); line-height: .88; letter-spacing: -0.035em; }
  .hl-line { font-size: clamp(1.25rem, 4.3cqi, 2.9rem); line-height: 1.08; letter-spacing: -0.02em; max-width: 21ch; color: var(--ink); text-wrap: balance; }
  .lead { margin: clamp(12px, 2.2cqi, 24px) auto 0; max-width: 56ch; font-size: clamp(.875rem, 1.75cqi, 1.125rem); line-height: 1.55; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-3); margin-top: clamp(14px, 2.8cqi, 30px); }
  .trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; margin: clamp(12px, 2.4cqi, 26px) 0 0; padding: 0; list-style: none; font-size: var(--fs-xs); color: var(--ink-2); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { color: var(--red-ink); }
  /* When the screen's words do not fit (short windows, large text), drop the extras in turn */
  .desk:is([data-fit='1'], [data-fit='2'], [data-fit='3'], [data-fit='4']) .lead { display: none; }
  .desk:is([data-fit='2'], [data-fit='3'], [data-fit='4']) .trust { display: none; }
  .desk:is([data-fit='3'], [data-fit='4']) :is(.since, .btn--wa) { display: none; }
  .since-long { display: none; }
  @media (min-width: 1100px) { .since-long { display: inline; } }

  /* Brands we rent */
  .brands { margin-top: clamp(14px, 2.4vh, 26px); }
  .brands ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 26px; margin: 0; padding: 0; list-style: none; }
  .brands a { display: inline-flex; align-items: center; gap: 10px; min-height: 32px; color: var(--on-dark); font-weight: 600; text-decoration: none; }
  .brands a span { border-bottom: 1px solid rgba(243, 238, 229, .32); padding-bottom: 2px; transition: border-color var(--t-fast); }
  .brands a:hover span { border-color: var(--on-dark); }
  .brands a:focus-visible, .next:focus-visible { outline: 3px solid var(--red-soft); outline-offset: 4px; border-radius: 4px; }
  .bmark { flex: none; width: 20px; height: 20px; color: var(--on-dark); }
  .bmark--lenovo { width: 46px; height: 16px; }

  .next {
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px;
    border-radius: var(--r-pill); border: 1px solid rgba(243, 238, 229, .28); background: rgba(243, 238, 229, .08); color: var(--on-dark);
    font-size: var(--fs-small); font-weight: 600; text-decoration: none; transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .next { margin-top: clamp(4px, 1vh, 12px); }
  .next:hover { border-color: var(--red-soft); background: rgba(224, 51, 40, .16); }

  /*
   * The full version: the first screen stays put while the page scrolls, and the
   * laptop grows until its screen fills the window (scenes.ts sets the transforms).
   * The next section then rises over it like a sheet.
   */
  @media (min-height: 560px) {
    :global(html.scenes) .hero { height: 210vh; height: 210svh; }
    :global(html.scenes) .stage { position: sticky; top: 0; height: 100vh; height: 100svh; min-height: 0; }
    :global(html.scenes) .device { will-change: transform; }
    /* their own layers, so fading them does not repaint the growing laptop */
    :global(html.scenes) :is(.topline, .ghost, .brands, .next) { will-change: opacity; }
    /* the screen's words grow with the laptop: drawn once and scaled, not redrawn at every step */
    :global(html.scenes) .desk { will-change: transform, opacity; }
    /* a plain reflection (a blend mode would be recomputed on every frame of the zoom) */
    :global(html.scenes) .glass { mix-blend-mode: normal; opacity: .35; }
  }

  /* The lid opens when the page loads (the headline is painted from the first frame) */
  @media (prefers-reduced-motion: no-preference) {
    .lid { animation: lid-open .9s cubic-bezier(.2, .75, .2, 1) .05s backwards; }
    .g-lid { animation: lid-open 1s cubic-bezier(.2, .75, .2, 1) .25s backwards; }
    @keyframes lid-open { from { transform: perspective(1500px) rotateX(-70deg); } to { transform: perspective(1500px) rotateX(0deg); } }
    .next :global(svg) { animation: nudge-down 2.4s ease-in-out 1.2s 3; }
    @keyframes nudge-down { 50% { transform: translateY(3px); } }
  }

  /* Phones and narrow tablets: a taller screen */
  @media (max-width: 760px) {
    .hero { --lw: min(92vw, max(270px, calc((100svh - 400px) * .78))); }
    .stage { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)); }
    .screen { aspect-ratio: 3 / 4; }
    .desk { padding: 6cqi 5cqi; }
    .hl-brand { font-size: clamp(2.4rem, 14cqi, 4rem); }
    .hl-line { font-size: clamp(1.15rem, 6.6cqi, 1.75rem); }
    .lead { font-size: .875rem; }
    .ctas .btn { min-height: 44px; padding: 10px 16px; font-size: .9375rem; }
    .trust { gap: 4px 14px; }
    .kicker { font-size: 1.125rem; }
    .brands ul { gap: 8px 18px; }
    .brands a { font-size: .875rem; }
  }
  @media (forced-colors: active) { .lid { border: 1px solid CanvasText; } }
</style>

<script>
  // The laptop screen has a fixed shape. Where its words do not fit (short windows,
  // large text), drop the extras one level at a time; at the last level the screen scrolls.
  const desks = [...document.querySelectorAll<HTMLElement>('.hero [data-fit-desk]')];
  let fitRaf = 0;
  const fit = () => {
    cancelAnimationFrame(fitRaf);
    fitRaf = requestAnimationFrame(() => {
      for (const d of desks) {
        const screen = d.parentElement!;
        let level = 0;
        d.removeAttribute('data-fit');
        while (level < 4 && d.offsetHeight > screen.clientHeight + 1) d.dataset.fit = String(++level);
      }
    });
  };
  if (desks.length) {
    const ro = new ResizeObserver(fit);
    desks.forEach((d) => { ro.observe(d.parentElement!); ro.observe(d); });
    document.fonts?.ready.then(fit);
  }

</script>
