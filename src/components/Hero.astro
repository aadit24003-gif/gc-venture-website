---
/**
 * Home page opening scene: one laptop, four brands.
 *
 * The page opens on the laptop showing the IT Rentals screen. While the stage
 * is pinned, scrolling turns the laptop around, 180 degrees at a time, to show
 * the back of the lid of each brand we rent (Apple, Dell, HP, Lenovo) with a
 * link to that brand's catalogue underneath, then turns it once more to a
 * then carries it, still turning, down to its place beside the builder on the
 * next part of the page (LaptopCurator, #build), where its screen shows the
 * choices made there.
 *
 * The laptop is two faces on one slab (see src/scripts/scenes.ts): face A holds
 * stops 0, 2 and 4, face B stops 1, 3 and 5, and a face only changes stop while
 * it points away from the visitor. At every stop the laptop rests dead straight.
 *
 * Without scroll scenes (reduced motion, no JavaScript, very short screens) the
 * laptop shows the IT Rentals screen and the four brands sit underneath as links.
 */
import Icon from './Icon.astro';
import { SITE, whatsappLink, enabledClaims } from '../config/site';
import { PRODUCTS } from '../data/products';
import { BRAND_MARKS } from '../data/brand-marks';
import iconNodes from 'lucide-static/icon-nodes.json';

const laptopsBy = (brand: string) => PRODUCTS.filter((p) => p.category === 'laptops' && p.brand === brand).length;

/**
 * The tour, in scroll order. `at` is where each stop rests (scroll progress
 * 0 to 1); keep in step with STOP_AT and FLIPS in src/scripts/scenes.ts.
 */
type Stop = { id: string; name: string; at: number; caption: string; cta?: string; href?: string; mark?: 'apple' | 'dell' | 'hp' | 'lenovo' };
const range = `6th Gen Core i5 to Core Ultra 9`;
const stops: Stop[] = [
  { id: 'itr', name: 'IT Rentals', at: 0, caption: 'Scroll to turn the laptop and see the brands we rent' },
  { id: 'apple', name: 'Apple', at: 0.175, mark: 'apple', caption: 'MacBook Air and MacBook Pro, from the 2019 Intel models to M5', cta: 'Browse MacBooks', href: '/equipment/?category=macbooks&brand=Apple&q=macbook' },
  { id: 'dell', name: 'Dell', at: 0.375, mark: 'dell', caption: `${laptopsBy('Dell')} Dell Latitude models, ${range}`, cta: `Browse ${laptopsBy('Dell')} Dell laptops`, href: '/equipment/?category=laptops&brand=Dell' },
  { id: 'hp', name: 'HP', at: 0.575, mark: 'hp', caption: `${laptopsBy('HP')} HP EliteBook and ProBook models, ${range}`, cta: `Browse ${laptopsBy('HP')} HP laptops`, href: '/equipment/?category=laptops&brand=HP' },
  { id: 'lenovo', name: 'Lenovo', at: 0.775, mark: 'lenovo', caption: `${laptopsBy('Lenovo')} Lenovo ThinkPad models, ${range}`, cta: `Browse ${laptopsBy('Lenovo')} ThinkPads`, href: '/equipment/?category=laptops&brand=Lenovo' },
  { id: 'build', name: 'Build your own', at: 1, caption: `Apple, Dell, HP and Lenovo from one rental partner, since ${SITE.founded}` },
];

/**
 * Thin library icons (laptop set + hardware set) around the laptop and around
 * the line above it. Each field is a container as wide as the free space;
 * columns that would not fit are hidden by container queries. Icons are drawn
 * from one SVG sprite to keep the page light; positions come from a fixed seed
 * so every build looks the same.
 */
const pool: [string, string?][] = [
  ['laptop'], ['laptop', 'check'], ['laptop', 'lock'], ['laptop', 'clock'], ['laptop', 'map-pin'], ['laptop', 'refresh-cw'],
  ['laptop', 'shield'], ['laptop', 'zap'], ['laptop', 'calendar'], ['laptop', 'headphones'], ['laptop', 'briefcase'], ['laptop', 'chart-column'],
  ['laptop-minimal'], ['monitor'], ['server'], ['smartphone'], ['tablet'], ['wifi'], ['router'], ['cloud-upload'], ['keyboard'],
  ['mouse'], ['webcam'], ['printer'], ['hard-drive'], ['usb'], ['ethernet-port'], ['plug-zap'], ['battery'], ['power'], ['cpu'], ['projector'],
];
const nodes = iconNodes as unknown as Record<string, [string, Record<string, string>][]>;
const draw = (n: string) => nodes[n].map(([tag, a]) => `<${tag} ${Object.entries(a).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`).join('');
const sprite = pool.map(([name, badge], i) => `<symbol id="hf-${i}" viewBox="0 0 24 24">${badge
  ? `<g mask="url(#hf-cut)">${draw(name)}</g><svg x="13" y="13" width="11" height="11" viewBox="0 0 24 24" style="stroke:var(--icon-accent)" stroke-width="2.6">${draw(badge)}</svg>`
  : draw(name)}</symbol>`).join('');

let seed = 20130;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
type Floater = { icon: number; c: number; x: number; y: number; s: number; r: number; o: number; d: number; z: number };
let k = 0;
/** One field of icons: `rows` x up to `cols` columns, `gap` chance of leaving a cell empty. */
function field(rows: number, cols: number, yFrom: number, ySpan: number, gap: number) {
  const out: Floater[] = [];
  for (let row = 0; row < rows; row++) {
    for (let c = 0; c < cols; c++) {
      if (rnd() < gap) continue; // gaps so it reads as scattered, not a grid
      out.push({
        icon: (k++ * 7 + row * 3 + c) % pool.length, c,
        x: 24 + Math.round((rnd() - 0.5) * 24),
        y: +(yFrom + ((row + 0.5) / rows) * ySpan + (rnd() - 0.5) * (ySpan / rows) * 0.35).toFixed(1),
        s: 18 + Math.round(rnd() * 12),
        r: Math.round((rnd() - 0.5) * 18),
        o: +(0.15 + rnd() * 0.19 - Math.min(c, 6) * 0.01).toFixed(2),
        d: +(rnd() * 6).toFixed(1),
        z: +(0.35 + c * 0.1 + rnd() * 0.25).toFixed(2),
      });
    }
  }
  return out;
}
/** Beside the laptop (12 rows) and beside the line above it (2 rows). */
const cols7 = (f: Floater[]) => f.filter((x) => x.c < 7); // wider columns only show on very wide screens
const sides = { l: cols7(field(12, 10, 2, 104, 0.24)), r: cols7(field(12, 10, 2, 104, 0.24)) };
const pockets = { l: cols7(field(2, 10, 8, 84, 0.2)), r: cols7(field(2, 10, 8, 84, 0.2)) };
const flStyle = (side: 'l' | 'r', f: Floater) =>
  `${side === 'l' ? 'right' : 'left'}:calc(${f.x}px + ${f.c} * var(--sp)); top:${f.y}%; --r:${f.r}deg; --o:${f.o}`;

const trust = enabledClaims(['zeroDeposit', 'noLockIn', 'fastDelivery', 'support247']);

/** Brand mark as inline SVG, filled with a gradient id or a colour. */
const markBox = (id: 'apple' | 'dell' | 'hp' | 'lenovo') => (id === 'lenovo' ? '0 8 24 8.01' : '0 0 24 24');
---
<section class="hero" data-scene="hero" data-stop="0" aria-labelledby="hero-title">
  <div class="stage">
    <div class="glow" aria-hidden="true"></div>

    <!-- The line above the laptop, with icons on either side -->
    <div class="topline">
      {(['l', 'r'] as const).map((side) => (
        <span class={`pocket pocket--${side}`} aria-hidden="true">
          {pockets[side].map((f) => (
            <span class={`fl c${f.c}`} style={flStyle(side, f)}>
              <svg width={f.s} height={f.s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><use href={`#hf-${f.icon}`} /></svg>
            </span>
          ))}
        </span>
      ))}
      <p class="k-txt k-txt--a">Rent the laptops your team already knows.</p>
      <p class="k-txt k-txt--b" aria-hidden="true"><b>IT Rentals:</b> one-stop solution for all your renting needs</p>
    </div>

    <div class="device-wrap">
      <!-- shared icons and logo fills; kept outside .floaters, which phones hide (fills inside a hidden svg do not paint) -->
      <svg class="sprite" width="0" height="0" focusable="false" aria-hidden="true">
        <defs>
          <mask id="hf-cut"><rect width="24" height="24" fill="#fff" /><circle cx="18.5" cy="18.5" r="6.4" fill="#000" /></mask>
          <linearGradient id="lg-apple" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f4f5f6" /><stop offset=".42" stop-color="#a9adb3" /><stop offset=".55" stop-color="#fff" /><stop offset=".8" stop-color="#7c8188" /><stop offset="1" stop-color="#d7dade" /></linearGradient>
          <linearGradient id="lg-dell" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#eef0f3" /><stop offset=".45" stop-color="#9aa1a9" /><stop offset=".56" stop-color="#f7f8f9" /><stop offset="1" stop-color="#c9cdd2" /></linearGradient>
          <linearGradient id="lg-hp" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6e7378" /><stop offset=".4" stop-color="#b8bcc1" /><stop offset=".52" stop-color="#f7f8f9" /><stop offset=".78" stop-color="#5c6166" /><stop offset="1" stop-color="#9ea3a8" /></linearGradient>
          <Fragment set:html={sprite} />
        </defs>
      </svg>
      <div class="floaters" aria-hidden="true">
        {(['l', 'r'] as const).map((side) => (
          <div class={`fl-side fl-side--${side}`}>
            {sides[side].map((f) => (
              <span class={`fl c${f.c}`} style={flStyle(side, f)}>
                <svg width={f.s} height={f.s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><use href={`#hf-${f.icon}`} /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>

      <!-- In the tour the laptop is lifted out of the page (position: fixed) and carried from
           here to its place beside the builder (#build); see scenes.ts. -->
      <div class="fly" data-fly>
      <div class="flip">
        <div class="floor" aria-hidden="true" data-floor></div>
        <div class="slab" data-slab data-front="a">
          <!-- Face A: stops 0 (IT Rentals screen), 2 (Dell), 4 (Lenovo) -->
          <div class="face face--a">
            <div class="slot slot--screen on" data-slot="0" data-at-stop="0">
              <div class="lid">
                <span class="cam" aria-hidden="true"></span>
                <div class="screen">
                  <div class="desk" data-fit-desk>
                    <p class="since mono"><span class="since-dot" aria-hidden="true"></span><span>Renting IT<span class="since-long"> to Indian businesses</span> since {SITE.founded}</span></p>
                    <h1 id="hero-title" class="headline">
                      <span class="hl-brand">IT Rentals</span><span class="sr-only">: </span>
                      <span class="hl-line">One-stop solution for all your renting needs</span>
                    </h1>
                    <p class="lead">
                      Laptops, MacBooks, desktops, servers, networking and phones for teams of ten or a thousand.
                      Configured before they ship, supported until they come back.
                    </p>
                    <div class="ctas">
                      <a href="/request-a-quote/" class="btn btn--primary btn--lg" data-track-location="hero">Get a quote</a>
                      <a href={whatsappLink()} class="btn btn--lg btn--wa" target="_blank" rel="noopener" data-track-location="hero"><Icon name="whatsapp" />WhatsApp us</a>
                    </div>
                    {trust.length > 0 && (
                      <ul class="trust" role="list">
                        {trust.map((t) => <li><Icon name="check" size={15} stroke={2} />{t.short}</li>)}
                      </ul>
                    )}
                  </div>
                  <span class="sheen sheen--glass" aria-hidden="true"></span>
                </div>
              </div>
              <div class="deck" aria-hidden="true"><span class="notch"></span></div>
            </div>

            {(['dell', 'lenovo'] as const).map((id) => (
              <div class={`slot slot--back back--${id}`} data-slot={id === 'dell' ? 2 : 4} aria-hidden="true">
                <div class="lid lid--back">
                  <span class="sizer"></span>
                  {id === 'lenovo' ? (
                    <svg class="logo logo--lenovo" viewBox={markBox(id)} focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                  ) : (
                    <svg class={`logo logo--${id}`} viewBox={markBox(id)} focusable="false"><path d={BRAND_MARKS[id]} fill={`url(#lg-${id})`} /></svg>
                  )}
                  <span class="asset"><b><span class="asset-sq"></span>IT Rentals</b><i></i><small>itrentals.in</small></span>
                  <span class="sheen"></span>
                </div>
                <div class="deck deck--rear"><span class="hinge"></span></div>
              </div>
            ))}
          </div>

          <!-- Face B: stops 1 (Apple), 3 (HP), 5 (the builder's screen) -->
          <div class="face face--b">
            {(['apple', 'hp'] as const).map((id) => (
              <div class:list={['slot', 'slot--back', `back--${id}`, { on: id === 'apple' }]} data-slot={id === 'apple' ? 1 : 3} aria-hidden="true">
                <div class="lid lid--back">
                  <span class="sizer"></span>
                  <svg class={`logo logo--${id}`} viewBox={markBox(id)} focusable="false"><path d={BRAND_MARKS[id]} fill={id === 'hp' ? 'url(#lg-dell)' : `url(#lg-${id})`} /></svg>
                  <span class="asset"><b><span class="asset-sq"></span>IT Rentals</b><i></i><small>itrentals.in</small></span>
                  <span class="sheen"></span>
                </div>
                <div class="deck deck--rear"><span class="hinge"></span></div>
              </div>
            ))}

            <!-- Stop 5: the laptop beside the builder. Its screen mirrors the choices made there
                 (LaptopCurator.astro writes to [data-lap]); the same words are in the builder's summary. -->
            <div class="slot slot--screen slot--pc" data-slot="5" aria-hidden="true">
              <div class="lid">
                <span class="cam"></span>
                <div class="screen screen--pc" data-lap data-brand="">
                  <div class="pc-marks">
                    <span class="pc-mark pc-mark--itr on" data-mark="">IT Rentals</span>
                    <svg class="pc-mark pc-mark--lenovo" data-mark="Lenovo" viewBox="0 8 24 8.01" focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                    <svg class="pc-mark pc-mark--dell" data-mark="Dell" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.dell} fill="url(#lg-dell)" /></svg>
                    <svg class="pc-mark pc-mark--hp" data-mark="HP" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.hp} fill="url(#lg-dell)" /></svg>
                    <svg class="pc-mark pc-mark--apple" data-mark="Apple" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS.apple} fill="url(#lg-apple)" /></svg>
                    <span class="pc-mark pc-mark--itr" data-mark="any">IT Rentals</span>
                  </div>
                  <dl class="pc-spec">
                    <div><dt>Processor</dt><dd data-val="proc">Any</dd></div>
                    <div><dt>Memory</dt><dd data-val="ram">Any</dd></div>
                    <div><dt>Storage</dt><dd data-val="storage">Any</dd></div>
                  </dl>
                  <p class="pc-foot" data-scr-foot>Choose a brand to start</p>
                  <span class="sheen sheen--glass"></span>
                </div>
              </div>
              <div class="deck"><span class="notch"></span></div>
            </div>
          </div>

          <i class="edge edge--l" aria-hidden="true"></i>
          <i class="edge edge--r" aria-hidden="true"></i>
        </div>
      </div>
      </div>
    </div>

    <a class="skip" href="#build">Skip the brand tour<Icon name="arrow-down" size={15} /></a>

    <!-- Under the laptop: the stops, and what each one offers -->
    <div class="tour">
      <nav class="tour-nav" aria-label="Brand tour">
        <ol role="list">
          {stops.map((st, i) => (
            <li><button type="button" class:list={['stop', { on: i === 0 }]} data-goto={i} data-s={i} aria-current={i === 0 ? 'step' : undefined}><span>{st.name}</span></button></li>
          ))}
        </ol>
        <span class="tour-track" aria-hidden="true"><i></i></span>
      </nav>
      <ul class="tour-ctas" role="list">
        {stops.map((st, i) => (
          <li class:list={['tc', `tc--${st.id}`, { on: i === 0 }]} data-s={i} data-at-stop={i}>
            {st.mark && (
              <svg class="tc-mark" viewBox={markBox(st.mark)} aria-hidden="true" focusable="false">
                {st.mark === 'lenovo' ? <><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></> : <path d={BRAND_MARKS[st.mark]} fill="currentColor" />}
              </svg>
            )}
            <p class="tc-cap">{st.caption}</p>
            {st.href && <a class="tc-go" href={st.href} data-track-location={`hero-${st.id}`}>{st.cta}<Icon name="arrow-right" size={16} /></a>}
          </li>
        ))}
      </ul>
    </div>

    <p class="cue" aria-hidden="true"><span>Scroll</span><i></i></p>
  </div>
</section>


<style>
  .hero {
    position: relative; color: var(--ink); background: var(--paper);
    /* extend up under the floating header */
    margin-top: -80px;
  }
  .stage {
    position: relative; overflow: hidden;
    padding: calc(80px + clamp(28px, 4vw, 56px)) var(--gutter) clamp(24px, 3vw, 40px);
    background-color: var(--paper);
    background-image:
      var(--grain),
      radial-gradient(48% 42% at 50% 44%, rgba(255, 252, 246, .95) 0%, rgba(255, 252, 246, 0) 72%),
      radial-gradient(42% 38% at 10% 16%, rgba(224, 51, 40, .08) 0%, transparent 72%),
      radial-gradient(48% 44% at 92% 88%, rgba(184, 138, 85, .16) 0%, transparent 72%);
    background-size: 220px 220px, auto, auto, auto;
  }
  /* fine dot texture for depth */
  .glow {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(23,19,15,.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(80% 70% at 50% 45%, #000 30%, transparent 85%);
  }
  /* Parts that only exist while the scene runs */
  .face--b, .slot--back, .edge, .floor, .sheen, .tour-nav, .cue, .skip, .tc--itr, .tc--build, .k-txt--b { display: none; }
  .topline { position: relative; margin: 0 auto clamp(18px, 2.6vw, 30px); text-align: center; }
  .k-txt { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.2rem, .9rem + 1.2vw, 1.9rem); line-height: 1.15; letter-spacing: -0.015em; color: var(--ink); }

  /* ── The laptop (static layout: the IT Rentals screen) ── */
  .device-wrap { position: relative; width: 100%; max-width: 1040px; margin: 0 auto; }
  .flip { position: relative; }
  .slab, .face { position: relative; }
  .lid {
    position: relative; z-index: 1; width: 94%; margin: 0 auto;
    background: linear-gradient(180deg, #0c0a09, #050404);
    border-radius: 22px 22px 6px 6px;
    padding: clamp(8px, 1.4vw, 16px) clamp(8px, 1.4vw, 16px) clamp(10px, 1.8vw, 20px);
    box-shadow:
      inset 0 0 0 1px rgba(243,238,229,.10),
      0 0 0 1px rgba(0,0,0,.6),
      0 50px 90px -42px rgba(23,19,15,.6),
      0 22px 40px -28px rgba(23,19,15,.45);
  }
  .cam { position: absolute; top: clamp(2px, .55vw, 6px); left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #2a2622; box-shadow: inset 0 0 0 1px #3d3832; z-index: 2; }
  .screen {
    position: relative; container-type: inline-size; color: var(--ink);
    border-radius: 10px 10px 2px 2px; overflow: hidden;
    background: #EDE6DA radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
  }
  .deck {
    position: relative; z-index: 1; height: clamp(12px, 1.5vw, 18px); margin-top: -1px;
    background: linear-gradient(180deg, #3a3a3e 0%, #1c1c1f 40%, #0b0b0c 100%);
    border-radius: 2px 2px 20px 20px / 2px 2px 12px 12px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 18px 28px -14px rgba(23,19,15,.55);
  }
  .notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, #050506, #2a2a2e); border-radius: 0 0 9px 9px; }

  /* The IT Rentals screen */
  .desk {
    display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; align-content: center; text-align: center;
    padding: clamp(32px, 6cqi, 72px) clamp(16px, 5cqi, 56px) clamp(28px, 5cqi, 56px);
  }
  .since {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: clamp(14px, 2.6cqi, 28px);
    padding: 6px 14px; border-radius: var(--r-pill); border: 1px solid var(--line-strong);
    color: var(--ink-2); font-size: clamp(.6875rem, 1.3cqi, .875rem); font-weight: 500;
  }
  .since-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px rgba(224,51,40,.15); }
  .headline { display: grid; justify-items: center; gap: clamp(6px, 1.2cqi, 14px); font-family: var(--font-display); font-weight: 400; font-optical-sizing: auto; }
  .hl-brand { font-size: clamp(2.6rem, 12cqi, 7.75rem); line-height: .88; letter-spacing: -0.035em; }
  .hl-line { font-size: clamp(1.25rem, 4.3cqi, 2.9rem); line-height: 1.08; letter-spacing: -0.02em; max-width: 21ch; color: var(--ink); }
  .lead { margin: clamp(12px, 2.2cqi, 24px) auto 0; max-width: 56ch; font-size: clamp(.875rem, 1.75cqi, 1.125rem); line-height: 1.55; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-3); margin-top: clamp(14px, 2.8cqi, 30px); }
  .trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; margin-top: clamp(12px, 2.4cqi, 26px); list-style: none; font-size: var(--fs-xs); color: var(--ink-2); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { color: var(--red-ink); }

  /* The builder's screen (stop 5): dark, with the chosen brand and specification */
  .screen--pc {
    display: grid; grid-template-rows: 1fr auto auto; gap: 2.4cqi; padding: 4cqi 6cqi 3.4cqi; color: #f3eee5;
    background: #0b0908 radial-gradient(90% 70% at 50% 18%, #2b2220 0%, #141010 55%, #0b0908 100%);
  }
  .pc-marks { position: relative; display: grid; place-items: center; min-height: 0; }
  .pc-mark { grid-area: 1 / 1; display: block; opacity: 0; transform: scale(.92); color: #fff; transition: opacity .4s ease, transform .6s var(--ease-out); }
  .pc-mark:global(.on) { opacity: 1; transform: none; }
  .pc-mark--apple { width: 9cqi; height: 11cqi; }
  .pc-mark--hp, .pc-mark--dell { width: 12cqi; height: 12cqi; }
  .pc-mark--lenovo { width: 27cqi; height: 9cqi; }
  .pc-mark--itr { font-family: var(--font-display); font-size: 9.5cqi; line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .pc-spec { display: grid; gap: .6cqi; margin: 0; padding: 2.2cqi 0 0; border-top: 1px solid rgba(243,238,229,.14); }
  .pc-spec div { display: grid; grid-template-columns: 26cqi 1fr; align-items: baseline; padding: 1cqi 1.6cqi; border-radius: 1cqi; transition: background-color .5s ease; }
  .pc-spec div:global(.flash) { background-color: rgba(224, 51, 40, .22); transition: none; }
  .pc-spec dt { font-size: 3cqi; color: rgba(243,238,229,.6); }
  .pc-spec dd { margin: 0; font-size: 3.6cqi; font-weight: 600; color: rgba(243,238,229,.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pc-spec dd:global(.set) { color: #fff; }
  .pc-foot { margin: 0; display: flex; align-items: center; gap: 1.6cqi; font-size: 3cqi; color: rgba(243,238,229,.75); }
  .pc-foot::before { content: ''; flex: none; width: 1.6cqi; height: 1.6cqi; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 .8cqi rgba(224,51,40,.22); }

  /* When a screen's words do not fit (short phones, small tablets), drop the extras in turn */
  .desk:is([data-fit='1'], [data-fit='2'], [data-fit='3'], [data-fit='4']) .lead { display: none; }
  .desk:is([data-fit='2'], [data-fit='3'], [data-fit='4']) .trust { display: none; }
  .desk:is([data-fit='3'], [data-fit='4']) :is(.since, .btn--wa) { display: none; }
  .slot--screen[data-slot='0'] .screen:has(> .desk[data-fit='4']) { overflow-y: auto; }

  /* Static layout: the four brands as links under the laptop */
  .tour { width: 100%; }
  .tour-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px; list-style: none; margin: var(--s-6) auto 0; max-width: 1040px; }
  .tc { display: flex; align-items: center; gap: 10px; }
  .tc-mark { flex: none; width: 20px; height: 20px; color: var(--ink); }
  .tc--lenovo .tc-mark { width: 46px; height: 16px; }
  .tc-cap { display: none; margin: 0; }
  .tc-go { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .tc-go :global(svg) { transition: transform var(--t-fast) var(--ease-out); }
  .tc-go:hover :global(svg) { transform: translateX(3px); }

  /* Icon field */
  .floaters { position: absolute; inset: 0; pointer-events: none; z-index: 0; --icon-accent: var(--red); }
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Each side is exactly the free space beside the laptop (less a small margin). */
  .fl-side { position: absolute; top: 0; bottom: 0; width: max(0px, calc((100vw - 100%) / 2 - 12px)); container-type: inline-size; }
  .fl-side--l { right: 100%; }
  .fl-side--r { left: 100%; }
  .fl {
    position: absolute; display: none; color: var(--ink); opacity: calc(var(--o) * .9);
    /* columns sit 46px apart, spreading out when the space is wider than ten of them */
    --sp: max(46px, (100cqi - 40px) / 10);
    transform: rotate(var(--r));
  }
  .fl svg { display: block; max-width: none; flex: none; }
  /* A column shows only when its icons fit in full: 74px for the first, 46px more for each next one. */
  @container (min-width: 74px) { .c0 { display: block; } }
  @container (min-width: 120px) { .c1 { display: block; } }
  @container (min-width: 166px) { .c2 { display: block; } }
  @container (min-width: 212px) { .c3 { display: block; } }
  @container (min-width: 258px) { .c4 { display: block; } }
  @container (min-width: 304px) { .c5 { display: block; } }
  @container (min-width: 350px) { .c6 { display: block; } }
  @container (min-width: 396px) { .c7 { display: block; } }
  @container (min-width: 442px) { .c8 { display: block; } }
  @container (min-width: 488px) { .c9 { display: block; } }
  @media (max-width: 1099px) { .floaters, .pocket { display: none; } }

  /* ── Scroll scene (only when scenes run and the screen is tall enough) ── */
  @media (min-height: 560px) {
    :global(html.scenes) .hero { height: 500vh; height: 500svh; }
    :global(html.scenes) .stage {
      position: sticky; top: 0; height: 100vh; height: 100svh;
      display: grid; grid-template-rows: auto minmax(0, 1fr) auto; justify-items: center; align-items: center; gap: clamp(8px, 1.6vh, 16px);
      padding: max(clamp(96px, 12.5vh, 112px), var(--head, 0px)) var(--gutter) clamp(16px, 3vh, 30px);
      --lw: min(980px, 84vw, calc((100svh - var(--reserve, 330px)) * 1.52));
    }

    /* Rows: the line above, the laptop (with the closing screen's form over it), the tour */
    :global(html.scenes) .topline { grid-area: 1 / 1; }
    :global(html.scenes) .device-wrap { grid-area: 2 / 1; }
    :global(html.scenes) .tour { grid-area: 3 / 1; position: relative; z-index: 3; }
    /* the page keeps the laptop's space (its height is measured, as the laptop itself is lifted out) */
    :global(html.scenes) .device-wrap { width: var(--lw); height: var(--fly-h, calc(var(--lw) * .66)); }
    /* The laptop is fixed to the window and placed by scenes.ts: over that space on this
       page, then carried down to its place beside the builder. Above the page that follows. */
    :global(html.scenes) .stage { z-index: 3; }
    :global(html.scenes) .fly { position: fixed; left: 0; top: 0; z-index: 4; width: var(--lw); transform-origin: 0 0; will-change: transform; pointer-events: none; }
    :global(html.scenes) .fly .slot:global(.on) { pointer-events: auto; }

    /* The line above the laptop: the kicker, then the IT Rentals line once the tour starts */
    :global(html.scenes) .topline { display: grid; place-items: center; position: relative; width: min(820px, 100%); min-height: 2.5rem; margin: 0; }
    :global(html.scenes) .k-txt--b { display: block; }
    .k-txt {
      grid-area: 1 / 1; margin: 0; text-align: center; font-family: var(--font-display); font-weight: 400;
      font-size: clamp(1.2rem, .9rem + 1.2vw, 1.9rem); line-height: 1.15; letter-spacing: -0.015em; color: var(--ink);
      transition: opacity .45s ease, translate .6s var(--ease-out);
    }
    .k-txt b { font-weight: 500; }
    .k-txt--b { opacity: 0; translate: 0 8px; }
    :global(html.scenes) .hero:not([data-stop='0']) .k-txt--a { opacity: 0; translate: 0 -8px; }
    :global(html.scenes) .hero:not([data-stop='0']) .k-txt--b { opacity: 1; translate: 0 0; }
    /* icons either side of the line: from its edge to the edge of the screen */
    :global(html.scenes) .pocket { display: block; position: absolute; top: -34px; bottom: -14px; width: max(0px, calc((100vw - 100%) / 2 - 16px)); container-type: inline-size; pointer-events: none; --icon-accent: var(--red); }
    @media (max-width: 1099px) { :global(html.scenes) .pocket { display: none; } }
    .pocket--l { right: calc(100% - 6px); }
    .pocket--r { left: calc(100% - 6px); }

    /* The flipping laptop */
    :global(html.scenes) .device-wrap { max-width: none; align-self: center; }
    :global(html.scenes) .flip { width: var(--lw); perspective: calc(var(--lw) * 2.4); perspective-origin: 50% 45%; }
    :global(html.scenes) .slab { transform-style: preserve-3d; -webkit-transform-style: preserve-3d; will-change: transform; }
    :global(html.scenes) .fl-side, :global(html.scenes) .pocket, :global(html.scenes) .floor { will-change: transform; }
    :global(html.scenes) .face { -webkit-backface-visibility: hidden; backface-visibility: hidden; }
    :global(html.scenes) .face--b { display: block; position: absolute; inset: 0; transform: rotateY(180deg); }
    /* the face turned away is hidden outright as well (Safari draws some layers through backface-visibility) */
    :global(html.scenes) .slab[data-front='a'] .face--b,
    :global(html.scenes) .slab[data-front='b'] .face--a { opacity: 0; pointer-events: none; }
    :global(html.scenes) .slot { opacity: 0; pointer-events: none; }
    :global(html.scenes) .slot:global(.on) { opacity: 1; pointer-events: auto; }
    :global(html.scenes) .slot--back, :global(html.scenes) .face--b > .slot { display: block; position: absolute; inset: 0; }
    :global(html.scenes) .lid {
      padding: calc(var(--lw) * .013) calc(var(--lw) * .013) calc(var(--lw) * .022);
      box-shadow: inset 0 0 0 1px rgba(243,238,229,.10), 0 0 0 1px rgba(0,0,0,.6);
    }
    :global(html.scenes) .screen, .sizer { aspect-ratio: 16 / 10.4; }
    .sizer { display: block; }
    /* the words sit in the middle of the screen (top-aligned if they ever overflow) */
    :global(html.scenes) .screen { display: grid; align-content: safe center; }
    :global(html.scenes) .cam { top: calc(var(--lw) * .0065); width: max(3px, calc(var(--lw) * .006)); height: max(3px, calc(var(--lw) * .006)); margin-left: 0; translate: -50% -50%; }
    :global(html.scenes) .deck { box-shadow: inset 0 1px 0 rgba(255,255,255,.22); }

    /* Contact shadow on the floor, narrowing as the laptop turns edge-on */
    :global(html.scenes) .floor {
      display: block; position: absolute; left: 4%; right: 4%; bottom: calc(var(--lw) * -.035); height: calc(var(--lw) * .07);
      border-radius: 50%; background: radial-gradient(closest-side, rgba(23,19,15,.42), rgba(23,19,15,0));
      transform-origin: 50% 50%; pointer-events: none;
    }
    /* Thickness: the two sides of the slab, seen only while it turns */
    :global(html.scenes) .edge {
      display: block; position: absolute; top: 1.5%; bottom: 3%; left: 50%;
      width: calc(var(--lw) * .012); margin-left: calc(var(--lw) * -.006); border-radius: 4px;
      background: linear-gradient(90deg, #0a0a0b, #3d3d42 45%, #55555b 55%, #0a0a0b);
      -webkit-backface-visibility: hidden; backface-visibility: hidden;
    }
    .edge--l { transform: rotateY(-90deg) translateZ(calc(var(--lw) * .47)); }
    .edge--r { transform: rotateY(90deg) translateZ(calc(var(--lw) * .47)); }

    /* A soft highlight that sweeps across while turning */
    :global(html.scenes) .sheen {
      display: block; position: absolute; inset: 0 -60%; pointer-events: none; z-index: 3;
      background: linear-gradient(100deg, transparent 40%, rgba(255,255,255,.34) 50%, transparent 60%);
      transform: translateX(-60%); opacity: 0;
    }
    .sheen--glass { inset: 0 -60%; background: linear-gradient(100deg, transparent 42%, rgba(255,255,255,.22) 50%, transparent 58%); }

    /* ── Lid backs ──
       All four in black finishes, told apart by their tone and grain: Apple space black,
       Dell graphite, HP deep midnight, Lenovo matte black. Each lid has a soft light from
       the top, the metal ones a faint brushed grain, and the logos polished chrome with a
       pressed-in edge. */
    .lid--back { container-type: inline-size; overflow: hidden; --top-light: radial-gradient(120% 70% at 50% 0%, rgba(255,255,255,.12), transparent 60%); --brushed: repeating-linear-gradient(90deg, rgba(255,255,255,.022) 0 1px, transparent 1px 3px); }
    .lid--back .sizer { visibility: hidden; }
    .logo { position: absolute; left: 50%; top: 47%; translate: -50% -50%; filter: drop-shadow(0 .08cqi 0 rgba(0,0,0,.35)) drop-shadow(0 -.06cqi 0 rgba(255,255,255,.25)); }
    .logo--apple { width: 11.5cqi; height: 14cqi; }
    .logo--dell { width: 13cqi; height: 13cqi; }
    .logo--hp { width: 13cqi; height: 13cqi; }
    .logo--lenovo { width: 26cqi; height: 8.7cqi; border-radius: .4cqi; filter: none; box-shadow: 0 .2cqi .6cqi rgba(0,0,0,.5), inset 0 0 0 1px rgba(255,255,255,.2); }

    /* IT Rentals asset tag, stuck on slightly crooked, lower left */
    .asset {
      position: absolute; left: 5cqi; bottom: 5cqi; display: grid; gap: .45cqi; width: 16cqi; padding: .8cqi 1cqi .75cqi;
      border-radius: .5cqi; background: #faf7f1; rotate: -1.5deg;
      box-shadow: 0 .15cqi .35cqi rgba(0,0,0,.3), inset 0 0 0 1px rgba(23,19,15,.08);
    }
    .asset b { display: flex; align-items: center; gap: .55cqi; font-size: 1.2cqi; line-height: 1; font-weight: 700; letter-spacing: .02em; color: var(--ink); }
    .asset-sq { width: 1cqi; height: 1cqi; border-radius: .15cqi; background: var(--red); }
    .asset i { display: block; height: 2.2cqi; background: repeating-linear-gradient(90deg, #17130f 0 .12cqi, transparent .12cqi .32cqi), repeating-linear-gradient(90deg, #17130f 0 .24cqi, transparent .24cqi .78cqi); }
    .asset small { font-size: .95cqi; line-height: 1; color: var(--ink-2); }

    :global(html.scenes) .back--apple .lid--back {
      border-radius: 2.8cqi 2.8cqi .8cqi .8cqi;
      background: var(--top-light), var(--brushed), linear-gradient(180deg, #3b3c40 0%, #2c2d31 55%, #212225 100%);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.14), 0 0 0 1px rgba(0,0,0,.55);
    }
    :global(html.scenes) .back--hp .lid--back {
      border-radius: 1.9cqi 1.9cqi .6cqi .6cqi;
      background: var(--top-light), var(--brushed), linear-gradient(180deg, #2c3240 0%, #1f2430 55%, #161a23 100%);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.12), 0 0 0 1px rgba(0,0,0,.55);
    }
    :global(html.scenes) .back--dell .lid--back {
      border-radius: 1.6cqi 1.6cqi .5cqi .5cqi;
      background: var(--top-light), var(--brushed), linear-gradient(180deg, #36383c 0%, #2a2c30 55%, #202225 100%);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.1), 0 0 0 1px rgba(0,0,0,.5);
    }
    :global(html.scenes) .back--lenovo .lid--back {
      border-radius: 1.1cqi 1.1cqi .4cqi .4cqi;
      background: var(--top-light), linear-gradient(180deg, #1e1e20 0%, #19191b 60%, #141415 100%);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.06), 0 0 0 1px rgba(0,0,0,.6);
    }

    /* The base seen from behind: one hinge band (Apple, HP) or two hinge barrels and a vent (Dell, Lenovo) */
    .deck--rear { height: clamp(12px, 1.5vw, 18px); border-radius: 2px 2px 14px 14px / 2px 2px 9px 9px; }
    .hinge { position: absolute; left: 11%; right: 11%; top: 0; height: max(4px, 30%); border-radius: 0 0 6px 6px; background: linear-gradient(180deg, #121214, #2a2b2e 55%, #0e0e10); }
    .back--apple .deck--rear { background: linear-gradient(180deg, #3a3b3f, #1e1f22 60%, #111214); }
    .back--hp .deck--rear { background: linear-gradient(180deg, #2a2f3b, #161a22); }
    .back--dell .deck--rear { background: linear-gradient(180deg, #34363a, #1a1b1e); }
    .back--lenovo .deck--rear { background: linear-gradient(180deg, #2a2a2c, #0e0e10); }
    .back--dell .deck--rear::before, .back--dell .deck--rear::after,
    .back--lenovo .deck--rear::before, .back--lenovo .deck--rear::after {
      content: ''; position: absolute; top: -45%; width: 9%; height: 95%; border-radius: 99px;
      background: linear-gradient(180deg, #3a3c40, #151618); box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
    }
    .back--dell .deck--rear::before, .back--lenovo .deck--rear::before { left: 12%; }
    .back--dell .deck--rear::after, .back--lenovo .deck--rear::after { right: 12%; }
    .back--dell .hinge, .back--lenovo .hinge { left: 30%; right: 30%; top: 30%; height: 35%; border-radius: 1px; background: repeating-linear-gradient(90deg, rgba(0,0,0,.5) 0 2px, transparent 2px 5px); }

    /* ── Under the laptop: stops and the offer for each ── */
    :global(html.scenes) .tour { display: grid; justify-items: center; gap: 10px; width: min(760px, 100%); }
    :global(html.scenes) .tour-nav { display: grid; gap: 6px; width: 100%; }
    .tour-nav ol { display: flex; justify-content: space-between; list-style: none; margin: 0; padding: 0; }
    .stop {
      min-height: 32px; padding: 4px 6px; border: 0; background: none; cursor: pointer;
      font: inherit; font-size: .875rem; font-weight: 600; color: var(--ink-2); transition: color .3s ease;
    }
    .stop:hover { color: var(--ink); }
    .stop:global(.on) { color: var(--ink); }
    .stop:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; border-radius: 6px; }
    .tour-track { position: relative; height: 2px; border-radius: 2px; background: rgba(23,19,15,.12); overflow: hidden; }
    .tour-track i { position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(0); background: var(--red-ink); }
    :global(html.scenes) .tour-ctas { display: grid; width: 100%; min-height: 2.75rem; margin: 0; }
    :global(html.scenes) .tc {
      grid-area: 1 / 1; display: flex; justify-content: center; align-items: center; gap: 10px 16px; flex-wrap: wrap;
      opacity: 0; translate: 0 6px; pointer-events: none; transition: opacity .35s ease, translate .45s var(--ease-out);
    }
    :global(html.scenes) .tc:global(.on) { opacity: 1; translate: 0 0; pointer-events: auto; }
    :global(html.scenes) .tc--itr, :global(html.scenes) .tc--build { display: flex; }
    :global(html.scenes) .tc .tc-mark { display: none; }
    :global(html.scenes) .tc-cap { display: block; font-size: var(--fs-small); color: var(--ink-2); text-align: center; }
    :global(html.scenes) .tc-go {
      padding: 7px 14px; border: 0; border-radius: var(--r-pill); background: var(--ink); color: var(--paper);
      font-size: .875rem; white-space: nowrap;
    }
    :global(html.scenes) .tc-go:hover { background: var(--red-ink); }
    :global(html.scenes) .tc-go:focus-visible { outline: 3px solid var(--red-ink); outline-offset: 3px; }

    /* Scroll cue at the start; a way out during the tour */
    :global(html.scenes) .cue {
      display: flex; align-items: center; gap: 10px; position: absolute; left: var(--gutter); bottom: clamp(18px, 3.2vh, 34px);
      font-size: var(--fs-xs); color: var(--ink-2); transition: opacity .3s ease;
    }
    .cue i { position: relative; width: 1px; height: 34px; background: rgba(23,19,15,.2); overflow: hidden; }
    .cue i::after { content: ''; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--ink); animation: cue 1.8s ease-in-out infinite; }
    @keyframes cue { to { top: 100%; } }
    :global(html.scenes) .hero:not([data-stop='0']) .cue { opacity: 0; }
    :global(html.scenes) .skip {
      display: inline-flex; align-items: center; gap: 6px; position: absolute; left: var(--gutter); bottom: clamp(18px, 3.2vh, 34px);
      font-size: var(--fs-xs); font-weight: 600; color: var(--ink-2); text-underline-offset: 3px; opacity: 0; pointer-events: none;
      transition: opacity .3s ease;
    }
    :global(html.scenes) .hero:not([data-stop='0']):not([data-stop='5']) .skip,
    :global(html.scenes) .skip:focus-visible { opacity: 1; pointer-events: auto; }
    :global(html.scenes) .skip:focus-visible { padding: 6px 10px; margin: -6px -10px; border-radius: 8px; background: var(--card); }
    :global(html.scenes) .skip:focus-visible ~ .cue { opacity: 0; }

    /* The lid opens and the screen comes on when the page loads */
    :global(html.scenes) .slot--screen[data-slot='0'] .lid { animation: lid-open .85s cubic-bezier(.2, .75, .2, 1) .05s backwards; transform-origin: 50% 100%; }
    @keyframes lid-open { from { transform: perspective(1500px) rotateX(-76deg); } to { transform: perspective(1500px) rotateX(0deg); } }

    :global(html.scenes) .hero .since-long { display: none; }
    @media (min-width: 1100px) { :global(html.scenes) .hero .since-long { display: inline; } }
  }

  /* Up to 899px the call / WhatsApp / quote bar sits at the bottom: keep the tour above it */
  @media (min-height: 560px) and (max-width: 899px) {
    :global(html.scenes) .stage { padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px)); }
    /* no room beside the caption for the scroll cue */
    :global(html.scenes) .cue { display: none; }
  }
  /* Below 1100px the captions reach the left edge: the skip link moves to the top and shows only when tabbed to */
  @media (min-height: 560px) and (max-width: 1099px) {
    :global(html.scenes) .hero[data-stop]:not([data-stop='x']) .skip:not(:focus-visible) { opacity: 0; pointer-events: none; }
    :global(html.scenes) .skip { top: calc(max(96px, var(--head, 0px)) - 12px); bottom: auto; padding: 6px 10px; border-radius: 8px; background: var(--card); }
    :global(html.scenes) .stage:has(> .skip:focus-visible) .topline { visibility: hidden; }
  }

  /* Phones and narrow tablets: taller screen, compact tour */
  @media (min-height: 560px) and (max-width: 760px) {
    :global(html.scenes) .hero { height: 420vh; height: 420svh; }
    :global(html.scenes) .stage { padding: max(96px, var(--head, 0px)) var(--gutter) calc(88px + env(safe-area-inset-bottom, 0px)); gap: 10px; --lw: min(92vw, calc((100svh - var(--reserve, 330px)) * .74)); }
    :global(html.scenes) .screen, .sizer { aspect-ratio: 3 / 4; }
    :global(html.scenes) .desk { padding: 6cqi 5cqi; }
    .hl-brand { font-size: clamp(2.4rem, 14cqi, 4rem); }
    .hl-line { font-size: clamp(1.15rem, 6.6cqi, 1.75rem); }
    .lead { font-size: .875rem; }
    .logo--apple { width: 20cqi; height: 24.4cqi; }
    .logo--dell, .logo--hp { width: 22cqi; height: 22cqi; }
    .logo--lenovo { width: 44cqi; height: 14.7cqi; }
    .asset { width: 30cqi; left: 7cqi; bottom: 7cqi; padding: 1.6cqi 2cqi; gap: .9cqi; }
    .asset b { font-size: 2.3cqi; gap: 1cqi; }
    .asset-sq { width: 1.9cqi; height: 1.9cqi; }
    .asset i { height: 4cqi; }
    .asset small { font-size: 1.8cqi; }
    :global(html.scenes) .hero .ctas .btn { min-height: 44px; padding: 10px 16px; font-size: .9375rem; }
    :global(html.scenes) .hero .trust { gap: 4px 14px; }
    .stop span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .stop { position: relative; min-width: 24px; min-height: 24px; }
    .stop::before { content: ''; position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: var(--ink-3); transition: background .3s ease, width .3s ease, margin .3s ease; }
    .stop:global(.on)::before { width: 18px; margin-left: -9px; border-radius: 4px; background: var(--red-ink); }
    .tour-nav ol { justify-content: center; gap: 6px; }
    .tour-track { display: none; }
    :global(html.scenes) .tour-ctas { min-height: 4.6rem; }
    :global(html.scenes) .tc { flex-direction: column; gap: 6px; }
    :global(html.scenes) .tc-cap { font-size: var(--fs-xs); line-height: 1.35; }
    :global(html.scenes) .k-txt { font-size: 1.0625rem; }
  }

  @media (forced-colors: active) {
    .lid { border: 1px solid CanvasText; }
    .stop::before { forced-color-adjust: none; background: ButtonText !important; }
    .stop:global(.on)::before { background: Highlight !important; }
  }

  @media (max-width: 639px) {
    .since { font-size: .6875rem; padding: 6px 12px; }
    .since-long { display: none; }
  }
</style>

<script>
  // Laptop screens have a fixed shape. Where their words do not fit (short phones,
  // small tablets), drop the extras one level at a time (see .desk[data-fit] in the CSS); at the last level the screen scrolls.
  const desks = [...document.querySelectorAll<HTMLElement>('.hero [data-fit-desk]')];
  let fitRaf = 0;
  const fit = () => {
    cancelAnimationFrame(fitRaf);
    fitRaf = requestAnimationFrame(() => {
      for (const d of desks) {
        const screen = d.parentElement!;
        let level = 0;
        d.removeAttribute('data-fit');
        while (level < 4 && d.offsetHeight > screen.clientHeight + 1) d.dataset.fit = String(++level);
      }
    });
  };
  if (desks.length) {
    const ro = new ResizeObserver(fit);
    // the desk too: text size or spacing can change after load without resizing the screen
    desks.forEach((d) => { ro.observe(d.parentElement!); ro.observe(d); });
    document.fonts?.ready.then(fit);
  }

  // The laptop gets whatever height the line above, the tour below and the header leave
  // (they grow with larger text), so it never covers the stop buttons.
  const stage = document.querySelector<HTMLElement>('.hero .stage');
  const parts = ['.topline', '.tour'].map((q) => stage?.querySelector<HTMLElement>(q)).filter((x): x is HTMLElement => !!x);
  const header = document.querySelector<HTMLElement>('.site-header');
  if (stage && parts.length === 2) {
    let sizeRaf = 0;
    const size = () => {
      cancelAnimationFrame(sizeRaf);
      sizeRaf = requestAnimationFrame(() => {
        if (getComputedStyle(stage).position !== 'sticky') { stage.style.removeProperty('--reserve'); stage.style.removeProperty('--head'); return; }
        const cs = getComputedStyle(stage);
        // layout box, not the on-screen one: the header slides away while scrolling down
        const head = header ? Math.round(header.offsetHeight + 16) : 0;
        stage.style.setProperty('--head', `${head}px`);
        const pad = Math.max(parseFloat(cs.paddingTop), head) + parseFloat(cs.paddingBottom);
        const reserve = Math.round(pad + parts[0].offsetHeight + parts[1].offsetHeight + 2 * parseFloat(cs.rowGap || '0') + 12);
        stage.style.setProperty('--reserve', `${reserve}px`);
      });
    };
    const ro2 = new ResizeObserver(size);
    [...parts, stage].forEach((el) => ro2.observe(el));
    if (header) ro2.observe(header);
  }

</script>
