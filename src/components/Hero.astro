---
/**
 * Home page opening scene. While the stage is pinned, scrolling boots the
 * laptop as Apple, HP, Dell and Lenovo, then as IT Rentals with the headline
 * and calls to action (see src/scripts/scenes.ts). Without scroll scenes
 * (reduced motion, no JavaScript, very short screens) the laptop simply shows
 * the IT Rentals screen.
 */
import Icon from './Icon.astro';
import { SITE, whatsappLink, enabledClaims } from '../config/site';
import { PRODUCTS } from '../data/products';
import { BRAND_MARKS } from '../data/brand-marks';
import iconNodes from 'lucide-static/icon-nodes.json';

const laptopsBy = (brand: string) => PRODUCTS.filter((p) => p.category === 'laptops' && p.brand === brand).length;

/** What we rent. Brand pills open the catalogue already filtered, with the number of models. */
const rentables: { label: string; icon: string; href: string; count?: number }[] = [
  { label: 'Lenovo ThinkPad', icon: 'laptop', href: '/equipment/?category=laptops&brand=Lenovo', count: laptopsBy('Lenovo') },
  { label: 'Dell Latitude', icon: 'laptop', href: '/equipment/?category=laptops&brand=Dell', count: laptopsBy('Dell') },
  { label: 'HP EliteBook', icon: 'laptop', href: '/equipment/?category=laptops&brand=HP', count: laptopsBy('HP') },
  { label: 'MacBook Air and Pro', icon: 'laptop-minimal', href: '/macbook-rental/' },
  { label: 'Desktops and mini PCs', icon: 'monitor-smartphone', href: '/desktop-rental/' },
  { label: 'Monitors', icon: 'monitor', href: '/monitor-rental/' },
  { label: 'Rack servers', icon: 'server', href: '/server-rental/' },
  { label: 'Routers and Wi-Fi', icon: 'router', href: '/router-rental/' },
  { label: 'Android and iPhone', icon: 'smartphone', href: '/mobile-phone-rental/' },
];

/** The brands the laptop boots as, in scroll order, then IT Rentals. */
const brands = [
  { id: 'apple', name: 'Apple', caption: 'MacBook Air and MacBook Pro, from the 2019 Intel models to M5' },
  { id: 'hp', name: 'HP', caption: `${laptopsBy('HP')} HP EliteBook and ProBook models` },
  { id: 'dell', name: 'Dell', caption: `${laptopsBy('Dell')} Dell Latitude models` },
  { id: 'lenovo', name: 'Lenovo', caption: `${laptopsBy('Lenovo')} Lenovo ThinkPad models` },
] as const;
const railItems = [...brands, { id: 'itr', name: 'IT Rentals', caption: `Every brand from one rental partner, since ${SITE.founded}` }];

/**
 * A field of thin library icons (laptop set + hardware set) on both sides of
 * the laptop. Each side is a container as wide as the space beside the laptop;
 * columns that would not fit are hidden by container queries, so wide screens
 * get a fuller field and narrow ones stay tidy. Icons are drawn from one SVG
 * sprite to keep the page light. Positions come from a fixed seed so every
 * build looks the same.
 */
const pool: [string, string?][] = [
  ['laptop'], ['laptop', 'check'], ['laptop', 'lock'], ['laptop', 'clock'], ['laptop', 'map-pin'], ['laptop', 'refresh-cw'],
  ['laptop', 'shield'], ['laptop', 'zap'], ['laptop', 'calendar'], ['laptop', 'headphones'], ['laptop', 'briefcase'], ['laptop', 'chart-column'],
  ['laptop-minimal'], ['monitor'], ['server'], ['smartphone'], ['tablet'], ['wifi'], ['router'], ['cloud-upload'], ['keyboard'],
  ['mouse'], ['webcam'], ['printer'], ['hard-drive'], ['usb'], ['ethernet-port'], ['plug-zap'], ['battery'], ['power'], ['cpu'], ['projector'],
];
const nodes = iconNodes as unknown as Record<string, [string, Record<string, string>][]>;
const draw = (n: string) => nodes[n].map(([tag, a]) => `<${tag} ${Object.entries(a).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`).join('');
const sprite = pool.map(([name, badge], i) => `<symbol id="hf-${i}" viewBox="0 0 24 24">${badge
  ? `<g mask="url(#hf-cut)">${draw(name)}</g><svg x="13" y="13" width="11" height="11" viewBox="0 0 24 24" style="stroke:var(--icon-accent)" stroke-width="2.6">${draw(badge)}</svg>`
  : draw(name)}</symbol>`).join('');

let seed = 20130;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
type Floater = { icon: number; c: number; x: number; y: number; s: number; r: number; o: number; d: number; z: number };
const sides: Record<'l' | 'r', Floater[]> = { l: [], r: [] };
const COLS = 10; // at most; see the container queries in the styles
const ROWS = 12;
let k = 0;
for (const side of ['l', 'r'] as const) {
  for (let row = 0; row < ROWS; row++) {
    for (let c = 0; c < COLS; c++) {
      if (rnd() < 0.24) continue; // gaps so it reads as scattered, not a grid
      sides[side].push({
        icon: (k++ * 7 + row * 3 + c) % pool.length, c,
        x: 24 + Math.round((rnd() - 0.5) * 24),
        y: +(-6 + ((row + 0.5) / ROWS) * 112 + (rnd() - 0.5) * 5).toFixed(1),
        s: 18 + Math.round(rnd() * 12),
        r: Math.round((rnd() - 0.5) * 18),
        o: +(0.15 + rnd() * 0.19 - Math.min(c, 6) * 0.01).toFixed(2),
        d: +(rnd() * 6).toFixed(1),
        z: +(0.35 + c * 0.1 + rnd() * 0.25).toFixed(2),
      });
    }
  }
}

const trust = enabledClaims(['zeroDeposit', 'noLockIn', 'fastDelivery', 'support247']);
---
<section class="hero" data-scene="hero" data-brand="apple" aria-labelledby="hero-title">
  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <p class="kicker" aria-hidden="true">Rent the laptops your team already knows.</p>

    <div class="device-wrap">
      <div class="floaters" aria-hidden="true">
        <svg class="sprite" width="0" height="0" focusable="false">
          <defs>
            <mask id="hf-cut"><rect width="24" height="24" fill="#fff" /><circle cx="18.5" cy="18.5" r="6.4" fill="#000" /></mask>
            <Fragment set:html={sprite} />
          </defs>
        </svg>
        {(['l', 'r'] as const).map((side) => (
          <div class={`fl-side fl-side--${side}`}>
            {sides[side].map((f) => (
              <span
                class={`fl c${f.c}`}
                style={`${side === 'l' ? 'right' : 'left'}:calc(${f.x}px + ${f.c} * var(--sp)); top:${f.y}%; --r:${f.r}deg; --o:${f.o}; --d:${f.d}s; --z:${f.z}`}
              >
                <svg width={f.s} height={f.s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><use href={`#hf-${f.icon}`} /></svg>
              </span>
            ))}
          </div>
        ))}
      </div>

      <div class="device">
        <div class="lid">
          <span class="cam" aria-hidden="true"></span>
          <div class="screen">
            <div class="boots" aria-hidden="true">
              {brands.map((b) => (
                <div class:list={['boot', `boot--${b.id}`, { on: b.id === 'apple' }]} data-b={b.id}>
                  {b.id === 'lenovo' ? (
                    <svg class="mark" viewBox="0 8 24 8.01" focusable="false"><rect x=".4" y="8.4" width="23.2" height="7.2" fill="#fff" /><path d={BRAND_MARKS.lenovo} fill="#E2231A" /></svg>
                  ) : (
                    <svg class="mark" viewBox="0 0 24 24" focusable="false"><path d={BRAND_MARKS[b.id]} fill="currentColor" /></svg>
                  )}
                  {b.id === 'apple' ? (
                    <span class="bootbar"><i></i></span>
                  ) : (
                    <span class="spinner">{[0, 1, 2, 3, 4].map(() => <i></i>)}</span>
                  )}
                </div>
              ))}
            </div>

            <div class="desk" data-at="0.86">
              <p class="since mono"><span class="since-dot" aria-hidden="true"></span><span>Renting IT<span class="since-long"> to Indian businesses</span> since {SITE.founded}</span></p>
              <h1 id="hero-title" class="headline">
                <span class="hl-brand">IT Rentals</span><span class="sr-only">: </span>
                <span class="hl-line">One-stop solution for all your renting needs</span>
              </h1>
              <p class="lead">
                Laptops, MacBooks, desktops, servers, networking and phones for teams of ten or a thousand.
                Configured before they ship, supported until they come back.
              </p>
              <div class="ctas">
                <a href="/request-a-quote/" class="btn btn--primary btn--lg" data-track-location="hero">Get a quote</a>
                <a href={whatsappLink()} class="btn btn--lg btn--wa" target="_blank" rel="noopener" data-track-location="hero"><Icon name="whatsapp" />WhatsApp us</a>
              </div>
              {trust.length > 0 && (
                <ul class="trust" role="list">
                  {trust.map((t) => <li><Icon name="check" size={15} stroke={2} />{t.short}</li>)}
                </ul>
              )}
            </div>
          </div>
          <span class="chin" aria-hidden="true">
            {(['hp', 'dell', 'lenovo'] as const).map((id) => (
              <svg class="chin-mark" data-b={id} viewBox={id === 'lenovo' ? '0 8 24 8.01' : '0 0 24 24'} focusable="false"><path d={BRAND_MARKS[id]} fill="currentColor" /></svg>
            ))}
          </span>
        </div>
        <div class="deck" aria-hidden="true"><span class="notch"></span></div>
      </div>
    </div>

    <div class="rail" aria-hidden="true">
      <ol class="rail-names" role="list">
        {railItems.map((b) => <li class:list={{ on: b.id === 'apple' }} data-b={b.id}>{b.name}</li>)}
      </ol>
      <span class="rail-track"><i></i></span>
      <div class="rail-caps">
        {railItems.map((b) => <p class:list={{ on: b.id === 'apple' }} data-b={b.id}>{b.caption}</p>)}
      </div>
    </div>
    <p class="cue" aria-hidden="true"><span>Scroll</span><i></i></p>
  </div>
</section>

<div class="hero-tail">
  <nav class="wrap rentables" aria-label="What you can rent">
    <ul role="list">
      {rentables.map((c) => (
        <li>
          <a href={c.href} class="pill">
            <Icon name={c.icon} size={18} stroke={1.75} />
            <span>{c.label}</span>
            {c.count ? <span class="count num">{c.count}<span class="sr-only"> models</span></span> : null}
            <span class="go" aria-hidden="true"><Icon name="arrow-up-right" size={14} stroke={2} /></span>
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn--lg explore" href="/equipment/">Explore the full catalogue <Icon name="arrow-right" /></a>
  </nav>
</div>

<style>
  /* Deck colours change with the brand on screen */
  @property --dk1 { syntax: '<color>'; inherits: true; initial-value: #d6cfc3; }
  @property --dk2 { syntax: '<color>'; inherits: true; initial-value: #b2aa9d; }
  @property --dk3 { syntax: '<color>'; inherits: true; initial-value: #7d766c; }

  .hero {
    position: relative; color: var(--ink); background: var(--paper);
    /* extend up under the floating header */
    margin-top: -80px;
  }
  .stage {
    position: relative; overflow: hidden;
    padding: calc(80px + clamp(28px, 4vw, 56px)) var(--gutter) clamp(24px, 3vw, 40px);
    background-color: var(--paper);
    background-image:
      var(--grain),
      radial-gradient(48% 42% at 50% 44%, rgba(255, 252, 246, .95) 0%, rgba(255, 252, 246, 0) 72%),
      radial-gradient(42% 38% at 10% 16%, rgba(224, 51, 40, .08) 0%, transparent 72%),
      radial-gradient(48% 44% at 92% 88%, rgba(184, 138, 85, .16) 0%, transparent 72%);
    background-size: 220px 220px, auto, auto, auto;
  }
  /* fine dot texture for depth */
  .glow {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(23,19,15,.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(80% 70% at 50% 45%, #000 30%, transparent 85%);
  }
  .kicker, .boots, .rail, .cue, .chin { display: none; }

  /* The laptop */
  .device-wrap { position: relative; width: 100%; max-width: 1040px; margin: 0 auto; }
  .device { position: relative; --lw: 100%; }
  .lid {
    position: relative; z-index: 1; width: 94%; margin: 0 auto;
    background: linear-gradient(180deg, #0c0a09, #050404);
    border-radius: 22px 22px 6px 6px;
    padding: clamp(8px, 1.4vw, 16px) clamp(8px, 1.4vw, 16px) clamp(10px, 1.8vw, 20px);
    box-shadow:
      inset 0 0 0 1px rgba(243,238,229,.10),
      0 0 0 1px rgba(0,0,0,.6),
      0 50px 90px -42px rgba(23,19,15,.6),
      0 22px 40px -28px rgba(23,19,15,.45);
  }
  .cam { position: absolute; top: clamp(2px, .55vw, 6px); left: 50%; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #2a2622; box-shadow: inset 0 0 0 1px #3d3832; z-index: 2; }
  .screen {
    position: relative; container-type: inline-size; color: var(--ink);
    border-radius: 10px 10px 2px 2px; overflow: hidden;
    background: radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
  }
  .deck {
    position: relative; z-index: 1; height: clamp(12px, 1.5vw, 18px); margin-top: -1px;
    background: linear-gradient(180deg, var(--dk1) 0%, var(--dk2) 45%, var(--dk3) 100%);
    border-radius: 2px 2px 20px 20px / 2px 2px 12px 12px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.55), 0 18px 28px -14px rgba(23,19,15,.55);
    transition: --dk1 .6s ease, --dk2 .6s ease, --dk3 .6s ease;
  }
  .notch { position: absolute; top: 0; left: 50%; width: 15%; height: 42%; transform: translateX(-50%); background: linear-gradient(180deg, var(--dk3), var(--dk2)); border-radius: 0 0 9px 9px; opacity: .7; }

  /* The IT Rentals screen */
  .desk {
    display: grid; justify-items: center; align-content: center; text-align: center;
    padding: clamp(32px, 6cqi, 72px) clamp(16px, 5cqi, 56px) clamp(28px, 5cqi, 56px);
  }
  .since {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: clamp(14px, 2.6cqi, 28px);
    padding: 6px 14px; border-radius: var(--r-pill); border: 1px solid var(--line-strong);
    color: var(--ink-2); font-size: clamp(.6875rem, 1.3cqi, .875rem); font-weight: 500;
  }
  .since-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px rgba(224,51,40,.15); }
  .headline { display: grid; justify-items: center; gap: clamp(6px, 1.2cqi, 14px); font-family: var(--font-display); font-weight: 400; font-optical-sizing: auto; }
  .hl-brand { font-size: clamp(2.6rem, 12cqi, 7.75rem); line-height: .88; letter-spacing: -0.035em; }
  .hl-line { font-size: clamp(1.25rem, 4.3cqi, 2.9rem); line-height: 1.08; letter-spacing: -0.02em; max-width: 21ch; color: var(--ink); }
  .lead { margin: clamp(12px, 2.2cqi, 24px) auto 0; max-width: 56ch; font-size: clamp(.875rem, 1.75cqi, 1.125rem); line-height: 1.55; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-3); margin-top: clamp(14px, 2.8cqi, 30px); }
  .trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; margin-top: clamp(12px, 2.4cqi, 26px); list-style: none; font-size: var(--fs-xs); color: var(--ink-2); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust :global(svg) { color: var(--red-ink); }

  /* Icon field */
  .floaters { position: absolute; inset: 0; pointer-events: none; z-index: 0; --icon-accent: var(--red); }
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Each side is exactly the free space beside the laptop (less a small margin). */
  .fl-side { position: absolute; top: 0; bottom: 0; width: max(0px, calc((100vw - 100%) / 2 - 12px)); container-type: inline-size; }
  .fl-side--l { right: 100%; }
  .fl-side--r { left: 100%; }
  .fl {
    position: absolute; display: none; color: var(--ink); opacity: calc(var(--o) * .9);
    /* columns sit 46px apart, spreading out when the space is wider than ten of them */
    --sp: max(46px, (100cqi - 40px) / 10);
    transform: rotate(var(--r)); translate: 0 calc(var(--p, 0) * var(--z) * -110px);
  }
  .fl svg { display: block; max-width: none; flex: none; }
  /* A column shows only when its icons fit in full: 74px for the first, 46px more for each next one. */
  @container (min-width: 74px) { .c0 { display: block; } }
  @container (min-width: 120px) { .c1 { display: block; } }
  @container (min-width: 166px) { .c2 { display: block; } }
  @container (min-width: 212px) { .c3 { display: block; } }
  @container (min-width: 258px) { .c4 { display: block; } }
  @container (min-width: 304px) { .c5 { display: block; } }
  @container (min-width: 350px) { .c6 { display: block; } }
  @container (min-width: 396px) { .c7 { display: block; } }
  @container (min-width: 442px) { .c8 { display: block; } }
  @container (min-width: 488px) { .c9 { display: block; } }
  @media (prefers-reduced-motion: no-preference) {
    .fl { animation: drift 11s ease-in-out infinite alternate; animation-delay: calc(var(--d) * -1); }
    @keyframes drift {
      from { transform: translateY(-4px) rotate(var(--r)); }
      to { transform: translateY(5px) rotate(calc(var(--r) * -0.4)); }
    }
  }
  @media (max-width: 1099px) { .floaters { display: none; } }

  /* ── Scroll scene (only when scenes run and the screen is tall enough) ── */
  @media (min-height: 560px) {
    :global(html.scenes) .hero { height: 300vh; height: 300svh; }
    :global(html.scenes) .stage {
      position: sticky; top: 0; height: 100vh; height: 100svh;
      display: grid; grid-template-rows: auto minmax(0, 1fr) auto; justify-items: center; align-items: center; gap: clamp(8px, 1.6vh, 18px);
      padding: clamp(100px, 13vh, 116px) var(--gutter) clamp(18px, 3.2vh, 34px);
      --q: clamp(0, calc((var(--p, 0) - .68) / .1), 1);
    }
    :global(html.scenes) .kicker {
      display: block; font-family: var(--font-display); font-size: clamp(1.25rem, .9rem + 1.3vw, 2rem); line-height: 1.15; letter-spacing: -0.015em;
      color: var(--ink); text-align: center; opacity: calc(1 - var(--q));
      translate: 0 calc(var(--q) * -12px);
    }
    :global(html.scenes) .device-wrap { width: auto; max-width: none; align-self: center; }
    :global(html.scenes) .device {
      --lw: min(1000px, 86vw, calc((100svh - 290px) * 1.52));
      width: var(--lw);
      transform: scale(calc(.965 + .035 * var(--q)));
      transform-origin: 50% 85%;
    }
    :global(html.scenes) .lid {
      padding: calc(var(--lw) * .013) calc(var(--lw) * .013) calc(var(--lw) * .022);
      transform-origin: 50% 100%;
    }
    :global(html.scenes) .screen { aspect-ratio: 16 / 10.4; }
    :global(html.scenes) .screen { background: #000; }
    :global(html.scenes) .desk {
      position: absolute; inset: 0; z-index: 1;
      background: radial-gradient(120% 80% at 50% 0%, #FBF8F2 0%, var(--paper) 60%, #EDE6DA 100%);
      opacity: 0; transform: translateY(2cqi) scale(.985); pointer-events: none;
      transition: opacity .5s ease .12s, transform .8s var(--ease-out) .12s;
    }
    :global(html.scenes) .hero[data-brand='itr'] .desk { opacity: 1; transform: none; pointer-events: auto; }

    /* Boot screens */
    :global(html.scenes) .boots { display: block; position: absolute; inset: 0; z-index: 2; background: #000; transition: opacity .55s ease; }
    :global(html.scenes) .hero[data-brand='itr'] .boots { opacity: 0; pointer-events: none; }
    .boot {
      position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 6.5cqi;
      color: #fff; opacity: 0; transform: scale(.93); filter: blur(8px);
      transition: opacity .42s ease, transform .7s var(--ease-out), filter .42s ease;
    }
    .boot:global(.on) { opacity: 1; transform: none; filter: none; }
    .mark { display: block; width: 11.5cqi; height: 11.5cqi; }
    .boot--apple .mark { width: 9.5cqi; height: 11.6cqi; }
    .boot--lenovo .mark { width: 26cqi; height: 8.7cqi; }
    .bootbar { width: 20cqi; height: max(3px, .42cqi); border-radius: 99px; background: rgba(255,255,255,.22); overflow: hidden; }
    .bootbar i { display: block; height: 100%; width: calc(var(--seg, 0) * 100%); background: #fff; border-radius: inherit; }
    .spinner { position: relative; width: 4.4cqi; height: 4.4cqi; }
    .spinner i { position: absolute; inset: 0; animation: orbit 2.4s cubic-bezier(.55, .1, .45, .9) infinite; }
    .spinner i::before { content: ''; position: absolute; top: 0; left: 50%; width: .62cqi; height: .62cqi; margin-left: -.31cqi; border-radius: 50%; background: #fff; }
    .spinner i:nth-child(2) { animation-delay: -.12s; }
    .spinner i:nth-child(3) { animation-delay: -.24s; }
    .spinner i:nth-child(4) { animation-delay: -.36s; }
    .spinner i:nth-child(5) { animation-delay: -.48s; }
    @keyframes orbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    /* Brand mark on the bezel below the screen */
    :global(html.scenes) .chin { display: block; position: absolute; left: 50%; bottom: calc(var(--lw) * .005); width: calc(var(--lw) * .1); height: calc(var(--lw) * .012); transform: translateX(-50%); color: #7d776f; }
    .chin-mark { position: absolute; inset: 0; margin: auto; height: 100%; width: auto; max-width: 100%; opacity: 0; transition: opacity .4s ease; }
    .chin-mark:global(.on) { opacity: 1; }

    /* Body colour follows the brand */
    :global(html.scenes) .hero[data-brand='apple'] .device { --dk1: #e6e6e9; --dk2: #bcbcc1; --dk3: #8d8d93; }
    :global(html.scenes) .hero[data-brand='hp'] .device { --dk1: #dedfe2; --dk2: #b3b4b8; --dk3: #85868b; }
    :global(html.scenes) .hero[data-brand='dell'] .device { --dk1: #73767c; --dk2: #4a4d52; --dk3: #2c2e32; }
    :global(html.scenes) .hero[data-brand='lenovo'] .device { --dk1: #404042; --dk2: #252527; --dk3: #131314; }

    /* Brand rail and caption */
    :global(html.scenes) .rail { display: grid; justify-items: center; gap: 10px; width: min(560px, 100%); }
    .rail-names { display: flex; justify-content: space-between; width: 100%; list-style: none; font-size: .875rem; font-weight: 600; color: var(--ink-3); }
    .rail-names li { opacity: .5; transition: color .3s ease, opacity .3s ease; }
    .rail-names li:global(.on) { opacity: 1; color: var(--ink); }
