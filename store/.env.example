# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Nothing here is required to try the store locally: without them it runs in demo mode
# (local database, sample stock, sign-in codes shown on screen, simulated payments).
# Never commit real values. Keys marked "server only" must never be prefixed NEXT_PUBLIC_.

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.in
# Long random string used to sign codes, order links and unsubscribe links (server only).
# Generate with: openssl rand -hex 32. Required in production.
AUTH_SECRET=
# Comma-separated emails and/or mobile numbers that are always super admins (bootstrap).
# Add other staff with roles in /admin/staff.
ADMIN_EMAILS=
ADMIN_PHONES=
# 1 = demo mode on a live deployment (sample units, codes on screen, simulated payments).
# Leave empty in production.
DEMO_MODE=

# ── Database (Supabase, Neon or any Postgres) ─────────
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543). Server only.
DATABASE_URL=
# Connections per server instance (default 5).
DATABASE_POOL=
# Tables are created automatically on first start. Set to 0 to manage migrations yourself (npm run db:migrate).
AUTO_MIGRATE=

# ── File storage (Supabase Storage) ───────────────────
# Private bucket for student IDs and return photos; public bucket for laptop photos uploaded in admin.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=student-ids
PUBLIC_BUCKET=product-photos

# ── Payments (Razorpay) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://yourdomain.in/api/razorpay/webhook
# Events: payment.captured, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="LappyClub <orders@yourdomain.in>"
EMAIL_REPLY_TO=
# Where contact-form messages go (defaults to the support email in Admin → Settings)
CONTACT_INBOX=
# Where "new order" emails go (defaults to CONTACT_INBOX, then the support email)
ORDER_INBOX=

# ── SMS (MSG91) ───────────────────────────────────────
# Sign-in codes need a DLT-approved OTP template. Order-update SMS need one DLT template per
# message; enter each template ID in Admin → Notifications.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── WhatsApp (Meta Cloud API) ─────────────────────────
# Business-initiated messages use approved templates; enter each template name in Admin → Notifications.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Shipping (Shiprocket, optional) ───────────────────
# Without these, staff enter the courier and AWB by hand. With them, choose Shiprocket in
# Admin → Settings → Shipping to book shipments, get labels and receive tracking updates.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Shiprocket → Settings → API → Webhooks: URL https://yourdomain.in/api/shipping/webhook, token below
SHIPROCKET_WEBHOOK_TOKEN=
