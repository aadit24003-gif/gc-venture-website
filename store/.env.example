# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Nothing here is required to try the store locally: without them it runs in demo mode
# (local database, sign-in codes shown on screen, simulated payments).

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.in
# Long random string used to protect sign-in codes. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Comma-separated emails and/or mobile numbers that can open /admin
ADMIN_EMAILS=
ADMIN_PHONES=
# 1 = demo mode on a live deployment (codes on screen, simulated payments). Leave empty in production.
DEMO_MODE=

# ── Database (Supabase, Neon or any Postgres) ─────────
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543)
DATABASE_URL=
# Tables are created automatically on first start. Set to 0 to manage migrations yourself (npm run db:migrate).
AUTO_MIGRATE=

# ── Student ID photos (Supabase Storage) ──────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=student-ids

# ── Payments (Razorpay) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://yourdomain.in/api/razorpay/webhook
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Encore <orders@yourdomain.in>"
EMAIL_REPLY_TO=
# Where contact-form messages go (defaults to CONTACT.email in src/lib/config.ts)
CONTACT_INBOX=

# ── SMS sign-in codes (MSG91, needs a DLT-approved OTP template) ──
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
