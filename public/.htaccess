# ─────────────────────────────────────────────────────────────
# itrentals.in, Apache / cPanel configuration
# Upload the contents of dist/ to public_html (this file included).
# ─────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain (canonical: https://itrentals.in/)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://itrentals.in%{REQUEST_URI} [L,R=301]

  # ── 301 redirects from the old WordPress site ─────────────
  # Old pages found in Google's index (October 2026) and common WordPress addresses,
  # each sent to the closest new page. The old city pages (/laptop-on-rent-in-pune/ etc.)
  # and /about/ keep the same address, so they need no redirect.
  # After launch, add any address that shows in Search Console > Pages > Not found (404).
  RewriteRule ^services/?$ /equipment/ [L,R=301]
  RewriteRule ^services/(laptop|desktop|macbook|monitor|server|router)-rental/?$ /$1-rental/ [L,R=301]
  RewriteRule ^services/(apple|mac|macbook)[a-z-]*/?$ /macbook-rental/ [L,R=301]
  RewriteRule ^services/(workstation|desktop|computer)[a-z-]*/?$ /desktop-rental/ [L,R=301]
  RewriteRule ^services/(laptop|notebook)[a-z-]*/?$ /laptop-rental/ [L,R=301]
  RewriteRule ^services/[a-z0-9-]+/?$ /it-equipment-rental/ [L,R=301]
  RewriteRule ^why-should-you-laptop-on-rent/?$ /laptop-on-rent-in-bangalore/ [L,R=301]
  RewriteRule ^laptop-on-rent/?$ /laptop-rental/ [L,R=301]
  RewriteRule ^desktop-on-rent/?$ /desktop-rental/ [L,R=301]
  RewriteRule ^apple-laptop-rental/?$ /macbook-rental/ [L,R=301]
  RewriteRule ^about-us/?$ /about/ [L,R=301]
  RewriteRule ^contact-us/?$ /contact/ [L,R=301]
  RewriteRule ^raise-a-complaint/?$ /support/ [L,R=301]
  RewriteRule ^laptop-on-rent-in-bengaluru/?$ /laptop-on-rent-in-bangalore/ [L,R=301]
  RewriteRule ^laptop-on-rent-in-gurugram/?$ /laptop-on-rent-in-gurgaon/ [L,R=301]
  RewriteRule ^laptop-on-rent-in-kochi/?$ /laptop-on-rent-in-kerala/ [L,R=301]

  # Old WordPress system paths
  RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]
  RewriteRule ^feed/?$ / [L,R=301]

  # Add trailing slash to directory-style URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# ── Security headers ───────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; frame-src https://maps.google.com https://www.google.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# ── Caching ────────────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|svg|png|webp|avif|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
# Astro fingerprints everything in /_astro/, so it can be cached forever
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# ── Compression ────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

AddType font/woff2 .woff2
AddType image/svg+xml .svg
